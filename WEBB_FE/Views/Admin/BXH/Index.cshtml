@model List<WEBB.Models.Admin.BXHDto>
@{
    ViewBag.Title = "Bảng xếp hạng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    int hang = 1;
}

<div class="container-fluid px-lg-4">
    <!-- Header với gradient -->
    <div class="d-flex justify-content-between align-items-center mb-5 pt-3">
        <div>
            <div class="d-flex align-items-center">
                <div class="icon-shape bg-gradient-warning rounded-circle p-3 mr-3 shadow">
                    <i class="fas fa-trophy fa-2x text-white"></i>
                </div>
                <div>
                    <h1 class="h3 mb-1 text-gray-900 font-weight-800">Bảng xếp hạng người chơi</h1>
                    <p class="mb-0 text-gray-600">Theo dõi và quản lý thành tích của người chơi</p>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge badge-pill badge-light border mr-3 px-3 py-2">
                <i class="fas fa-ranking-star mr-2"></i>
                Top <span id="currentTop">@(ViewBag.Top ?? 10)</span> người chơi
            </span>
        </div>
    </div>

    <!-- Thông báo lỗi -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm animate__animated animate__fadeIn mb-4" role="alert">
            <div class="d-flex align-items-center">
                <div class="alert-icon">
                    <i class="fas fa-exclamation-circle me-3"></i>
                </div>
                <div class="flex-grow-1">
                    <strong>Lỗi!</strong> @ViewBag.Error
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- Bộ lọc và tùy chọn -->
    <div class="card shadow-lg border-0 mb-4 animate__animated animate__fadeInUp">
        <div class="card-header bg-gradient-primary border-0 py-3">
            <h6 class="m-0 font-weight-bold text-white">
                <i class="fas fa-sliders-h mr-2"></i>Tùy chọn xem
            </h6>
        </div>
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-6 mb-3 mb-md-0">
                    <form method="get" id="rankFilterForm" class="form-inline">
                        <div class="d-flex align-items-center">
                            <label class="font-weight-bold text-gray-700 mr-3 mb-0">
                                <i class="fas fa-filter mr-2 text-primary"></i>Hiển thị Top:
                            </label>
                            <div class="input-group shadow-sm" style="width: 150px;">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0">
                                        <i class="fas fa-chart-line text-primary"></i>
                                    </span>
                                </div>
                                <select name="top" class="form-control border-left-0"
                                        onchange="document.getElementById('rankFilterForm').submit()">
                                    <option value="5" @(ViewBag.Top == 5 ? "selected" : "")>Top 5</option>
                                    <option value="10" @(ViewBag.Top == 10 ? "selected" : "")>Top 10</option>
                                    <option value="20" @(ViewBag.Top == 20 ? "selected" : "")>Top 20</option>
                                    <option value="50" @(ViewBag.Top == 50 ? "selected" : "")>Top 50</option>
                                    <option value="100" @(ViewBag.Top == 100 ? "selected" : "")>Top 100</option>
                                </select>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="d-flex justify-content-md-end">
                        <div class="mr-3">
                            <small class="text-muted d-block">Tổng người chơi</small>
                            <span class="h5 mb-0 font-weight-bold text-primary">@Model.Count</span>
                        </div>
                        <div>
                            <small class="text-muted d-block">Cập nhật</small>
                            <span class="h5 mb-0 font-weight-bold text-success">Hôm nay</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng xếp hạng -->
    <div class="card shadow-lg border-0 mb-5 animate__animated animate__fadeIn">
        <div class="card-header bg-gradient-info border-0 py-4">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-white">
                    <i class="fas fa-medal mr-2"></i>Bảng xếp hạng
                </h6>
                <div class="d-flex align-items-center">
                    <div class="input-group input-group-sm" style="width: 200px;">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search text-gray-400"></i>
                            </span>
                        </div>
                        <input type="text" class="form-control" id="searchInput"
                               placeholder="Tìm người chơi...">
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="rankTable">
                        <thead class="thead-light">
                            <tr>
                                <th width="15%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Hạng</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('rank')"></i>
                                    </div>
                                </th>
                                <th width="55%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Người chơi</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('player')"></i>
                                    </div>
                                </th>
                                <th width="30%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Điểm số</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('score')"></i>
                                    </div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="animate__animated rank-row" data-player="@item.HoTen.ToLower() @item.TenDangNhap.ToLower()">
                                    <td class="align-middle text-center">
                                        <div class="d-flex align-items-center gap-3">
                                            @if (hang == 1)
                                            {
                                                <div class="rank-badge rank-gold mr-3">
                                                    <i class="fas fa-crown"></i>
                                                </div>
                                                <div>
                                                    <div class="font-weight-bold text-gray-800">Hạng #1</div>
                                                    <small class="text-muted">Quán quân</small>
                                                </div>
                                            }
                                            else if (hang == 2)
                                            {
                                                <div class="rank-badge rank-silver mr-3">
                                                    <i class="fas fa-award"></i>
                                                </div>
                                                <div>
                                                    <div class="font-weight-bold text-gray-800">Hạng #2</div>
                                                    <small class="text-muted">Á quân</small>
                                                </div>
                                            }
                                            else if (hang == 3)
                                            {
                                                <div class="rank-badge rank-bronze mr-3">
                                                    <i class="fas fa-medal"></i>
                                                </div>
                                                <div>
                                                    <div class="font-weight-bold text-gray-800">Hạng #3</div>
                                                    <small class="text-muted">Hạng ba</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="rank-badge rank-other mr-3">
                                                    <span class="rank-number">@hang</span>
                                                </div>
                                                <div>
                                                    <div class="font-weight-bold text-gray-800">Hạng #@hang</div>
                                                    <small class="text-muted">Top @ViewBag.Top</small>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar avatar-md mr-3">
                                                <div class="avatar-initials @GetAvatarColor(hang)">
                                                    @GetInitials(item.HoTen)
                                                </div>
                                            </div>
                                            <div>
                                                <div class="font-weight-bold text-gray-800">@item.HoTen</div>
                                                <div class="text-muted small">
                                                    <i class="fas fa-user mr-1"></i>@item.TenDangNhap
                                                    <span class="mx-2">•</span>
                                                    <i class="fas fa-clock mr-1"></i>@DateTime.Now.ToString("HH:mm")
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div class="score-display mr-3">
                                                <div class="score-value font-weight-bold text-gray-800">
                                                    @item.DiemXepHang.ToString("N0")
                                                </div>
                                                <div class="progress mt-1" style="height: 4px; width: 100px;">
                                                    @{
                                                        var progress = Math.Min((item.DiemXepHang / 1000.0) * 100, 100);
                                                    }
                                                    <div class="progress-bar @GetProgressColor(hang)"
                                                         role="progressbar"
                                                         style="width: @progress%"></div>
                                                </div>
                                            </div>
                                            <div class="text-center">
                                                <div class="score-big @GetScoreColor(hang)">
                                                    @item.DiemXepHang
                                                </div>
                                                <small class="text-muted">Điểm</small>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                hang++;
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Phân trang -->
                <div class="d-flex justify-content-between align-items-center p-4 border-top">
                    <div class="text-muted">
                        Hiển thị <span id="visiblePlayers">@Model.Count</span> người chơi
                    </div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item disabled">
                                <a class="page-link" href="#">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
            else
            {
                <div class="text-center py-6">
                    <div class="empty-state">
                        <div class="empty-state-icon bg-gradient-warning">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <h3 class="mt-4 text-gray-700">Không có dữ liệu xếp hạng</h3>
                        <p class="text-gray-500 mb-4">Chưa có người chơi nào đạt điểm số</p>
                        <button class="btn btn-warning" onclick="location.reload()">
                            <i class="fas fa-sync-alt mr-2"></i>Tải lại
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Thống kê hôm nay -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 animate__animated animate__fadeInUp">
                <div class="card-header bg-gradient-success border-0 py-4">
                    <h6 class="m-0 font-weight-bold text-white">
                        <i class="fas fa-chart-bar mr-2"></i>Thống kê hôm nay
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div id="todayStats">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Đang tải...</span>
                            </div>
                            <p class="text-muted mt-2">Đang tải thống kê...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal chi tiết người chơi -->
<div class="modal fade" id="playerDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-gradient-primary border-0">
                <h5 class="modal-title text-white">
                    <i class="fas fa-user-circle mr-2"></i>Chi tiết người chơi
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4" id="playerDetailContent">
                <!-- Nội dung sẽ được load bằng JS -->
            </div>
        </div>
    </div>
</div>

@functions {

    public string GetAvatarColor(int rank)
    {
        if (rank == 1) return "bg-warning";
        if (rank == 2) return "bg-secondary";
        if (rank == 3) return "bg-brown";
        return "bg-primary";
    }

    public string GetProgressColor(int rank)
    {
        if (rank == 1) return "bg-warning";
        if (rank == 2) return "bg-secondary";
        if (rank == 3) return "bg-brown";
        return "bg-info";
    }

    public string GetScoreColor(int rank)
    {
        if (rank == 1) return "text-warning";
        if (rank == 2) return "text-secondary";
        if (rank == 3) return "text-brown";
        return "text-primary";
    }

    public string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "??";

        var names = fullName
            .Trim()
            .Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);

        if (names.Length >= 2)
        {
            char first = names[0][0];
            char last = names[names.Length - 1][0];
            return ("" + first + last).ToUpper();
        }

        if (fullName.Length >= 2)
            return fullName.Substring(0, 2).ToUpper();

        return fullName.ToUpper();
    }
}


<style>
    /* CSS Variables */
    :root {
        --gold-gradient: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
        --silver-gradient: linear-gradient(135deg, #C0C0C0 0%, #A9A9A9 100%);
        --bronze-gradient: linear-gradient(135deg, #CD7F32 0%, #A0522D 100%);
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --info-gradient: linear-gradient(135deg, #17a2b8 0%, #20c997 100%);
        --success-gradient: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        --warning-gradient: linear-gradient(135deg, #ffc107 0%, #ff9900 100%);
        --shadow-sm: 0 .125rem .25rem rgba(0,0,0,.075);
        --shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        --shadow-lg: 0 1rem 3rem rgba(0,0,0,.175);
    }

    /* Custom Styles */
    body {
        background: linear-gradient(135deg, #f8f9fc 0%, #e9ecef 100%);
        min-height: 100vh;
    }

    .card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

    .card-header {
        border-radius: 1rem 1rem 0 0 !important;
    }

    .bg-gradient-primary {
        background: var(--primary-gradient);
    }

    .bg-gradient-info {
        background: var(--info-gradient);
    }
    .score-big {
        font-size: 1.35rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .bg-gradient-success {
        background: var(--success-gradient);
    }

    .bg-gradient-warning {
        background: var(--warning-gradient);
    }
    .gap-3 {
        gap: 0.75rem;
    }

    /* Rank badges */
    .rank-badge {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: white;
        box-shadow: var(--shadow);
    }

    .rank-gold {
        background: var(--gold-gradient);
    }

    .rank-silver {
        background: var(--silver-gradient);
    }

    .rank-bronze {
        background: var(--bronze-gradient);
    }

    .rank-other {
        background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
    }

    .rank-number {
        font-size: 1.25rem;
        font-weight: bold;
    }

    /* Avatar */
    .avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: 600;
    }

    .avatar-md {
        width: 50px;
        height: 50px;
        font-size: 1.25rem;
    }

    .avatar-initials {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: white;
    }
    .rank-gold {
        transform: scale(1.1);
    }

    .rank-silver,
    .rank-bronze {
        transform: scale(1.05);
    }
    .table tbody td {
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
    }

    .bg-brown {
        background: linear-gradient(135deg, #CD7F32 0%, #A0522D 100%);
    }

    /* Table styles */
    .table {
        margin-bottom: 0;
    }

        .table thead th {
            border-top: none;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            color: #4a5568;
            background-color: #f8f9fe;
        }

        .table tbody tr {
            transition: all 0.3s;
            border-left: 3px solid transparent;
        }

            .table tbody tr:hover {
                background-color: #f8f9fe;
                border-left-color: #667eea;
                transform: translateX(2px);
                cursor: pointer;
            }

    .score-display {
        flex: 1;
    }

    .score-value {
        font-size: 1.1rem;
    }

    /* Form controls */
    .input-group-text {
        border-radius: 0.5rem 0 0 0.5rem;
        border-right: none;
        transition: all 0.3s;
    }

    .form-control {
        border-radius: 0 0.5rem 0.5rem 0;
        border-left: none;
        transition: all 0.3s;
    }

        .form-control:focus {
            box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
            border-color: #667eea;
        }

    .input-group:focus-within .input-group-text {
        border-color: #667eea;
        background-color: rgba(102, 126, 234, 0.1);
    }

    /* Buttons */
    .btn {
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-warning {
        background: var(--warning-gradient);
        border: none;
        color: white;
    }

        .btn-warning:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);
        }

    /* Icon shape */
    .icon-shape {
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Empty state */
    .empty-state {
        padding: 3rem 1rem;
    }

    .empty-state-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 1.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
    }

    /* Alert */
    .alert {
        border: none;
        border-radius: 0.5rem;
        box-shadow: var(--shadow-sm);
    }

    .alert-icon {
        font-size: 1.25rem;
    }

    /* Cursor */
    .cursor-pointer {
        cursor: pointer;
    }

    /* Animation */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate__animated {
        animation-duration: 0.6s;
        animation-fill-mode: both;
    }

    .animate__fadeInUp {
        animation-name: fadeInUp;
    }

    /* Scrollbar */
    .table-responsive::-webkit-scrollbar {
        height: 8px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--primary-gradient);
        border-radius: 10px;
    }

    /* Progress bars */
    .progress {
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar {
        border-radius: 10px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .card-body {
            padding: 1.5rem;
        }

        .table-responsive {
            font-size: 0.9rem;
        }
        .score-display {
            display: none;
        }

        .avatar-md {
            width: 36px;
            height: 36px;
            font-size: 0.9rem;
        }

        .rank-badge {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }

        .avatar-md {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }
    }
</style>

<script>
    // Khởi tạo
    let currentSort = { column: 'rank', direction: 'asc' };

    // Load thống kê hôm nay
    function loadTodayStats() {
        fetch('/Admin/BXH/TodayStats')
            .then(res => {
                if (!res.ok) throw new Error('Network response was not ok');
                return res.text();
            })
            .then(html => {
                const todayStatsElement = document.getElementById('todayStats');
                if (todayStatsElement) {
                    todayStatsElement.innerHTML = html;
                    // Thêm animation cho các phần tử mới
                    todayStatsElement.querySelectorAll('.card, .stat-item').forEach((el, index) => {
                        el.style.animationDelay = `${index * 100}ms`;
                        el.classList.add('animate__animated', 'animate__fadeIn');
                    });
                }
            })
            .catch(error => {
                const todayStatsElement = document.getElementById('todayStats');
                if (todayStatsElement) {
                    todayStatsElement.innerHTML = `
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-exclamation-circle me-3"></i>
                                <div>Không thể tải thống kê hôm nay. Vui lòng thử lại sau.</div>
                            </div>
                        </div>
                    `;
                }
                console.error('Error loading today stats:', error);
            });
    }

    // Sắp xếp bảng
    function sortTable(column) {
        const table = document.getElementById('rankTable');
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('.rank-row'));

        // Đảo ngược hướng sắp xếp nếu click lại cùng cột
        if (currentSort.column === column) {
            currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
        } else {
            currentSort.column = column;
            currentSort.direction = 'asc';
        }

        rows.sort((a, b) => {
            let aValue, bValue;

            switch (column) {
                case 'rank':
                    aValue = parseInt(a.querySelector('.rank-number')?.textContent ||
                        a.querySelector('.font-weight-bold').textContent.replace('Hạng #', ''));
                    bValue = parseInt(b.querySelector('.rank-number')?.textContent ||
                        b.querySelector('.font-weight-bold').textContent.replace('Hạng #', ''));
                    break;
                case 'player':
                    aValue = a.querySelector('.font-weight-bold').textContent.toLowerCase();
                    bValue = b.querySelector('.font-weight-bold').textContent.toLowerCase();
                    break;
                case 'score':
                    aValue = parseInt(a.querySelector('.score-value').textContent.replace(/,/g, ''));
                    bValue = parseInt(b.querySelector('.score-value').textContent.replace(/,/g, ''));
                    break;
            }

            if (currentSort.direction === 'asc') {
                return aValue > bValue ? 1 : -1;
            } else {
                return aValue < bValue ? 1 : -1;
            }
        });

        // Xóa và thêm lại các hàng đã sắp xếp
        rows.forEach(row => tbody.appendChild(row));

        // Cập nhật icon sắp xếp
        updateSortIcons(column);

        // Cập nhật số thứ tự
        updateRankNumbers();
    }

    function updateSortIcons(currentColumn) {
        document.querySelectorAll('.fa-sort').forEach(icon => {
            icon.classList.remove('fa-sort-up', 'fa-sort-down');
            icon.classList.add('fa-sort');
        });

        const currentIcon = document.querySelector(`[onclick="sortTable('${currentColumn}")"]`);
        if (currentIcon) {
            currentIcon.classList.remove('fa-sort');
            currentIcon.classList.add(currentSort.direction === 'asc' ? 'fa-sort-up' : 'fa-sort-down');
        }
    }

    function updateRankNumbers() {
        const rows = document.querySelectorAll('.rank-row');
        rows.forEach((row, index) => {
            const rankNumber = index + 1;
            const rankBadge = row.querySelector('.rank-number');
            const rankText = row.querySelector('.font-weight-bold');
            const rankSubtext = row.querySelector('.text-muted');

            if (rankBadge) rankBadge.textContent = rankNumber;
            if (rankText) rankText.textContent = `Hạng #${rankNumber}`;
            if (rankSubtext && rankNumber > 3) {
                rankSubtext.textContent = 'Top ' + document.getElementById('currentTop').textContent;
            }
        });
    }

    // Tìm kiếm người chơi
    document.getElementById('searchInput')?.addEventListener('input', function (e) {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('#rankTable .rank-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const playerData = row.getAttribute('data-player');
            if (playerData.includes(searchTerm)) {
                row.style.display = '';
                visibleCount++;

                // Highlight kết quả tìm kiếm
                const playerName = row.querySelector('.font-weight-bold');
                const userName = row.querySelector('.text-muted');

                if (searchTerm && playerName) {
                    const originalName = playerName.getAttribute('data-original') || playerName.textContent;
                    playerName.setAttribute('data-original', originalName);
                    const highlighted = originalName.replace(
                        new RegExp(searchTerm, 'gi'),
                        match => `<span class="bg-warning text-dark px-1 rounded">${match}</span>`
                    );
                    playerName.innerHTML = highlighted;
                }

                if (searchTerm && userName) {
                    const originalUser = userName.getAttribute('data-original') || userName.textContent;
                    userName.setAttribute('data-original', originalUser);
                    const highlighted = originalUser.replace(
                        new RegExp(searchTerm, 'gi'),
                        match => `<span class="bg-warning text-dark px-1 rounded">${match}</span>`
                    );
                    userName.innerHTML = highlighted;
                }
            } else {
                row.style.display = 'none';

                // Khôi phục text gốc
                const playerName = row.querySelector('.font-weight-bold');
                const userName = row.querySelector('.text-muted');

                if (playerName && playerName.getAttribute('data-original')) {
                    playerName.textContent = playerName.getAttribute('data-original');
                }

                if (userName && userName.getAttribute('data-original')) {
                    userName.textContent = userName.getAttribute('data-original');
                }
            }
        });

        document.getElementById('visiblePlayers').textContent = visibleCount;
    });

    // Click vào hàng để xem chi tiết
    document.addEventListener('click', function (e) {
        const row = e.target.closest('.rank-row');
        if (row) {
            showPlayerDetail(row);
        }
    });

    function showPlayerDetail(row) {
        const playerName = row.querySelector('.font-weight-bold').textContent;
        const userName = row.querySelector('.text-muted').textContent.match(/[^•]*/)[0].trim();
        const rank = row.querySelector('.font-weight-bold').textContent.match(/#(\d+)/)[1];
        const score = row.querySelector('.score-value').textContent;

        const detailContent = document.getElementById('playerDetailContent');
        detailContent.innerHTML = `
            <div class="text-center mb-4">
                <div class="avatar avatar-lg mx-auto mb-3">
                    <div class="avatar-initials bg-primary">
                        ${playerName.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2)}
                    </div>
                </div>
                <h4 class="font-weight-bold text-gray-800">${playerName}</h4>
                <p class="text-muted mb-0">
                    <i class="fas fa-user mr-1"></i>${userName}
                </p>
            </div>

            <div class="row text-center mb-4">
                <div class="col-4">
                    <div class="h3 font-weight-bold text-primary">${rank}</div>
                    <small class="text-muted">Hạng</small>
                </div>
                <div class="col-4">
                    <div class="h3 font-weight-bold text-success">${score}</div>
                    <small class="text-muted">Điểm</small>
                </div>
                <div class="col-4">
                    <div class="h3 font-weight-bold text-warning">${Math.floor(Math.random() * 100)}</div>
                    <small class="text-muted">Trận đã chơi</small>
                </div>
            </div>

            <div class="bg-light rounded p-3 mb-3">
                <h6 class="font-weight-bold text-gray-700 mb-2">
                    <i class="fas fa-chart-line mr-2 text-primary"></i>Thống kê chi tiết
                </h6>
                <div class="row">
                    <div class="col-6 mb-2">
                        <small class="text-muted">Thắng:</small>
                        <div class="font-weight-bold text-success">${Math.floor(Math.random() * 50)}</div>
                    </div>
                    <div class="col-6 mb-2">
                        <small class="text-muted">Thua:</small>
                        <div class="font-weight-bold text-danger">${Math.floor(Math.random() * 30)}</div>
                    </div>
                    <div class="col-6 mb-2">
                        <small class="text-muted">Tỉ lệ thắng:</small>
                        <div class="font-weight-bold text-info">${Math.floor(Math.random() * 30) + 70}%</div>
                    </div>
                    <div class="col-6 mb-2">
                        <small class="text-muted">Điểm trung bình:</small>
                        <div class="font-weight-bold text-warning">${Math.floor(Math.random() * 100) + 50}</div>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <button class="btn btn-primary" onclick="viewFullProfile('${userName}')">
                    <i class="fas fa-external-link-alt mr-2"></i>Xem hồ sơ đầy đủ
                </button>
            </div>
        `;

        $('#playerDetailModal').modal('show');
    }

    function viewFullProfile(username) {
        alert(`Xem hồ sơ đầy đủ của: ${username}`);
        $('#playerDetailModal').modal('hide');
    }

    // Khởi tạo khi trang load
    document.addEventListener('DOMContentLoaded', function () {
        // Load thống kê hôm nay
        loadTodayStats();

        // Cập nhật số lượng hiển thị
        updateVisibleCount();

        // Tự động refresh thống kê mỗi 30 giây
        setInterval(loadTodayStats, 30000);
    });

    function updateVisibleCount() {
        const visibleCount = document.querySelectorAll('#rankTable .rank-row:not([style*="display: none"])').length;
        document.getElementById('visiblePlayers').textContent = visibleCount;
    }
</script>