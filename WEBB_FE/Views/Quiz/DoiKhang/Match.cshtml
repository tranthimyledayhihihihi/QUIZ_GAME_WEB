@{
    ViewBag.Title = "Đang Thi Đấu";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var matchCode = ViewBag.MatchCode as string;
}

<div class="match-container">
    <div class="header">
        <h1>⚔️ Trận Đấu: <span class="match-code">@matchCode</span></h1>
        <div class="timer">
            <span id="timeLeft">15</span>s
        </div>
    </div>

    <div class="game-area" id="gameArea">
        <div class="loading">
            <div class="hourglass-icon">⏳</div>
            <p>Đang tải câu hỏi...</p>
        </div>
    </div>

    <div class="score-board">
        <div class="player-score">
            <h3>🎯 Bạn</h3>
            <div class="score" id="yourScore">0</div>
        </div>
        <div class="vs">VS</div>
        <div class="player-score opponent">
            <h3>👤 Đối thủ</h3>
            <div class="score" id="opponentScore">0</div>
        </div>
    </div>
</div>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        min-height: 100vh;
        padding: 10px;
    }

    .match-container {
        max-width: 100%;
        margin: 10px auto;
        padding: 15px;
        width: 100%;
    }

    .header {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 15px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px 15px;
        border-radius: 15px;
        margin-bottom: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        width: 100%;
    }

    .header h1 {
        margin: 0;
        font-size: clamp(18px, 5vw, 24px);
        line-height: 1.3;
        word-break: break-word;
    }

    .match-code {
        font-family: 'Courier New', monospace;
        background: rgba(255,255,255,0.2);
        padding: 5px 12px;
        border-radius: 6px;
        font-size: clamp(16px, 4vw, 20px);
        display: inline-block;
        margin-top: 5px;
        word-break: break-all;
    }

    .timer {
        font-size: clamp(24px, 6vw, 32px);
        font-weight: bold;
        background: rgba(255,255,255,0.2);
        padding: 8px 20px;
        border-radius: 10px;
        min-width: 80px;
        text-align: center;
    }

    .game-area {
        background: white;
        border-radius: 15px;
        padding: 20px 15px;
        min-height: 300px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        margin-bottom: 20px;
        width: 100%;
        overflow: hidden;
    }

    .loading {
        text-align: center;
        padding: 40px 10px;
    }

    .hourglass-icon {
        font-size: clamp(40px, 10vw, 60px);
        animation: rotate 2s infinite linear;
        margin-bottom: 15px;
    }

    .loading p {
        font-size: clamp(16px, 4vw, 18px);
        color: #666;
    }

    .question-box {
        margin-bottom: 20px;
    }

    .question-number {
        color: #7f8c8d;
        font-size: clamp(14px, 3.5vw, 16px);
        margin-bottom: 10px;
        display: block;
    }

    .question-text {
        font-size: clamp(18px, 4.5vw, 22px);
        font-weight: bold;
        color: #2c3e50;
        line-height: 1.4;
        word-wrap: break-word;
    }

    .answers-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        margin-top: 20px;
    }

    @@media (min-width: 768px) {
        .answers-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    .answer-btn {
        padding: 16px 12px;
        font-size: clamp(16px, 4vw, 18px);
        background: #ecf0f1;
        border: 2px solid transparent;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s;
        text-align: left;
        word-break: break-word;
        min-height: 60px;
        display: flex;
        align-items: center;
    }

    .answer-btn:hover:not(.disabled) {
        background: #3498db;
        color: white;
        border-color: #2980b9;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .answer-btn.selected {
        background: #3498db;
        color: white;
        border-color: #2980b9;
    }

    .answer-btn.correct {
        background: #2ecc71;
        color: white;
        border-color: #27ae60;
    }

    .answer-btn.incorrect {
        background: #e74c3c;
        color: white;
        border-color: #c0392b;
    }

    .answer-btn.disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .score-board {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        width: 100%;
    }

    .player-score {
        background: white;
        padding: 15px 20px;
        border-radius: 15px;
        text-align: center;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        min-width: 120px;
        flex: 1;
        max-width: 160px;
    }

    .player-score h3 {
        margin: 0 0 8px 0;
        color: #2c3e50;
        font-size: clamp(14px, 3.5vw, 16px);
    }

    .score {
        font-size: clamp(32px, 8vw, 48px);
        font-weight: bold;
        color: #3498db;
    }

    .vs {
        font-size: clamp(20px, 5vw, 28px);
        font-weight: bold;
        color: #7f8c8d;
        padding: 0 10px;
    }

    .game-result {
        text-align: center;
        padding: 20px 10px;
        width: 100%;
    }

    .result-title {
        font-size: clamp(24px, 6vw, 32px);
        color: #2c3e50;
        margin-bottom: 20px;
        line-height: 1.3;
    }

    .final-scores {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin: 25px 0;
        flex-wrap: wrap;
    }

    .final-score {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px 25px;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        min-width: 120px;
        flex: 1;
        max-width: 160px;
    }

    .final-score h3 {
        margin: 0 0 10px 0;
        color: #34495e;
        font-size: clamp(14px, 3.5vw, 16px);
    }

    .big-score {
        font-size: clamp(40px, 10vw, 56px);
        font-weight: bold;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .result-message {
        font-size: clamp(28px, 7vw, 40px);
        font-weight: bold;
        padding: 20px 15px;
        border-radius: 15px;
        margin: 25px 0;
        text-shadow: 1px 1px 3px rgba(0,0,0,0.2);
        word-break: break-word;
    }

    .result-message.winner {
        background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
        color: white;
    }

    .result-message.loser {
        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
        color: white;
    }

    .result-message.draw {
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        color: white;
    }

    .winner-name {
        font-size: clamp(18px, 4.5vw, 22px);
        color: #2c3e50;
        margin: 15px 0;
        font-weight: 600;
        word-break: break-word;
    }

    .btn-return {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 16px 40px;
        font-size: clamp(16px, 4vw, 18px);
        border-radius: 50px;
        cursor: pointer;
        margin-top: 25px;
        transition: all 0.3s;
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        font-weight: bold;
        width: 100%;
        max-width: 300px;
    }

    .btn-return:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.6);
    }

    @@keyframes rotate {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @@media (max-width: 480px) {
        .match-container { padding: 10px; }
        .header { padding: 15px 10px; gap: 10px; }
        .game-area { padding: 15px 10px; min-height: 280px; }
        .player-score { padding: 12px 15px; min-width: 100px; }
        .final-score { padding: 15px 20px; min-width: 100px; }
        .result-message { padding: 15px 10px; margin: 20px 0; }
    }

    @@media (min-width: 1024px) {
        .match-container { max-width: 900px; margin: 20px auto; }
        .header { flex-direction: row; justify-content: space-between; padding: 20px 30px; }
        .game-area { padding: 30px 25px; }
        .answers-grid { gap: 20px; }
        .answer-btn { padding: 20px 15px; min-height: 70px; }
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    const matchCode = '@Html.Raw(matchCode)';
    let ws;
    let currentQuestions = [];
    let currentQuestionIndex = 0;
    let myUserId = null;
    let yourScore = 0;
    let opponentScore = 0;
    let timer;
    let timeLeft = 15;

    function getToken() {
        var token = '@Html.Raw(Session["JwtToken"])';
        if (!token || token === '') {
            token = '@Html.Raw(Session["JWT_TOKEN"])';
        }
        return token;
    }

    function connectToMatch() {
        const token = getToken();

        if (!token || token === '') {
            alert('❌ Chưa đăng nhập!');
            window.location.href = '/User/Account/Login';
            return;
        }

        const wsUrl = 'wss://localhost:7092/ws/game?access_token=' + encodeURIComponent(token);
        ws = new WebSocket(wsUrl);

        ws.onopen = function() {
            ws.send(JSON.stringify({
                Type: 'JOIN_MATCH',
                Data: { matchCode: matchCode }
            }));
        };

        ws.onmessage = function(event) {
            try {
                const data = JSON.parse(event.data);
                handleMessage(data);
            } catch (error) {
                console.error('Error parsing message:', error);
            }
        };

        ws.onerror = function(error) {
            console.error('WebSocket error:', error);
        };

        ws.onclose = function() {
            console.log('WebSocket closed');
        };
    }

    function handleMessage(data) {
        switch(data.Type) {
            case 'JOINED_MATCH':
                break;

            case 'QUESTIONS':
                currentQuestions = data.Data;
                if (currentQuestions && currentQuestions.length > 0) {
                    displayQuestion(0);
                }
                break;

            case 'SCORE_UPDATE':
                updateScores(data.Data);
                break;

            case 'GAME_END':
                clearInterval(timer);
                showGameResult(data.Data);
                break;
        }
    }

    function displayQuestion(index) {
        if (index >= currentQuestions.length) {
            $('#gameArea').html('<div class="loading"><h2>⏳ Đang chờ kết quả...</h2></div>');
            return;
        }

        const q = currentQuestions[index];
        currentQuestionIndex = index;

        let choices;
        try {
            choices = JSON.parse(q.CacLuaChon);
        } catch (error) {
            choices = { A: '', B: '', C: '', D: '' };
        }

        let html = '<div class="question-box">';
        html += '<span class="question-number">Câu ' + (index + 1) + '/' + currentQuestions.length + '</span>';
        html += '<div class="question-text">' + q.NoiDung + '</div>';
        html += '</div>';

        html += '<div class="answers-grid">';
        ['A', 'B', 'C', 'D'].forEach(letter => {
            if (choices[letter]) {
                html += '<button class="answer-btn" data-answer="' + letter + '">' + letter + '. ' + choices[letter] + '</button>';
            }
        });
        html += '</div>';

        $('#gameArea').html(html);
        startTimer();

        $('.answer-btn').click(function() {
            if ($(this).hasClass('disabled')) return;

            $('.answer-btn').addClass('disabled');
            $(this).addClass('selected');

            const answer = $(this).data('answer');
            submitAnswer(q.CauHoiID, answer);
        });
    }

    function startTimer() {
        timeLeft = 15;
        $('#timeLeft').text(timeLeft);

        clearInterval(timer);
        timer = setInterval(function() {
            timeLeft--;
            $('#timeLeft').text(timeLeft);

            if (timeLeft <= 0) {
                clearInterval(timer);
                if (currentQuestions[currentQuestionIndex]) {
                    submitAnswer(currentQuestions[currentQuestionIndex].CauHoiID, '');
                }
            }
        }, 1000);
    }

    function submitAnswer(questionId, answer) {
        clearInterval(timer);

        const timeSpent = 15 - timeLeft;

        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({
                Type: 'SUBMIT_ANSWER',
                Data: {
                    matchCode: matchCode,
                    questionId: questionId,
                    selectedAnswer: answer || '',
                    timeSpent: timeSpent
                }
            }));
        }

        setTimeout(function() {
            displayQuestion(currentQuestionIndex + 1);
        }, 2000);
    }

    function updateScores(data) {
        if (data.correct && data.userId === myUserId) {
            yourScore += 100;
        } else if (data.correct && data.userId !== myUserId) {
            opponentScore += 100;
        }

        $('#yourScore').text(yourScore);
        $('#opponentScore').text(opponentScore);

        if (data.selectedAnswer) {
            const $btn = $('.answer-btn[data-answer="' + data.selectedAnswer + '"]');
            if (data.correct) {
                $btn.removeClass('selected').addClass('correct');
            } else {
                $btn.removeClass('selected').addClass('incorrect');
            }
        }
    }

    function showGameResult(data) {
        clearInterval(timer);

        const player1Score = data.player1Score || 0;
        const player2Score = data.player2Score || 0;
        const winner = data.winner || '';
        const winnerName = data.winnerName || '';

        let resultHtml = '<div class="game-result">';
        resultHtml += '<h1 class="result-title">🏁 Trận Đấu Kết Thúc!</h1>';

        resultHtml += '<div class="final-scores">';
        resultHtml += '<div class="final-score">';
        resultHtml += '<h3>🎯 Player 1</h3>';
        resultHtml += '<div class="big-score">' + player1Score + '</div>';
        resultHtml += '</div>';

        resultHtml += '<div class="vs">VS</div>';

        resultHtml += '<div class="final-score">';
        resultHtml += '<h3>👤 Player 2</h3>';
        resultHtml += '<div class="big-score">' + player2Score + '</div>';
        resultHtml += '</div>';
        resultHtml += '</div>';

        let resultClass = 'draw';
        let resultText = '🤝 Hòa!';

        if (winner === 'player1') {
            resultClass = 'winner';
            resultText = '🎉 Player 1 Chiến Thắng!';
        } else if (winner === 'player2') {
            resultClass = 'winner';
            resultText = '🎉 Player 2 Chiến Thắng!';
        }

        resultHtml += '<div class="result-message ' + resultClass + '">' + resultText + '</div>';

        if (winnerName && winner !== 'draw') {
            resultHtml += '<p class="winner-name">👑 Người thắng: ' + winnerName + '</p>';
        }

        resultHtml += '<button class="btn-return" onclick="returnToLobby()">🏠 Trở về Lobby</button>';
        resultHtml += '</div>';

        $('#gameArea').html(resultHtml);
        $('.timer').hide();
    }

    function returnToLobby() {
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.close();
        }
        window.location.href = '/Quiz/DoiKhang';
    }

    $(document).ready(function() {
        if (!matchCode || matchCode.trim() === '') {
            alert('❌ Mã trận đấu không hợp lệ!');
            window.location.href = '/Quiz/DoiKhang';
            return;
        }

        setTimeout(function() {
            connectToMatch();
        }, 500);
    });

    $(window).on('beforeunload', function() {
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.close();
        }
        clearInterval(timer);
    });
</script>