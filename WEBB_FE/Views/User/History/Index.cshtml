@model WEBB.Models.ViewModels.HistoryListViewModel
@{
    ViewBag.Title = "Lịch sử đấu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📜 Lịch sử Chinh Chiến</h2>
        <a href="@Url.Action("Index", "Profile")" class="btn btn-secondary">
            <i class="fa fa-arrow-left"></i> Quay lại
        </a>
    </div>
    @if (Model.DanhSach == null || Model.DanhSach.Count == 0)
    {
        <div class="alert alert-info">Bạn chưa chơi trận nào cả. Hãy thử thách ngay!</div>
    }
    else
    {
        <table class="table table-hover table-bordered shadow-sm">
            <thead class="table-primary text-center">
                <tr>
                    <th>Ngày chơi</th>
                    <th>Quiz</th>
                    <th>Điểm</th>
                    <th>Đúng / Tổng</th>
                    <th>Kết quả</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.DanhSach)
                {
                    <tr class="text-center align-middle">
                        <td>@item.NgayChoi.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(string.IsNullOrEmpty(item.TenQuiz) ? "Quiz Thử Thách" : item.TenQuiz)</td>
                        <td class="fw-bold text-danger">@item.Diem</td>
                        <td>@item.SoCauDung / @item.TongSoCau</td>
                        <td>
                            <!-- Logic màu sắc đơn giản -->
                            @if (item.SoCauDung >= (item.TongSoCau / 2))
                            {
                                <span class="badge bg-success">Thắng</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Thua</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Phân trang cơ bản -->
        if (Model.TongSoTrang > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.TongSoTrang; i++)
                    {
                        <li class="page-item @(i == Model.TrangHienTai ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>