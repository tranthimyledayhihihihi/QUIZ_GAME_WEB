<script>
    // Khởi tạo các biến
    let currentSort = { column: 'date', direction: 'desc' };
    let currentRewardId = null;

    // Xử lý form tặng thưởng
    document.getElementById('giveRewardForm')?.addEventListener('submit', function (e) {
        e.preventDefault();

        const submitBtn = document.getElementById('submitBtn');
        const spinner = document.getElementById('submitSpinner');
        const submitText = submitBtn.querySelector('.submit-text');

        const userId = document.getElementById('UserID').value.trim();
        const rewardName = document.getElementById('PhanThuong').value.trim();

        if (!userId || !rewardName) {
            showToast('Vui lòng điền đầy đủ thông tin!', 'error');
            return;
        }

        // Hiển thị loading
        submitBtn.disabled = true;
        spinner.classList.remove('d-none');
        submitText.textContent = 'Đang xử lý...';

        // Giả lập delay
        setTimeout(() => {
            // Submit form thực tế
            this.submit();

            // Reset form và hiển thị thông báo
            setTimeout(() => {
                this.reset();
                showToast('Đã tặng phần thưởng thành công!');

                // Reset button
                submitBtn.disabled = false;
                spinner.classList.add('d-none');
                submitText.textContent = 'Tặng ngay';
            }, 500);
        }, 1500);
    });

    // Hiển thị chi tiết phần thưởng
    function showRewardDetail(rewardId) {
        // Tìm hàng chứa phần thưởng
        const rows = document.querySelectorAll('.reward-row');
        let targetRow = null;

        rows.forEach(row => {
            const idBadge = row.cells[0].querySelector('.badge');
            if (idBadge && idBadge.textContent.includes(rewardId.toString())) {
                targetRow = row;
            }
        });

        if (!targetRow) return;

        const username = targetRow.cells[1].querySelector('.font-weight-bold').textContent;
        const userId = targetRow.cells[1].querySelector('.text-muted').textContent.replace('UID: ', '');
        const reward = targetRow.cells[2].querySelector('.font-weight-bold').textContent;
        const points = targetRow.cells[3].querySelector('.font-weight-bold')?.textContent || '0';
        const date = targetRow.cells[4].querySelector('.text-gray-800').textContent.replace('📅 ', '');
        const time = targetRow.cells[4].querySelector('.text-muted').textContent.replace('🕒 ', '');
        const timeAgo = targetRow.cells[4].querySelector('.badge-light').textContent;
        const status = targetRow.cells[5].querySelector('.badge').textContent.trim();
        const statusClass = targetRow.cells[5].querySelector('.badge').className;
        const statusIcon = targetRow.cells[5].querySelector('.badge i').className;

        const detailContent = document.getElementById('rewardDetailContent');
        detailContent.innerHTML = `
            <div class="text-center mb-4">
                <div class="reward-icon-large mx-auto mb-3">
                    <i class="fas fa-gift fa-3x text-warning"></i>
                </div>
                <h4 class="font-weight-bold text-gray-800">Phần Thưởng #${rewardId}</h4>
                <p class="text-muted mb-0">
                    <span class="badge ${statusClass} px-3 py-2">
                        <i class="${statusIcon} mr-1"></i>
                        ${status}
                    </span>
                </p>
            </div>

            <div class="bg-light rounded p-4 mb-4">
                <h6 class="font-weight-bold text-gray-700 mb-3">
                    <i class="fas fa-user-gift mr-2 text-primary"></i>Thông tin Người Nhận
                </h6>
                <div class="d-flex align-items-center mb-3">
                    <div class="avatar avatar-lg mr-3">
                        <div class="avatar-initials ${GetUserColorClass(userId)} text-white">
                            ${username.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2)}
                        </div>
                    </div>
                    <div>
                        <div class="font-weight-bold text-gray-800">${username}</div>
                        <div class="text-muted">
                            <i class="fas fa-hashtag mr-1"></i>User ID: ${userId}
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="bg-light rounded p-3">
                        <h6 class="font-weight-bold text-gray-700 mb-2">
                            <i class="fas fa-gift mr-2 text-primary"></i>Chi tiết Phần Thưởng
                        </h6>
                        <div>
                            <div class="font-weight-bold text-gray-800 mb-1">${reward}</div>
                            ${points !== '0' ? `
                                <div class="d-flex align-items-center mt-2">
                                    <i class="fas fa-coins text-warning mr-2"></i>
                                    <div>
                                        <div class="font-weight-bold text-warning">${points} điểm</div>
                                        <small class="text-muted">Điểm thưởng kèm theo</small>
                                    </div>
                                </div>
                            ` : ''}
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="bg-light rounded p-3">
                        <h6 class="font-weight-bold text-gray-700 mb-2">
                            <i class="fas fa-calendar-alt mr-2 text-primary"></i>Thời gian
                        </h6>
                        <div>
                            <div class="font-weight-bold text-gray-800">
                                <i class="far fa-calendar mr-2"></i>${date}
                            </div>
                            <small class="text-muted">
                                <i class="far fa-clock mr-2"></i>${time}
                            </small>
                            <div class="mt-2">
                                <span class="badge badge-light">${timeAgo}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-light rounded p-3 mb-4">
                <h6 class="font-weight-bold text-gray-700 mb-2">
                    <i class="fas fa-chart-bar mr-2 text-primary"></i>Thống kê Tổng hợp
                </h6>
                <div class="row text-center">
                    <div class="col-4">
                        <div class="h4 font-weight-bold text-primary">${Math.floor(Math.random() * 5) + 1}</div>
                        <small class="text-muted">Phần thưởng nhận</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 font-weight-bold text-success">${Math.floor(Math.random() * 10000)}</div>
                        <small class="text-muted">Tổng điểm</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 font-weight-bold text-info">${status === 'Đã nhận' ? '100%' : '0%'}</div>
                        <small class="text-muted">Tỷ lệ nhận</small>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <button class="btn btn-primary mr-2" onclick="viewUserProfile(${userId})">
                    <i class="fas fa-user mr-2"></i>Xem hồ sơ người dùng
                </button>
                <button class="btn btn-outline-info" onclick="sendReminder(${userId}, ${rewardId})">
                    <i class="fas fa-bell mr-2"></i>Nhắc nhận thưởng
                </button>
            </div>
        `;

        $('#rewardDetailModal').modal('show');
    }

    // Helper function for user color
    function GetUserColorClass(userId) {
        const hash = Array.from(userId).reduce((hash, char) => {
            return (hash << 5) - hash + char.charCodeAt(0);
        }, 0);
        const colors = ['bg-primary', 'bg-success', 'bg-warning', 'bg-danger', 'bg-info'];
        return colors[Math.abs(hash) % colors.length];
    }

    // Xem hồ sơ người dùng
    function viewUserProfile(userId) {
        alert(`Chuyển đến hồ sơ của User ID: ${userId}`);
        $('#rewardDetailModal').modal('hide');
    }

    // Gửi nhắc nhận
    function sendReminder(userId, rewardId) {
        showToast(`Đã gửi nhắc nhận cho User ID: ${userId}`, 'success');
        $('#rewardDetailModal').modal('hide');
    }

    // Xóa phần thưởng
    function deleteReward(rewardId, username, reward) {
        currentRewardId = rewardId;

        // Tìm hàng để lấy thông tin điểm
        const rows = document.querySelectorAll('.reward-row');
        let points = '0';
        rows.forEach(row => {
            const idBadge = row.cells[0].querySelector('.badge');
            if (idBadge && idBadge.textContent.includes(rewardId.toString())) {
                const pointsElement = row.cells[3].querySelector('.font-weight-bold');
                points = pointsElement ? pointsElement.textContent.replace(/,/g, '') : '0';
            }
        });

        // Cập nhật modal xóa
        document.getElementById('deleteUserInitials').textContent =
            username.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2);
        document.getElementById('deleteUsername').textContent = username;

        // Rút gọn nội dung nếu quá dài
        const previewReward = reward.length > 80 ? reward.substring(0, 80) + '...' : reward;
        document.getElementById('deleteRewardPreview').textContent = previewReward;
        document.getElementById('deleteRewardPoints').textContent = points;
        document.getElementById('deleteRewardId').value = rewardId;

        $('#deleteModal').modal('show');
    }

    // Xử lý xác nhận xóa
    document.getElementById('deleteForm')?.addEventListener('submit', function (e) {
        e.preventDefault();

        const btn = this.querySelector('button[type="submit"]');
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Đang xóa...';
        btn.disabled = true;

        const formData = new FormData(this);

        // Gửi request xóa
        fetch(this.action, {
            method: 'POST',
            body: formData
        })
            .then(response => {
                if (response.ok) {
                    // Xóa hàng khỏi bảng
                    const rows = document.querySelectorAll('.reward-row');
                    rows.forEach(row => {
                        const idBadge = row.cells[0].querySelector('.badge');
                        if (idBadge && idBadge.textContent.includes(currentRewardId.toString())) {
                            row.classList.add('animate__animated', 'animate__fadeOut');
                            setTimeout(() => {
                                row.remove();
                                updateStats();
                                updateVisibleCount();
                                showToast('Đã xóa phần thưởng thành công!');
                            }, 500);
                        }
                    });
                    $('#deleteModal').modal('hide');
                } else {
                    showToast('Có lỗi xảy ra khi xóa phần thưởng!', 'error');
                }
            })
            .catch(error => {
                showToast('Lỗi kết nối!', 'error');
            })
            .finally(() => {
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                currentRewardId = null;
            });
    });

    // Cập nhật thống kê
    function updateStats() {
        const rows = document.querySelectorAll('.reward-row');
        const total = rows.length;

        let received = 0;
        let pending = 0;
        let totalPoints = 0;

        rows.forEach(row => {
            const statusBadge = row.cells[5].querySelector('.badge');
            const pointsElement = row.cells[3].querySelector('.font-weight-bold');

            if (statusBadge.textContent.includes('Đã nhận')) {
                received++;
            } else {
                pending++;
            }

            if (pointsElement) {
                const points = parseInt(pointsElement.textContent.replace(/,/g, '')) || 0;
                totalPoints += points;
            }
        });

        const uniqueUsers = new Set();
        rows.forEach(row => {
            const userIdElement = row.cells[1].querySelector('.text-muted');
            if (userIdElement) {
                const userId = userIdElement.textContent.match(/\d+/);
                if (userId) uniqueUsers.add(userId[0]);
            }
        });

        document.getElementById('totalCount').textContent = total;
        document.getElementById('receivedCount').textContent = received;
        document.getElementById('pendingCount').textContent = pending;
        document.getElementById('totalPoints').textContent = totalPoints.toLocaleString();
        document.getElementById('uniqueUsers').textContent = uniqueUsers.size;
    }

    // Hiển thị toast
    function showToast(message, type = 'success') {
        const toast = document.getElementById('successToast');
        const toastMessage = document.getElementById('toastMessage');

        if (type === 'error') {
            toast.querySelector('.toast-header').className = 'toast-header bg-gradient-danger text-white border-0';
            toast.querySelector('.fas').className = 'fas fa-exclamation-circle mr-2';
            toast.querySelector('.me-auto').textContent = 'Lỗi!';
        } else {
            toast.querySelector('.toast-header').className = 'toast-header bg-gradient-success text-white border-0';
            toast.querySelector('.fas').className = 'fas fa-check-circle mr-2';
            toast.querySelector('.me-auto').textContent = 'Thành công!';
        }

        toastMessage.textContent = message;

        const bsToast = new bootstrap.Toast(toast);
        bsToast.show();
    }

    // Sắp xếp bảng
    function sortTable(column) {
        const table = document.getElementById('rewardTable');
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('.reward-row'));

        if (currentSort.column === column) {
            currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
        } else {
            currentSort.column = column;
            currentSort.direction = 'asc';
        }

        rows.sort((a, b) => {
            let aValue, bValue;

            switch (column) {
                case 'id':
                    aValue = parseInt(a.cells[0].querySelector('.badge').textContent.replace('#', ''));
                    bValue = parseInt(b.cells[0].querySelector('.badge').textContent.replace('#', ''));
                    break;
                case 'user':
                    aValue = a.cells[1].querySelector('.font-weight-bold').textContent.toLowerCase();
                    bValue = b.cells[1].querySelector('.font-weight-bold').textContent.toLowerCase();
                    break;
                case 'reward':
                    aValue = a.cells[2].querySelector('.font-weight-bold').textContent.toLowerCase();
                    bValue = b.cells[2].querySelector('.font-weight-bold').textContent.toLowerCase();
                    break;
                case 'points':
                    const aPoints = a.cells[3].querySelector('.font-weight-bold');
                    const bPoints = b.cells[3].querySelector('.font-weight-bold');
                    aValue = aPoints ? parseInt(aPoints.textContent.replace(/,/g, '')) || 0 : 0;
                    bValue = bPoints ? parseInt(bPoints.textContent.replace(/,/g, '')) || 0 : 0;
                    break;
                case 'date':
                    aValue = new Date(a.cells[4].querySelector('.text-gray-800').textContent.split('/').reverse().join('-'));
                    bValue = new Date(b.cells[4].querySelector('.text-gray-800').textContent.split('/').reverse().join('-'));
                    break;
                case 'status':
                    aValue = a.cells[5].querySelector('.badge').textContent.toLowerCase();
                    bValue = b.cells[5].querySelector('.badge').textContent.toLowerCase();
                    break;
            }

            if (currentSort.direction === 'asc') {
                return aValue > bValue ? 1 : -1;
            } else {
                return aValue < bValue ? 1 : -1;
            }
        });

        rows.forEach(row => tbody.appendChild(row));
        updateSortIcons(column);
    }

    function updateSortIcons(currentColumn) {
        document.querySelectorAll('.fa-sort').forEach(icon => {
            icon.classList.remove('fa-sort-up', 'fa-sort-down');
            icon.classList.add('fa-sort');
        });

        const currentIcon = document.querySelector(`[onclick="sortTable('${currentColumn}")"]`);
        if (currentIcon) {
            currentIcon.classList.remove('fa-sort');
            currentIcon.classList.add(currentSort.direction === 'asc' ? 'fa-sort-up' : 'fa-sort-down');
        }
    }

    // Tìm kiếm
    document.getElementById('searchInput')?.addEventListener('input', function (e) {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('#rewardTable .reward-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const user = row.getAttribute('data-user');
            const reward = row.getAttribute('data-reward');
            const status = row.getAttribute('data-status');
            const searchText = `${user} ${reward} ${status}`;

            if (searchText.includes(searchTerm)) {
                row.style.display = '';
                visibleCount++;

                // Highlight kết quả tìm kiếm
                if (searchTerm) {
                    const rewardText = row.cells[2].querySelector('.font-weight-bold');
                    const originalText = rewardText.getAttribute('data-original') || rewardText.textContent;
                    rewardText.setAttribute('data-original', originalText);
                    const highlighted = originalText.replace(
                        new RegExp(searchTerm, 'gi'),
                        match => `<span class="bg-warning text-dark px-1 rounded">${match}</span>`
                    );
                    rewardText.innerHTML = highlighted;
                }
            } else {
                row.style.display = 'none';

                // Khôi phục text gốc
                const rewardText = row.cells[2].querySelector('.font-weight-bold');
                if (rewardText && rewardText.getAttribute('data-original')) {
                    rewardText.textContent = rewardText.getAttribute('data-original');
                }
            }
        });

        document.getElementById('visibleItems').textContent = visibleCount;
    });

    // Cập nhật số lượng hiển thị
    function updateVisibleCount() {
        const visibleCount = document.querySelectorAll('#rewardTable .reward-row:not([style*="display: none"])').length;
        document.getElementById('visibleItems').textContent = visibleCount;
    }

    // Khởi tạo
    document.addEventListener('DOMContentLoaded', function () {
        // Update visible count
        updateVisibleCount();

        // Add click handlers for table rows
        document.querySelectorAll('.reward-row').forEach(row => {
            row.addEventListener('click', function (e) {
                if (!e.target.closest('.btn')) {
                    const detailBtn = this.querySelector('[onclick^="showRewardDetail"]');
                    if (detailBtn) {
                        const rewardId = detailBtn.getAttribute('onclick').match(/\d+/)[0];
                        showRewardDetail(rewardId);
                    }
                }
            });
        });
    });
</script>