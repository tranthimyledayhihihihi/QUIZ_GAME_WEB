@{
    ViewBag.Title = "Chơi Quiz";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    string roomId = ViewBag.RoomId != null ? ViewBag.RoomId.ToString() : "";
}

<style>
    :root {
        --primary-color: #4361ee;
        --secondary-color: #3a0ca3;
        --accent-color: #f72585;
        --success-color: #4cc9f0;
        --warning-color: #f8961e;
        --danger-color: #ef233c;
        --light-bg: #ffffff;
        --card-bg: #f8f9fa;
        --border-color: #e9ecef;
        --text-dark: #212529;
        --text-light: #6c757d;
    }

    body {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text-dark);
    }

    .hero-section {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
        margin: 30px auto;
        max-width: 1200px;
        overflow: hidden;
        position: relative;
        border: 1px solid var(--border-color);
    }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--primary-color), var(--accent-color));
        }

    .game-title {
        font-family: 'Montserrat', 'Arial', sans-serif;
        font-size: 3.5rem;
        font-weight: 800;
        letter-spacing: 1px;
        margin-bottom: 10px;
        background: linear-gradient(45deg, var(--primary-color), var(--accent-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .tagline {
        font-size: 1.3rem;
        font-weight: 500;
        color: var(--text-light);
        margin-bottom: 30px;
    }

    .start-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 15px;
        padding: 30px;
        margin: 20px 0;
    }

    .alert-box {
        background: rgba(67, 97, 238, 0.08);
        border: 1px solid rgba(67, 97, 238, 0.2);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
    }

        .alert-box i {
            color: var(--primary-color);
        }

    .selection-card {
        background: white;
        border: 2px solid var(--border-color);
        border-radius: 12px;
        padding: 25px;
        height: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.03);
    }

        .selection-card:hover {
            transform: translateY(-5px);
            border-color: var(--primary-color);
            box-shadow: 0 10px 25px rgba(67, 97, 238, 0.1);
        }

    .selection-icon {
        font-size: 2.2rem;
        margin-bottom: 15px;
        display: block;
        color: var(--primary-color);
    }

    .form-select-lg {
        background: white;
        border: 2px solid var(--border-color);
        color: var(--text-dark);
        font-size: 1.1rem;
        padding: 12px 20px;
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        .form-select-lg:focus {
            background: white;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.15);
            color: var(--text-dark);
        }

    .btn-start {
        background: linear-gradient(45deg, var(--primary-color), var(--secondary-color));
        border: none;
        padding: 18px 50px;
        font-size: 1.3rem;
        font-weight: 700;
        border-radius: 50px;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(67, 97, 238, 0.25);
    }

        .btn-start:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(67, 97, 238, 0.35);
            background: linear-gradient(45deg, var(--secondary-color), var(--primary-color));
        }

    .stats-bar {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 15px;
        padding: 20px;
        margin-top: 30px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

    .stat-item {
        text-align: center;
        padding: 10px;
    }

    .stat-icon {
        font-size: 1.5rem;
        margin-bottom: 10px;
        display: block;
    }

    .room-badge {
        background: linear-gradient(45deg, var(--warning-color), #e76f00);
        color: white;
        border-radius: 20px;
        padding: 8px 20px;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--border-color), transparent);
        margin: 25px 0;
    }

    /* ========== STYLES FOR PLAY SCREEN ========== */
    #play-screen {
        max-width: 900px;
        margin: 40px auto;
        display: none;
    }

    .question-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 50px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        border: 1px solid var(--border-color);
    }

    .question-header {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: white;
        padding: 25px 30px;
    }

    .progress-container {
        height: 8px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 4px;
        overflow: hidden;
        margin-top: 20px;
    }

    .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, var(--accent-color), var(--success-color));
        border-radius: 4px;
        transition: width 0.5s ease;
    }

    .answer-btn {
        border: 2px solid var(--border-color);
        background: white;
        color: var(--text-dark);
        padding: 22px 25px;
        font-size: 1.05rem;
        font-weight: 500;
        text-align: left;
        border-radius: 12px;
        transition: all 0.3s ease;
        margin-bottom: 15px;
        width: 100%;
        position: relative;
        overflow: hidden;
        cursor: pointer;
    }

        .answer-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            border-color: var(--primary-color);
            background: rgba(67, 97, 238, 0.03);
            box-shadow: 0 8px 20px rgba(67, 97, 238, 0.1);
        }

        .answer-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .answer-btn.correct {
            background: linear-gradient(135deg, #d4edda, #c3e6cb);
            border-color: #28a745;
            color: #155724;
        }

        .answer-btn.wrong {
            background: linear-gradient(135deg, #f8d7da, #f5c6cb);
            border-color: #dc3545;
            color: #721c24;
        }

    .answer-label {
        display: inline-block;
        width: 36px;
        height: 36px;
        line-height: 36px;
        text-align: center;
        background: var(--primary-color);
        color: white;
        border-radius: 50%;
        margin-right: 15px;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .timer-container {
        display: inline-flex;
        align-items: center;
        background: var(--primary-color);
        color: white;
        padding: 8px 20px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1.1rem;
        box-shadow: 0 5px 15px rgba(67, 97, 238, 0.2);
    }

    .timer-danger {
        background: var(--danger-color) !important;
        animation: pulse 1s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }
    }

    .loading-dots {
        display: inline-block;
        position: relative;
        width: 80px;
        height: 80px;
    }

        .loading-dots div {
            position: absolute;
            top: 33px;
            width: 13px;
            height: 13px;
            border-radius: 50%;
            background: var(--primary-color);
            animation-timing-function: cubic-bezier(0, 1, 1, 0);
        }

            .loading-dots div:nth-child(1) {
                left: 8px;
                animation: loading-dots1 0.6s infinite;
            }

            .loading-dots div:nth-child(2) {
                left: 8px;
                animation: loading-dots2 0.6s infinite;
            }

            .loading-dots div:nth-child(3) {
                left: 32px;
                animation: loading-dots2 0.6s infinite;
            }

            .loading-dots div:nth-child(4) {
                left: 56px;
                animation: loading-dots3 0.6s infinite;
            }

    @@keyframes loading-dots1 {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }

    @@keyframes loading-dots3 {
        0% {
            transform: scale(1);
        }

        100% {
            transform: scale(0);
        }
    }

    @@keyframes loading-dots2 {
        0% {
            transform: translate(0, 0);
        }

        100% {
            transform: translate(24px, 0);
        }
    }

    /* Result Screen Styles */
    .result-card {
        background: white;
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
        text-align: center;
        margin: 20px auto;
        max-width: 700px;
        border: 1px solid var(--border-color);
    }

    .result-icon {
        font-size: 5rem;
        margin-bottom: 20px;
    }

    .score-circle {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 30px auto;
        box-shadow: 0 15px 40px rgba(67, 97, 238, 0.3);
    }

    .score-percent {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1;
    }

    .score-label {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
        margin: 30px 0;
    }

    .stat-box {
        background: var(--card-bg);
        padding: 20px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
    }

    .stat-number {
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 5px;
    }

    .stat-correct .stat-number {
        color: #28a745;
    }

    .stat-wrong .stat-number {
        color: #dc3545;
    }

    .stat-skipped .stat-number {
        color: var(--warning-color);
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 12px 30px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .btn-review {
        background: linear-gradient(45deg, var(--warning-color), #e76f00);
        color: white;
        border: none;
    }

        .btn-review:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(248, 150, 30, 0.3);
        }

    .btn-leaderboard {
        background: var(--primary-color);
        color: white;
        border: none;
    }

        .btn-leaderboard:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(67, 97, 238, 0.3);
        }

    .btn-play-again {
        background: white;
        color: var(--primary-color);
        border: 2px solid var(--primary-color);
    }

        .btn-play-again:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-3px);
        }

    /* Responsive adjustments */
    @@media (max-width: 992px) {
        .game-title {
            font-size: 2.8rem;
        }

        .hero-section {
            margin: 20px 15px;
        }

        .action-buttons {
            flex-direction: column;
        }

        .action-btn {
            width: 100%;
        }
    }

    @@media (max-width: 768px) {
        .game-title {
            font-size: 2.2rem;
        }

        .tagline {
            font-size: 1.1rem;
        }

        .btn-start {
            padding: 15px 40px;
            font-size: 1.1rem;
        }

        .answer-btn {
            padding: 18px 20px;
            font-size: 1rem;
        }

        .score-circle {
            width: 150px;
            height: 150px;
        }

        .score-percent {
            font-size: 2.5rem;
        }
    }
</style>

<div class="container-fluid py-4">
    <!-- ================= START SCREEN ================= -->
    <div id="start-screen">
        <div class="hero-section py-5 px-4">
            <div class="text-center">
                <!-- Header với logo và tiêu đề -->
                <div class="mb-4">
                    <i class="fas fa-brain fa-4x mb-4" style="background: linear-gradient(45deg, var(--primary-color), var(--accent-color)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i>
                    <h1 class="game-title">
                        ĐẤU TRƯỜNG TRI THỨC
                    </h1>
                    <div class="tagline mt-3">
                        <span>Nơi trí tuệ tỏa sáng</span> •
                        <span>Nơi đam mê bùng cháy</span>
                    </div>
                </div>

                <!-- Room ID (nếu có) -->
                @if (!string.IsNullOrEmpty(roomId))
                {
                    <div class="room-badge mb-4">
                        <i class="fas fa-door-open"></i>
                        <span>PHÒNG THI: <strong>@roomId</strong></span>
                    </div>
                }

                <!-- Thông báo chào mừng -->
                <div class="start-card">
                    <div class="alert-box">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-bullhorn fa-2x me-3 mt-1"></i>
                            <div>
                                <h4 class="mb-2" style="color: var(--primary-color);">SẴN SÀNG THỬ THÁCH?</h4>
                                <p class="mb-0">Chọn chủ đề và độ khó phù hợp để bắt đầu cuộc hành trình của bạn!</p>
                            </div>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="divider"></div>

                    <!-- Lựa chọn chủ đề và độ khó -->
                    <div class="row justify-content-center g-4 mb-5">
                        <div class="col-lg-5 col-md-6">
                            <div class="selection-card">
                                <i class="fas fa-book selection-icon"></i>
                                <label class="fw-bold fs-5 mb-3 d-block">CHỦ ĐỀ</label>
                                <select id="chuDeSelect" class="form-select form-select-lg">
                                    <option value="1">📜 Lịch sử Việt Nam</option>
                                    <option value="2">🔢 Toán học</option>
                                    <option value="3">🔬 Khoa học</option>
                                    <option value="4">🎨 Văn học & Nghệ thuật</option>
                                    <option value="5">⚽ Thể thao</option>
                                </select>
                                <div class="mt-3" style="color: var(--text-light);">
                                    <small><i class="fas fa-info-circle me-1"></i> Mỗi chủ đề có 100+ câu hỏi</small>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-5 col-md-6">
                            <div class="selection-card">
                                <i class="fas fa-chart-line selection-icon" style="color: var(--accent-color);"></i>
                                <label class="fw-bold fs-5 mb-3 d-block">ĐỘ KHÓ</label>
                                <select id="doKhoSelect" class="form-select form-select-lg">
                                    <option value="1">🌱 Dễ (10 câu)</option>
                                    <option value="2">🌿 Trung bình (15 câu)</option>
                                    <option value="3">🎯 Khó (20 câu)</option>
                                </select>
                                <div class="mt-3" style="color: var(--text-light);">
                                    <small><i class="fas fa-clock me-1"></i> Thời gian: 30s/câu</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Nút bắt đầu -->
                    <div class="text-center mt-4">
                        <button id="btnStartGame" class="btn btn-start">
                            <i class="fas fa-play-circle me-2"></i> BẮT ĐẦU CHIẾN ĐẤU
                        </button>
                    </div>
                </div>

                <!-- Thông tin thêm -->
                <div class="stats-bar">
                    <div class="row justify-content-center">
                        <div class="col-md-3 col-6">
                            <div class="stat-item">
                                <i class="fas fa-users stat-icon" style="color: var(--primary-color);"></i>
                                <div class="fw-bold fs-5">10,000+</div>
                                <small style="color: var(--text-light);">Người chơi</small>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="stat-item">
                                <i class="fas fa-question-circle stat-icon" style="color: var(--success-color);"></i>
                                <div class="fw-bold fs-5">5,000+</div>
                                <small style="color: var(--text-light);">Câu hỏi</small>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="stat-item">
                                <i class="fas fa-trophy stat-icon" style="color: var(--warning-color);"></i>
                                <div class="fw-bold fs-5">50+</div>
                                <small style="color: var(--text-light);">Giải thưởng</small>
                            </div>
                        </div>
                        <div class="col-md-3 col-6">
                            <div class="stat-item">
                                <i class="fas fa-gamepad stat-icon" style="color: var(--accent-color);"></i>
                                <div class="fw-bold fs-5">100+</div>
                                <small style="color: var(--text-light);">Cuộc thi</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= PLAY SCREEN ================= -->
    <div id="play-screen">
        <div class="question-card">
            <!-- Header với tiến độ -->
            <div class="question-header">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6 mb-2 d-inline-block">
                            <i class="fas fa-question-circle me-2"></i>CÂU HỎI
                        </span>
                        <span class="badge bg-light text-dark ms-2 px-3 py-2 fs-6 d-inline-block" id="question-counter">
                            Câu 1/10
                        </span>
                    </div>
                    <div class="text-end">
                        <small class="opacity-75 d-block">Mã lượt chơi:</small>
                        <div class="fw-bold fs-5" id="attempt-id">...</div>
                    </div>
                </div>

                <!-- Timer -->
                <div class="text-center my-3">
                    <div class="timer-container" id="timer-container">
                        <i class="fas fa-clock me-2"></i>
                        <span id="countdown">30</span> giây
                    </div>
                </div>

                <!-- Thanh tiến độ -->
                <div class="progress-container">
                    <div class="progress-bar" id="progress-bar" style="width: 10%"></div>
                </div>
            </div>

            <!-- Nội dung câu hỏi -->
            <div class="p-4 p-md-5">
                <div class="mb-5">
                    <h3 class="fw-bold text-dark mb-4" id="question-text">Đang tải câu hỏi...</h3>
                </div>

                <!-- Khu vực đáp án -->
                <div class="row g-3" id="answers-area">
                    <!-- Đáp án sẽ được thêm bằng JavaScript -->
                </div>

                <!-- Hint -->
                <div class="mt-4 pt-3 border-top">
                    <small class="text-muted">
                        <i class="fas fa-lightbulb me-1"></i>
                        <span id="hint-text">Chọn đáp án đúng nhất</span>
                    </small>
                </div>
            </div>

            <!-- Footer với nút điều khiển -->
            <div class="p-4 bg-light border-top">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted" id="question-timer-info">
                            <i class="fas fa-info-circle me-1"></i>
                            Thời gian còn lại: <span id="time-left">30</span>s
                        </small>
                    </div>
                    <div class="d-flex gap-2">
                        <button onclick="skipQuestion()" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-forward me-1"></i> Bỏ qua
                        </button>
                        <button onclick="resetGame()" class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-stop me-1"></i> Dừng cuộc chơi
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Loading screen -->
        <div id="loading-screen" class="text-center py-5" style="display: none;">
            <div class="loading-dots mx-auto mb-4">
                <div></div>
                <div></div>
                <div></div>
                <div></div>
            </div>
            <h4 class="text-primary" id="loading-text">Đang tải câu hỏi tiếp theo...</h4>
        </div>
    </div>

    <!-- ================= RESULT SCREEN ================= -->
    <div id="result-screen" style="display: none;">
        <div class="result-card">
            <i class="fas fa-trophy result-icon" style="color: var(--warning-color);"></i>

            <h2 class="mb-3">🎉 CHÚC MỪNG! 🎉</h2>
            <p class="lead mb-4">Bạn đã hoàn thành bài thi!</p>

            <div class="score-circle">
                <div class="score-percent" id="score-percent">0%</div>
                <div class="score-label">ĐIỂM SỐ</div>
            </div>

            <div class="stats-grid">
                <div class="stat-box stat-correct">
                    <div class="stat-number" id="correct-count">0</div>
                    <div class="stat-label">Câu đúng</div>
                </div>
                <div class="stat-box stat-wrong">
                    <div class="stat-number" id="wrong-count">0</div>
                    <div class="stat-label">Câu sai</div>
                </div>
                <div class="stat-box stat-skipped">
                    <div class="stat-number" id="skipped-count">0</div>
                    <div class="stat-label">Câu bỏ qua</div>
                </div>
                <div class="stat-box">
                    <div class="stat-number" id="total-score">0</div>
                    <div class="stat-label">Tổng điểm</div>
                </div>
            </div>

            <div class="mt-4">
                <h5>📊 Thống kê chi tiết:</h5>
                <div class="table-responsive mt-3">
                    <table class="table table-hover" id="result-table">
                        <thead>
                            <tr>
                                <th>Câu</th>
                                <th>Câu hỏi</th>
                                <th>Đáp án của bạn</th>
                                <th>Đáp án đúng</th>
                                <th>Kết quả</th>
                            </tr>
                        </thead>
                        <tbody id="result-details">
                            <!-- Kết quả chi tiết sẽ được thêm vào đây -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="action-buttons mt-5">
                <button onclick="reviewWrongAnswers()" class="btn btn-review action-btn">
                    <i class="fas fa-book me-2"></i> Ôn tập câu sai
                </button>
                <button onclick="viewLeaderboard()" class="btn btn-leaderboard action-btn">
                    <i class="fas fa-chart-bar me-2"></i> Xem bảng xếp hạng
                </button>
                <button onclick="playAgain()" class="btn btn-play-again action-btn">
                    <i class="fas fa-redo me-2"></i> Chơi lại
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Biến toàn cục
        let currentAttemptId = 0;
        let currentQuestionId = 0;
        let currentQuestionIndex = 1;
        let totalQuestions = 10;
        let timer = null;
        let countdownTime = 30;
        let isLoading = false;
        let gameResults = [];
        let wrongAnswers = [];

        // Ánh xạ độ khó -> số câu hỏi
        const difficultyMap = {
            1: 10,
            2: 15,
            3: 20
        };

        // ================= INITIALIZE =================
        $(document).ready(function() {
            $('#btnStartGame').on('click', startGame);
        });

        // ================= START GAME =================
        async function startGame() {
            const doKhoID = $('#doKhoSelect').val();
            totalQuestions = difficultyMap[doKhoID] || 10;

            // Reset game data
            gameResults = [];
            wrongAnswers = [];
            currentQuestionIndex = 1;

            const options = {
                ChuDeID: $('#chuDeSelect').val(),
                DoKhoID: doKhoID,
                SoLuongCauHoi: totalQuestions
            };

            // Hiệu ứng chuyển màn hình
            $('#start-screen').fadeOut(300, () => {
                $('#play-screen').fadeIn(300);
            });

            $('#question-counter').text(`Câu ${currentQuestionIndex}/${totalQuestions}`);
            $('#progress-bar').css('width', `${(currentQuestionIndex / totalQuestions) * 100}%`);

            // Hiển thị loading
            showLoading('Đang khởi tạo trò chơi...');

            try {
                const res = await $.ajax({
                    url: '@Url.Action("StartGame", "Play", new { area = "Quiz" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(options),
                    dataType: 'json'
                });

                if (!res || !res.attemptID) {
                    throw new Error('Không nhận được AttemptID từ server');
                }

                currentAttemptId = res.attemptID;
                $('#attempt-id').text(currentAttemptId);

                if (!res.question) {
                    throw new Error('Không nhận được câu hỏi đầu tiên');
                }

                hideLoading();
                startTimer();
                renderQuestion(res.question);

            } catch (error) {
                hideLoading();
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: error.responseText || 'Không thể bắt đầu trò chơi',
                    confirmButtonText: 'Thử lại',
                    confirmButtonColor: '#ef233c'
                }).then(() => resetGame());
            }
        }

        // ================= RENDER QUESTION =================
        function renderQuestion(q) {
            if (!q) return;

            const qId = q.CauHoiID || q.cauHoiID;
            const content = q.NoiDung || q.noiDung;
            const hint = q.GoiY || q.goiY || "Chọn đáp án đúng nhất";

            const answers = [
                { id: 'A', text: q.DapAnA || q.dapAnA || "Đáp án A" },
                { id: 'B', text: q.DapAnB || q.dapAnB || "Đáp án B" },
                { id: 'C', text: q.DapAnC || q.dapAnC || "Đáp án C" },
                { id: 'D', text: q.DapAnD || q.dapAnD || "Đáp án D" }
            ];

            currentQuestionId = qId;
            $('#question-text').text(content || "Câu hỏi đang được tải...");
            $('#hint-text').text(hint);
            $('#question-counter').text(`Câu ${currentQuestionIndex}/${totalQuestions}`);
            $('#progress-bar').css('width', `${(currentQuestionIndex / totalQuestions) * 100}%`);

            // Reset và start timer
            resetTimer();
            startTimer();

            // Render answers
            $('#answers-area').empty();

            answers.forEach((answer) => {
                if (!answer.text) return;

                const answerHtml = `
                    <div class="col-md-6 mb-3">
                        <button onclick="submitAnswer('${answer.id}')"
                                class="answer-btn"
                                data-answer="${answer.id}">
                            <span class="answer-label">${answer.id}</span>
                            ${answer.text}
                        </button>
                    </div>`;
                $('#answers-area').append(answerHtml);
            });

            // Bật lại các nút đáp án
            $('#answers-area button').prop('disabled', false);
            $('#answers-area button').removeClass('correct wrong');
        }

        // ================= SUBMIT ANSWER =================
        async function submitAnswer(selectedAnswer) {
            if (isLoading) return;

            // Dừng timer
            stopTimer();

            // Vô hiệu hóa tất cả nút
            $('#answers-area button').prop('disabled', true);

            // Hiệu ứng chọn đáp án
            const selectedBtn = $(`[data-answer="${selectedAnswer}"]`);
            selectedBtn.css({
                'background': 'var(--primary-color)',
                'color': 'white',
                'border-color': 'var(--primary-color)'
            });

            // Hiển thị loading
            showLoading('Đang kiểm tra đáp án...');

            try {
                const response = await $.ajax({
                    url: '@Url.Action("SubmitAnswer", "Play", new { area = "Quiz" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        QuizAttemptID: currentAttemptId,
                        CauHoiID: currentQuestionId,
                        DapAnDaChon: selectedAnswer
                    }),
                    dataType: 'json'
                });

                // Lưu kết quả
                const questionText = $('#question-text').text();
                const isCorrect = response?.isCorrect || false;
                const correctAnswer = response?.correctAnswer || '';

                const result = {
                    questionNumber: currentQuestionIndex,
                    question: questionText,
                    userAnswer: selectedAnswer,
                    correctAnswer: correctAnswer,
                    isCorrect: isCorrect,
                    questionId: currentQuestionId
                };

                gameResults.push(result);

                // Nếu sai, lưu vào danh sách câu sai để ôn tập
                if (!isCorrect) {
                    wrongAnswers.push(result);
                }

                // Xử lý kết quả nếu có
                if (response && response.isCorrect !== undefined) {
                    const correctAnswer = response.correctAnswer;
                    // Highlight đáp án đúng/sai
                    $('#answers-area button').each(function() {
                        const btn = $(this);
                        const answer = btn.data('answer');
                        if (answer === correctAnswer) {
                            btn.addClass('correct');
                        } else if (answer === selectedAnswer && answer !== correctAnswer) {
                            btn.addClass('wrong');
                        }
                    });

                    // Hiển thị thông báo kết quả
                    await showResultNotification(isCorrect, correctAnswer);
                }

                hideLoading();

                // Tăng số thứ tự câu hỏi
                currentQuestionIndex++;

                // Load câu hỏi tiếp theo sau 1.5 giây
                setTimeout(() => {
                    loadNextQuestion();
                }, 1500);

            } catch (error) {
                hideLoading();

                // Lưu kết quả với trạng thái lỗi
                const result = {
                    questionNumber: currentQuestionIndex,
                    question: $('#question-text').text(),
                    userAnswer: selectedAnswer,
                    correctAnswer: '',
                    isCorrect: false,
                    error: true
                };
                gameResults.push(result);

                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Không thể nộp đáp án',
                    confirmButtonText: 'OK'
                }).then(() => {
                    currentQuestionIndex++;
                    loadNextQuestion();
                });
            }
        }

        // ================= LOAD NEXT QUESTION =================
        async function loadNextQuestion() {
            // Kiểm tra xem đã hết câu hỏi chưa
            if (currentQuestionIndex > totalQuestions) {
                await showFinalResults();
                return;
            }

            if (isLoading) return;
            isLoading = true;

            showLoading('Đang tải câu hỏi tiếp theo...');

            try {
                const res = await $.ajax({
                    url: '@Url.Action("NextQuestion", "Play", new { area = "Quiz" })',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ attemptId: currentAttemptId }),
                    dataType: 'json'
                });

                if (res && res.isFinished === true) {
                    await showFinalResults();
                    return;
                }

                if (!res) {
                    throw new Error('Không nhận được câu hỏi');
                }

                hideLoading();
                renderQuestion(res);
                isLoading = false;

            } catch (error) {
                hideLoading();
                isLoading = false;

                // Nếu có lỗi, chuyển sang kết quả
                if (currentQuestionIndex >= totalQuestions) {
                    await showFinalResults();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: 'Không thể tải câu hỏi tiếp theo',
                        confirmButtonText: 'Thử lại'
                    }).then(() => loadNextQuestion());
                }
            }
        }

        // ================= SHOW FINAL RESULTS =================
        async function showFinalResults() {
            stopTimer();

            // Tính toán kết quả
            const correctCount = gameResults.filter(r => r.isCorrect).length;
            const wrongCount = gameResults.filter(r => !r.isCorrect && !r.skipped).length;
            const skippedCount = gameResults.filter(r => r.skipped).length;
            const scorePercent = Math.round((correctCount / totalQuestions) * 100);
            const totalScore = correctCount * 10; // Mỗi câu đúng 10 điểm

            // Hiển thị màn hình kết quả
            $('#play-screen').fadeOut(300, () => {
                $('#result-screen').fadeIn(300);
            });

            // Cập nhật thông tin kết quả
            $('#score-percent').text(scorePercent + '%');
            $('#correct-count').text(correctCount);
            $('#wrong-count').text(wrongCount);
            $('#skipped-count').text(skippedCount);
            $('#total-score').text(totalScore);

            // Hiển thị chi tiết kết quả
            displayResultDetails();
        }

        // ================= DISPLAY RESULT DETAILS =================
        function displayResultDetails() {
            const tbody = $('#result-details');
            tbody.empty();

            gameResults.forEach((result, index) => {
                const statusClass = result.isCorrect ? 'text-success' : 'text-danger';
                const statusIcon = result.isCorrect ? '✓' : '✗';
                const statusText = result.isCorrect ? 'Đúng' : 'Sai';

                const row = `
                    <tr>
                        <td><strong>Câu ${result.questionNumber}</strong></td>
                        <td>${result.question.substring(0, 50)}...</td>
                        <td>${result.userAnswer || 'Chưa trả lời'}</td>
                        <td>${result.correctAnswer || 'N/A'}</td>
                        <td class="${statusClass}"><strong>${statusIcon} ${statusText}</strong></td>
                    </tr>
                `;
                tbody.append(row);
            });
        }

        // ================= REVIEW WRONG ANSWERS =================
        function reviewWrongAnswers() {
            if (wrongAnswers.length === 0) {
                Swal.fire({
                    icon: 'info',
                    title: 'Không có câu sai!',
                    text: 'Bạn đã trả lời đúng tất cả các câu hỏi.',
                    confirmButtonText: 'OK'
                });
                return;
            }

            // Tạo nội dung ôn tập
            let reviewContent = `<div class="review-content"><h5>📚 Ôn tập ${wrongAnswers.length} câu sai:</h5>`;

            wrongAnswers.forEach((item, index) => {
                reviewContent += `
                    <div class="review-item mb-4 p-3 border rounded" style="background: #f8f9fa;">
                        <h6><strong>Câu ${item.questionNumber}:</strong> ${item.question}</h6>
                        <p><strong>Đáp án của bạn:</strong> <span class="text-danger">${item.userAnswer}</span></p>
                        <p><strong>Đáp án đúng:</strong> <span class="text-success">${item.correctAnswer}</span></p>
                        <p><strong>Giải thích:</strong> <em>Nội dung giải thích sẽ được cập nhật...</em></p>
                    </div>
                `;
            });

            reviewContent += '</div>';

            Swal.fire({
                title: 'Ôn tập câu sai',
                html: reviewContent,
                width: '800px',
                showCancelButton: true,
                confirmButtonText: 'Học lại bài này',
                cancelButtonText: 'Đóng',
                confirmButtonColor: '#4361ee'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Có thể chuyển đến trang học tập chuyên sâu
                    Swal.fire({
                        icon: 'info',
                        title: 'Tính năng đang phát triển',
                        text: 'Chức năng học tập chuyên sâu sẽ sớm được cập nhật!',
                        confirmButtonText: 'OK'
                    });
                }
            });
        }

        // ================= VIEW LEADERBOARD =================
        function viewLeaderboard() {
            window.location.href = '@Url.Action("Leaderboard", "Play", new { area = "Quiz" })';
        }

        // ================= PLAY AGAIN =================
        function playAgain() {
            $('#result-screen').fadeOut(300, () => {
                $('#start-screen').fadeIn(300);
                resetGame();
            });
        }

        // ================= TIMER FUNCTIONS =================
        function startTimer() {
            countdownTime = 30;
            updateTimerDisplay();

            timer = setInterval(() => {
                countdownTime--;
                updateTimerDisplay();

                if (countdownTime <= 10) {
                    $('#timer-container').addClass('timer-danger');
                }

                if (countdownTime <= 0) {
                    stopTimer();
                    autoSubmit();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            $('#countdown').text(countdownTime);
            $('#time-left').text(countdownTime);
        }

        function stopTimer() {
            if (timer) {
                clearInterval(timer);
                timer = null;
            }
        }

        function resetTimer() {
            stopTimer();
            $('#timer-container').removeClass('timer-danger');
            countdownTime = 30;
            updateTimerDisplay();
        }

        async function autoSubmit() {
            if ($('#answers-area button').prop('disabled')) return;

            // Đánh dấu là bỏ qua
            const result = {
                questionNumber: currentQuestionIndex,
                question: $('#question-text').text(),
                userAnswer: '',
                correctAnswer: '',
                isCorrect: false,
                skipped: true
            };
            gameResults.push(result);

            // Chuyển câu tiếp theo
            currentQuestionIndex++;
            loadNextQuestion();
        }

        // ================= UTILITY FUNCTIONS =================
        function showLoading(text) {
            $('#loading-text').text(text);
            $('#loading-screen').show();
            $('.question-card').css('opacity', '0.3');
        }

        function hideLoading() {
            $('#loading-screen').hide();
            $('.question-card').css('opacity', '1');
        }

        async function showResultNotification(isCorrect, correctAnswer) {
            return Swal.fire({
                icon: isCorrect ? 'success' : 'error',
                title: isCorrect ? 'Chính xác! 🎉' : 'Chưa đúng!',
                text: isCorrect ? 'Bạn đã trả lời đúng!' : `Đáp án đúng là: ${correctAnswer}`,
                timer: 1500,
                showConfirmButton: false,
                background: isCorrect ? '#d4edda' : '#f8d7da',
                color: isCorrect ? '#155724' : '#721c24'
            });
        }

        function skipQuestion() {
            Swal.fire({
                title: 'Bỏ qua câu hỏi?',
                text: 'Bạn sẽ không được điểm cho câu hỏi này',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Bỏ qua',
                cancelButtonText: 'Tiếp tục'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Lưu kết quả bỏ qua
                    const resultData = {
                        questionNumber: currentQuestionIndex,
                        question: $('#question-text').text(),
                        userAnswer: '',
                        correctAnswer: '',
                        isCorrect: false,
                        skipped: true
                    };
                    gameResults.push(resultData);

                    currentQuestionIndex++;
                    loadNextQuestion();
                }
            });
        }

        function resetGame() {
            stopTimer();
            currentQuestionIndex = 1;
            currentAttemptId = 0;
            currentQuestionId = 0;
            isLoading = false;
            gameResults = [];
            wrongAnswers = [];
        }
    </script>
}