@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        // Toggle password visibility
        function togglePasswordVisibility() {
            var passwordField = document.getElementById('passwordField');
            var toggleIcon = document.querySelector('.toggle-password i');

            if (passwordField.type === 'password') {
                passwordField.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passwordField.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        // Fill demo account credentials
        function fillDemo(username, password) {
            $('#UserName').val(username);
            $('#Password').val(password);
            $('#UserName').focus();

            // Show success message
            showToast('Đã điền thông tin đăng nhập demo', 'success');
        }

        // Form submission with loading state
        $(document).ready(function () {
            $('#loginForm').submit(function (e) {
                var submitBtn = $('#submitBtn');
                var btnText = $('.btn-text');
                var btnLoader = $('.btn-loader');

                // Show loading state
                submitBtn.addClass('loading').prop('disabled', true);
                btnText.hide();
                btnLoader.show();

                // Allow form to submit normally
            });

            // Add focus effects
            $('.form-input').on('focus', function () {
                $(this).parent().addClass('focused');
            }).on('blur', function () {
                $(this).parent().removeClass('focused');
            });

            // Auto-focus username field
            if ($('#UserName').val() === '') {
                $('#UserName').focus();
            }

            // Handle checkbox custom styling
            $('.checkbox-custom input').change(function () {
                $(this).closest('.checkbox-custom').toggleClass('checked', this.checked);
            });
        });

        // Show toast notification
        function showToast(message, type) {
            type = type || 'info';

            // Remove existing toast
            $('.toast').remove();

            var icon = type === 'success' ? 'check-circle' :
                type === 'error' ? 'exclamation-triangle' : 'info-circle';

            var toast = $('<div class="toast toast-' + type + '">' +
                '<i class="fas fa-' + icon + '"></i>' +
                '<span>' + message + '</span>' +
                '</div>');

            $('body').append(toast);

            // Auto remove after 3 seconds
            setTimeout(function () {
                toast.fadeOut(500, function () {
                    $(this).remove();
                });
            }, 3000);
        }

        // Social login handlers
        $('.google-btn').click(function () {
            showToast('Tính năng đang được phát triển', 'info');
        });

        $('.facebook-btn').click(function () {
            showToast('Tính năng đang được phát triển', 'info');
        });
    </script>
}