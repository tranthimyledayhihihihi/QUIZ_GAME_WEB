@{
    ViewBag.Title = "Tạo Phòng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="doi-khang-wrapper">
    <div class="doi-khang-container">
        <div class="header">
            <h1>➕ Tạo Phòng Đối Kháng</h1>
        </div>

        <div class="status-box">
            <div class="hourglass-icon">🏠</div>
            <h2 id="statusText">Đang kết nối...</h2>
        </div>

        <!-- Form tạo phòng -->
        <div class="create-room-form">
            <button id="btnCreateRoom" class="btn btn-success btn-lg">
                ➕ Tạo Phòng Ngay
            </button>

            <div id="roomCodeDisplay" class="room-code"></div>
            <p class="help-text">Chia sẻ mã phòng cho bạn bè để tham gia!</p>
        </div>

        <a href="@Url.Action("Index", "DoiKhang")" class="btn btn-secondary btn-sm">
            ← Quay lại
        </a>
    </div>
</div>

<style>
    /* Copy style từ Index.cshtml */
    body {
        overflow: hidden;
    }

    .doi-khang-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        overflow-y: auto;
        background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
        padding-top: 80px;
        padding-bottom: 20px;
    }

    .doi-khang-container {
        max-width: 600px;
        margin: 0 auto;
        text-align: center;
        padding: 20px;
    }

    .header h1 {
        color: white;
        margin-bottom: 30px;
        font-size: clamp(24px, 6vw, 36px);
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .status-box {
        background: rgba(255, 255, 255, 0.95);
        color: #2c3e50;
        padding: 30px 20px;
        border-radius: 15px;
        margin-bottom: 20px;
        min-height: 160px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .hourglass-icon {
        font-size: clamp(40px, 10vw, 60px);
        margin-bottom: 10px;
    }

    #statusText {
        font-size: clamp(18px, 4vw, 24px);
        margin: 10px 0;
    }

    .create-room-form {
        background: rgba(255, 255, 255, 0.95);
        padding: 30px 20px;
        border-radius: 15px;
        margin-bottom: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .btn {
        padding: 14px 30px;
        font-size: clamp(14px, 3.5vw, 18px);
        border-radius: 10px;
        margin: 8px;
        font-weight: bold;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        width: 90%;
        max-width: 350px;
        display: inline-block;
        text-decoration: none;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.2);
        }

    .btn-success {
        background: #27ae60;
        color: #fff;
    }

    .btn-secondary {
        background: #95a5a6;
        color: #fff;
        max-width: 200px;
        font-size: 14px;
    }

    .room-code {
        margin-top: 20px;
        font-size: clamp(20px, 5vw, 28px);
        font-weight: bold;
        color: #27ae60;
        background: rgba(39, 174, 96, 0.1);
        padding: 15px;
        border-radius: 10px;
        min-height: 50px;
        letter-spacing: 3px;
    }

    .help-text {
        margin-top: 10px;
        color: #7f8c8d;
        font-size: 14px;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    let ws;

    function getToken() {
        return '@Html.Raw(Session["JWT_TOKEN"])';
    }

    function connectWebSocket() {
        const token = getToken();
        if (!token) {
            $('#statusText').text('❌ Chưa đăng nhập');
            return;
        }

        ws = new WebSocket('wss://localhost:7092/ws/game?access_token=' + encodeURIComponent(token));

        ws.onopen = function () {
            $('#statusText').text('✅ Sẵn sàng tạo phòng!');
        };

        ws.onmessage = function (event) {
            const data = JSON.parse(event.data);

            if (data.Type === 'ROOM_CREATED') {
                $('#roomCodeDisplay').text('Mã phòng: ' + data.Data.roomCode);
                $('#statusText').text('✅ Phòng đã được tạo!');
                $('#btnCreateRoom').prop('disabled', true).text('✅ Đã tạo phòng');
            } else if (data.Type === 'MATCH_FOUND') {
                $('#statusText').text('🎮 Đối thủ đã vào phòng!');
                setTimeout(() => {
                    window.location.href = '/Quiz/DoiKhang/Match?code=' + data.Data.matchCode;
                }, 1500);
            } else if (data.Type === 'ERROR') {
                $('#statusText').text('❌ ' + data.Data.message);
            }
        };

        ws.onerror = function() {
            $('#statusText').text('❌ Lỗi kết nối');
        };

        ws.onclose = function() {
            $('#statusText').text('🔌 Mất kết nối');
        };
    }

    $('#btnCreateRoom').click(function () {
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ Type: 'CREATE_ROOM' }));
            $('#statusText').text('⏳ Đang tạo phòng...');
        } else {
            $('#statusText').text('❌ Chưa kết nối WebSocket');
        }
    });

    $(document).ready(function () {
        connectWebSocket();
    });

    $(window).on('beforeunload', function() {
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.close();
        }
    });
</script>