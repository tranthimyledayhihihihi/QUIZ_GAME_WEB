﻿@{
    ViewBag.Title = "Tham Gia Phòng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="doi-khang-wrapper">
    <div class="doi-khang-container">
        <div class="header">
            <h1>🔑 Tham Gia Phòng</h1>
        </div>

        <div class="status-box">
            <div class="hourglass-icon">🎮</div>
            <h2 id="statusText">Đang kết nối...</h2>
        </div>

        <!-- Form join phòng -->
        <div class="join-room-form">
            <input id="roomCodeInput"
                   class="form-control room-input"
                   placeholder="Nhập mã phòng (VD: ABC123)"
                   value="@ViewBag.RoomCode"
                   maxlength="10" />

            <button id="btnJoinRoom" class="btn btn-warning btn-lg">
                🔑 Tham Gia Ngay
            </button>

            <p class="help-text">Nhập mã phòng mà bạn bè đã chia sẻ</p>
        </div>

        <a href="@Url.Action("Index", "DoiKhang")" class="btn btn-secondary btn-sm">
            ← Quay lại
        </a>
    </div>
</div>

<style>
    body {
        overflow: hidden;
    }

    .doi-khang-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        overflow-y: auto;
        background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
        padding-top: 80px;
        padding-bottom: 20px;
    }

    .doi-khang-container {
        max-width: 600px;
        margin: 0 auto;
        text-align: center;
        padding: 20px;
    }

    .header h1 {
        color: white;
        margin-bottom: 30px;
        font-size: clamp(24px, 6vw, 36px);
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .status-box {
        background: rgba(255, 255, 255, 0.95);
        color: #2c3e50;
        padding: 30px 20px;
        border-radius: 15px;
        margin-bottom: 20px;
        min-height: 160px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .hourglass-icon {
        font-size: clamp(40px, 10vw, 60px);
        margin-bottom: 10px;
    }

    #statusText {
        font-size: clamp(18px, 4vw, 24px);
        margin: 10px 0;
    }

    .join-room-form {
        background: rgba(255, 255, 255, 0.95);
        padding: 30px 20px;
        border-radius: 15px;
        margin-bottom: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
    }

    .room-input {
        padding: 16px;
        font-size: clamp(16px, 4vw, 20px);
        margin-bottom: 15px;
        border-radius: 10px;
        border: 3px solid #f39c12;
        width: 90%;
        max-width: 350px;
        text-align: center;
        text-transform: uppercase;
        font-weight: bold;
        letter-spacing: 2px;
    }

        .room-input:focus {
            outline: none;
            border-color: #e67e22;
            box-shadow: 0 0 10px rgba(243, 156, 18, 0.3);
        }

    .btn {
        padding: 14px 30px;
        font-size: clamp(14px, 3.5vw, 18px);
        border-radius: 10px;
        margin: 8px;
        font-weight: bold;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        width: 90%;
        max-width: 350px;
        display: inline-block;
        text-decoration: none;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(0,0,0,0.2);
        }

    .btn-warning {
        background: #f39c12;
        color: #fff;
    }

    .btn-secondary {
        background: #95a5a6;
        color: #fff;
        max-width: 200px;
        font-size: 14px;
    }

    .help-text {
        margin-top: 10px;
        color: #7f8c8d;
        font-size: 14px;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    let ws;

    function getToken() {
        return '@Html.Raw(Session["JWT_TOKEN"])';
    }

    function connectWebSocket() {
        const token = getToken();
        if (!token) {
            $('#statusText').text('❌ Chưa đăng nhập');
            return;
        }

        ws = new WebSocket('wss://localhost:7092/ws/game?access_token=' + encodeURIComponent(token));

        ws.onopen = function () {
            $('#statusText').text('✅ Sẵn sàng vào phòng!');
        };

        ws.onmessage = function (event) {
            const data = JSON.parse(event.data);

            if (data.Type === 'MATCH_FOUND') {
                $('#statusText').text('🎮 Đã vào phòng thành công!');
                setTimeout(() => {
                    window.location.href = '/Quiz/DoiKhang/Match?code=' + data.Data.matchCode;
                }, 1500);
            } else if (data.Type === 'ERROR') {
                $('#statusText').text('❌ ' + data.Data.message);
                setTimeout(() => {
                    $('#statusText').text('✅ Sẵn sàng vào phòng!');
                }, 3000);
            }
        };

        ws.onerror = function() {
            $('#statusText').text('❌ Lỗi kết nối');
        };

        ws.onclose = function() {
            $('#statusText').text('🔌 Mất kết nối');
        };
    }

    $('#btnJoinRoom').click(function () {
        const code = $('#roomCodeInput').val().trim().toUpperCase();
        if (!code) {
            alert('⚠️ Vui lòng nhập mã phòng!');
            return;
        }
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({ Type: 'JOIN_ROOM_CODE', Data: { roomCode: code } }));
            $('#statusText').text('⏳ Đang vào phòng...');
        } else {
            $('#statusText').text('❌ Chưa kết nối WebSocket');
        }
    });

    // Auto uppercase khi nhập
    $('#roomCodeInput').on('input', function() {
        this.value = this.value.toUpperCase();
    });

    $(document).ready(function () {
        connectWebSocket();
    });

    $(window).on('beforeunload', function() {
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.close();
        }
    });
</script>