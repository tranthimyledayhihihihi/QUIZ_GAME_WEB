@{
    ViewBag.Title = "Smash Quiz";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Sidebar Trái -->
<div class="left-sidebar">
    <a href="@Url.Action("Index", "Gift")" class="feature-card card-gift">
        <span>Thưởng Ngày</span>
        <i class="fa-solid fa-gift"></i>
    </a>

    <a href="@Url.Action("Leaderboard", "Menu")" class="feature-card card-rank">
    <span>Xếp Hạng</span>
    <i class="fa-solid fa-trophy"></i>
</a>

    <a href="@Url.Action("Index", "DailyStreak")" class="feature-card card-streak">
        <span>Chuỗi Ngày</span>
        <i class="fa-solid fa-fire"></i>
    </a>

    <a href="@Url.Action("Index", "DoiKhang")" class="feature-card card-pvp">
        <span>Đối Kháng</span>
        <i class="fa-solid fa-swords"></i>
    </a>

    <a href="@Url.Action("Index", "Play")" class="feature-card card-arena">
        <span>Đấu Trường</span>
        <i class="fa-solid fa-skull"></i>
    </a>
    <a href="@Url.Action("Create", "CustomQuiz")" class="feature-card card-custom">
        <span>Tạo Quiz</span>
        <i class="fa-solid fa-pen-nib"></i>
    </a>
</div>

<!-- Màn hình chính -->
<div class="game-container">
    <img src="https://cdn-icons-png.flaticon.com/512/3253/3253220.png"
         alt="Kart"
         class="center-illustration" />

    <div class="buttons-wrapper">

        <!-- Nút PLAY - KHÔNG CÒN LỒNG BUTTON TRONG A -->
        <a href="@Url.Action("Index", "Play")"
           class="btn-play-big d-inline-block text-decoration-none text-center">
            <i class="fa-solid fa-play me-3"></i> PLAY
        </a>

        <!-- Nút Create / Join -->
        <div class="sub-buttons">
            <a href="@Url.Action("Create", "DoiKhang")"
               class="btn-action-3d text-decoration-none d-inline-block text-center">
                Create
            </a>

            <a href="@Url.Action("Join", "DoiKhang")"
               class="btn-action-3d text-decoration-none d-inline-block text-center">
                Join
            </a>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card-custom {
            background-color: #7048e8 !important; /* Màu Tím đậm cho chất */
            border-bottom: 6px solid #5f3dc4 !important; /* Tạo hiệu ứng 3D dày ở dưới */
            color: white !important;
        }
            /* Hiệu ứng khi di chuột qua */
            .card-custom:hover {
                background-color: #7950f2 !important;
                transform: translateY(-2px);
            }
            /* Hiệu ứng khi nhấn vào (lún xuống) */
            .card-custom:active {
                transform: translateY(4px);
                border-bottom-width: 2px !important;
            }
    </style>
}
