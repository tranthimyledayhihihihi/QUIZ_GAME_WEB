@model WEBB.Models.Admin.ProfileDto

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="h3 mb-4 text-primary">
        <i class="fas fa-user-circle me-2"></i>Hồ sơ cá nhân
    </h1>

    @if (Model == null)
    {
        <div class="alert alert-danger">Không tải được dữ liệu hồ sơ.</div>
        return;
    }

    <div class="card shadow">
        <div class="card-body">
            <form method="post" action="@Url.Action("Update","Profile")">

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label>Tên đăng nhập</label>
                        <input class="form-control" name="TenDangNhap"
                               value="@Model.TenDangNhap" readonly />
                    </div>
                    <div class="col-md-6">
                        <label>Vai trò</label>
                        <input class="form-control" value="@Model.VaiTro" readonly />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label>Email</label>
                        <input class="form-control" name="Email"
                               value="@Model.Email" required />
                    </div>
                    <div class="col-md-6">
                        <label>Họ tên</label>
                        <input class="form-control" name="HoTen"
                               value="@Model.HoTen" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label>Ngày đăng ký</label>
                        <input class="form-control"
                               value="@Model.NgayDangKy.ToString("dd/MM/yyyy")"
                               readonly />
                    </div>
                    <div class="col-md-6">
                        <label>Lần đăng nhập cuối</label>
                        <input class="form-control"
                               value="@(Model.LanDangNhapCuoi?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")"
                               readonly />
                    </div>
                </div>

                <div class="text-end">
                    <button class="btn btn-primary">
                        <i class="fas fa-save me-1"></i>Cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
