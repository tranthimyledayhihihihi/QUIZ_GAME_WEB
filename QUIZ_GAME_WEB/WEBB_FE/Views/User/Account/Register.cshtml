        }

        /* Testimonial */
        .testimonial {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 24px;
            backdrop-filter: blur(10px);
            margin-top: 40px;
        }

        .testimonial-text {
            font-style: italic;
            font-size: 15px;
            line-height: 1.6;
            margin-bottom: 12px;
        }

        .testimonial-author {
