</style>

<!-- JavaScript -->
@section scripts {
    <script>
        $(document).ready(function () {
            // Khởi tạo tooltip
            $('[data-bs-toggle="tooltip"]').tooltip();

            // Cập nhật thời gian thực
            function updateCurrentTime() {
                const now = new Date();
                const timeString = now.toLocaleTimeString('vi-VN', {
                    hour: '2-digit',
                    minute: '2-digit'
                });
                const dateString = now.toLocaleDateString('vi-VN');
                $('.current-time').text(`${timeString} ${dateString}`);
            }

            // Cập nhật mỗi giây
            setInterval(updateCurrentTime, 1000);

            // Hiệu ứng cho nút nhận thưởng
            $('form button[type="submit"]').hover(
                function () {
                    $(this).css({
                        'transform': 'scale(1.05)',
                        'box-shadow': '0 10px 25px rgba(17, 153, 142, 0.4)'
                    });
                },
                function () {
                    $(this).css({
                        'transform': 'scale(1)',
                        'box-shadow': '0 8px 20px rgba(17, 153, 142, 0.3)'
                    });
                }
            );

            // Hiệu ứng scroll cho sidebar
            $(window).scroll(function () {
                const scrollTop = $(this).scrollTop();
                const sidebar = $('.sticky-top');

                if (scrollTop > 100) {
                    sidebar.css({
                        'top': '10px',
                        'transition': 'top 0.3s ease'
                    });
                } else {
                    sidebar.css({
                        'top': '20px',
                        'transition': 'top 0.3s ease'
                    });
                }
            });

            // Click vào reward item để xem chi tiết
            $('.reward-item').click(function () {
                const rewardDate = $(this).find('.fw-medium').first().text();
                const rewardPoints = $(this).find('.text-success').first().text();
                alert(`Thông tin phần thưởng:\nNgày: ${rewardDate}\n${rewardPoints}`);
            });

            // Smooth scroll cho các phần
            $('a[href^="#"]').click(function (e) {
                e.preventDefault();
                const target = $(this.hash);
                if (target.length) {
                    $('html, body').animate({
                        scrollTop: target.offset().top - 80
                    }, 800);
                }
            });
        });
    </script>
}