@model WEBB.Models.User.LoginRequest

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Đăng nhập IQuiz";
}

<div class="auth-container">
    <!-- Left Panel - Background & Welcome -->
    <div class="auth-left-panel">
        <div class="overlay"></div>
        <div class="welcome-content">
            <div class="brand-logo">
                <i class="fas fa-brain"></i>
                <span>IQuiz</span>
            </div>
            <h1 class="welcome-title">Chào mừng trở lại!</h1>
            <p class="welcome-subtitle">
                Đăng nhập để tiếp tục khám phá thế giới tri thức và tham gia các thử thách hấp dẫn.
            </p>
            <div class="features-list">
                <div class="feature-item">
                    <i class="fas fa-gamepad"></i>
                    <span>1000+ câu đố thú vị</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-trophy"></i>
                    <span>Thi đấu với bạn bè</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-chart-line"></i>
                    <span>Theo dõi tiến độ học tập</span>
                </div>
            </div>

            <!-- Stats for returning users -->
            <div class="user-stats">
                <div class="stat-item">
                    <div class="stat-number">10,000+</div>
                    <div class="stat-label">Người dùng đã tham gia</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">95%</div>
                    <div class="stat-label">Người dùng hài lòng</div>
                </div>
            </div>

            <!-- Don't have account section on left panel -->
            <div class="left-register-section">
                <h4>Chưa có tài khoản?</h4>
                <p>Tham gia ngay để trải nghiệm đầy đủ tính năng</p>
                <a href="@Url.Action("Register", "Account")" class="register-cta-left">
                    <i class="fas fa-user-plus"></i>
                    Đăng ký miễn phí
                </a>
            </div>
        </div>
    </div>

    <!-- Right Panel - Login Form -->
    <div class="auth-right-panel">
        <div class="auth-form-container">
            <!-- Back to Home -->
            <a href="@Url.Action("Index", "Home")" class="back-home">
                <i class="fas fa-arrow-left"></i> Trang chủ
            </a>

            <!-- Logo Mobile -->
            <div class="mobile-logo">
                <i class="fas fa-brain"></i>
                <span>IQuiz</span>
            </div>

            <!-- Quick Register Button on Mobile -->
            <div class="mobile-register-cta">
                <span>Chưa có tài khoản?</span>
                <a href="@Url.Action("Register", "Account")" class="btn-register-mobile">
                    <i class="fas fa-user-plus"></i> Đăng ký
                </a>
            </div>

            <!-- Header -->
            <div class="form-header">
                <h2>Đăng nhập tài khoản</h2>
                <p class="form-subtitle">
                    Chào mừng bạn quay lại, hãy đăng nhập để tiếp tục.
                </p>
            </div>

            <!-- Success Message -->
            @if (TempData["RegisterSuccess"] != null)
            {
                <div class="alert alert-success-custom">
                    <i class="fas fa-check-circle"></i>
                    <div>
                        <strong>Đăng ký thành công!</strong>
                        <p class="mb-0">@TempData["RegisterSuccess"]</p>
                    </div>
                </div>
            }

            <!-- Error Message -->
            @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
            {
                <div class="alert alert-danger-custom">
                    <i class="fas fa-exclamation-triangle"></i>
                    <div>
                        <strong>Đăng nhập thất bại!</strong>
                        <p class="mb-0">@Model.ErrorMessage</p>
                    </div>
                </div>
            }

            <!-- Login Form -->
            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "login-form", id = "loginForm" }))
            {
                @Html.AntiForgeryToken()

                <!-- Username Field -->
                <div class="input-group-custom">
                    <label for="UserName" class="input-label">
                        <i class="fas fa-user"></i>
                        Tên đăng nhập
                    </label>
                    @Html.TextBoxFor(m => m.UserName, new
                    {
                        @class = "form-input",
                        placeholder = "Nhập tên đăng nhập...",
                        autocomplete = "username",
                        required = "required"
                    })
                    @Html.ValidationMessageFor(m => m.UserName, null, new { @class = "validation-error" })
                </div>

                <!-- Password Field -->
                <div class="input-group-custom">
                    <label for="Password" class="input-label">
                        <i class="fas fa-lock"></i>
                        Mật khẩu
                    </label>
                    <div class="password-input-wrapper">
                        @Html.PasswordFor(m => m.Password, new
                        {
                            @class = "form-input password-input",
                            placeholder = "Nhập mật khẩu...",
                            autocomplete = "current-password",
                            required = "required",
                            id = "passwordField"
                        })
                        <button type="button" class="toggle-password" onclick="togglePasswordVisibility()">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, null, new { @class = "validation-error" })
                </div>

                <!-- Remember Me & Forgot Password -->
                <div class="form-options">
                    <label class="checkbox-custom">
                        <input type="checkbox" id="rememberMe" name="RememberMe" value="true" />
                        <span class="checkmark"></span>
                        <span class="checkbox-text">Ghi nhớ đăng nhập</span>
                    </label>
                    <a href="@Url.Action("ForgotPassword", "Account")" class="forgot-password">
                        Quên mật khẩu?
                    </a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="submit-btn" id="submitBtn">
                    <span class="btn-text">Đăng nhập</span>
                    <span class="btn-loader" style="display: none;">
                        <i class="fas fa-spinner fa-spin"></i>
                    </span>
                </button>

                <!-- Quick Login Options -->
                <div class="quick-options">
                    <div class="demo-accounts">
                        <p class="demo-title">Đăng nhập nhanh với:</p>
                        <div class="demo-buttons">
                            <button type="button" class="demo-btn admin-btn" onclick="fillDemo('admin', 'admin123')">
                                <i class="fas fa-crown"></i> Admin
                            </button>
                            <button type="button" class="demo-btn user-btn" onclick="fillDemo('user', 'user123')">
                                <i class="fas fa-user"></i> User
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Divider -->
                <div class="divider">
                    <span>hoặc</span>
                </div>

                <!-- Social Login -->
                <div class="social-login">
                    <button type="button" class="social-btn google-btn">
                        <i class="fab fa-google"></i>
                        Tiếp tục với Google
                    </button>
                    <button type="button" class="social-btn facebook-btn">
                        <i class="fab fa-facebook-f"></i>
                        Tiếp tục với Facebook
                    </button>
                </div>
            }

            <!-- Register Section (Right Panel) -->
            <div class="register-section">
                <div class="register-card">
                    <div class="register-icon">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div class="register-content">
                        <h4>Chưa có tài khoản?</h4>
                        <p>Đăng ký ngay để trải nghiệm đầy đủ tính năng của IQuiz</p>
                        <a href="@Url.Action("Register", "Account")" class="register-action-btn">
                            <i class="fas fa-arrow-right"></i>
                            Tạo tài khoản mới
                        </a>
                    </div>
                </div>

                <!-- Benefits List -->
                <div class="benefits-list">
                    <h5>Lợi ích khi đăng ký:</h5>
                    <ul>
                        <li><i class="fas fa-check-circle"></i> Truy cập không giới hạn câu hỏi</li>
                        <li><i class="fas fa-check-circle"></i> Lưu kết quả và theo dõi tiến độ</li>
                        <li><i class="fas fa-check-circle"></i> Tham gia bảng xếp hạng</li>
                        <li><i class="fas fa-check-circle"></i> Nhận huy hiệu và thành tích</li>
                        <li><i class="fas fa-check-circle"></i> Tạo quiz riêng của bạn</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Reset & Base */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root {
        --primary-color: #4f46e5;
        --primary-hover: #4338ca;
        --secondary-color: #8b5cf6;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --warning-color: #f59e0b;
        --text-primary: #1f2937;
        --text-secondary: #6b7280;
        --bg-light: #f9fafb;
        --border-color: #e5e7eb;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.12);
        --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1);
        --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;
        --radius-full: 999px;
    }

    body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        margin: 0;
    }

    /* Main Container */
    .auth-container {
        display: flex;
        min-height: 100vh;
        background: white;
        border-radius: var(--radius-lg);
        overflow: hidden;
        margin: 24px;
        box-shadow: var(--shadow-lg);
    }

    /* Left Panel */
    .auth-left-panel {
        flex: 1;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 60px 40px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.3);
    }

    .welcome-content {
        position: relative;
        z-index: 2;
        max-width: 500px;
        margin: 0 auto;
    }

    .brand-logo {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 40px;
    }

        .brand-logo i {
            font-size: 32px;
        }

    .welcome-title {
        font-size: 42px;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 16px;
    }

    .welcome-subtitle {
        font-size: 18px;
        opacity: 0.9;
        margin-bottom: 40px;
        line-height: 1.6;
    }

    .features-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-bottom: 40px;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 16px;
    }

        .feature-item i {
            font-size: 18px;
            color: #c7d2fe;
        }

    .user-stats {
        display: flex;
        gap: 40px;
        margin: 40px 0;
        padding: 30px 0;
        border-top: 1px solid rgba(255,255,255,0.2);
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .stat-item {
        flex: 1;
        text-align: center;
    }

    .stat-number {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #c7d2fe;
    }

    .stat-label {
        font-size: 14px;
        opacity: 0.8;
    }

    .left-register-section {
        margin-top: 40px;
        padding: 30px;
        background: rgba(255,255,255,0.1);
        border-radius: var(--radius-md);
        text-align: center;
        backdrop-filter: blur(10px);
    }

        .left-register-section h4 {
            font-size: 20px;
            margin-bottom: 8px;
            color: white;
        }

        .left-register-section p {
            opacity: 0.9;
            margin-bottom: 20px;
            font-size: 14px;
        }

    .register-cta-left {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 24px;
        background: white;
        color: var(--primary-color);
        border-radius: var(--radius-full);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
    }

        .register-cta-left:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            background: var(--primary-color);
            color: white;
        }

    /* Right Panel */
    .auth-right-panel {
        flex: 1;
        background: white;
        padding: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow-y: auto;
    }

    .auth-form-container {
        width: 100%;
        max-width: 480px;
    }

    .back-home {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 14px;
        margin-bottom: 20px;
        transition: color 0.2s;
    }

        .back-home:hover {
            color: var(--primary-color);
        }

    .mobile-logo {
        display: none;
    }

    .mobile-register-cta {
        display: none;
        justify-content: space-between;
        align-items: center;
        background: var(--bg-light);
        padding: 15px 20px;
        border-radius: var(--radius-md);
        margin-bottom: 24px;
    }

        .mobile-register-cta span {
            color: var(--text-secondary);
            font-weight: 500;
        }

    .btn-register-mobile {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: var(--primary-color);
        color: white;
        border-radius: var(--radius-full);
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.2s;
    }

        .btn-register-mobile:hover {
            background: var(--primary-hover);
            transform: translateY(-1px);
        }

    .form-header {
        margin-bottom: 32px;
    }

        .form-header h2 {
            font-size: 32px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 8px;
        }

    .form-subtitle {
        color: var(--text-secondary);
        font-size: 16px;
    }

    /* Alerts */
    .alert {
        padding: 16px;
        border-radius: var(--radius-md);
        margin-bottom: 24px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
    }

    .alert-success-custom {
        background: #d1fae5;
        border: 1px solid #a7f3d0;
        color: #065f46;
    }

    .alert-danger-custom {
        background: #fee2e2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .alert i {
        font-size: 20px;
        margin-top: 2px;
    }

    /* Form Elements */
    .input-group-custom {
        margin-bottom: 24px;
    }

    .input-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 500;
        color: var(--text-primary);
        margin-bottom: 8px;
        font-size: 14px;
    }

        .input-label i {
            color: var(--primary-color);
            font-size: 14px;
        }

    .form-input {
        width: 100%;
        padding: 14px 16px;
        border: 2px solid var(--border-color);
        border-radius: var(--radius-md);
        font-size: 15px;
        transition: all 0.2s;
        background: white;
    }

        .form-input:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .form-input::placeholder {
            color: #9ca3af;
        }

    .password-input-wrapper {
        position: relative;
    }

    .toggle-password {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: var(--text-secondary);
        cursor: pointer;
        padding: 4px;
        font-size: 16px;
    }

        .toggle-password:hover {
            color: var(--primary-color);
        }

    .validation-error {
        color: var(--danger-color);
        font-size: 13px;
        margin-top: 4px;
        display: block;
    }

    /* Form Options */
    .form-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
    }

    .checkbox-custom {
        display: flex;
        align-items: center;
        cursor: pointer;
        position: relative;
    }

        .checkbox-custom input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
            width: 0;
            height: 0;
        }

    .checkmark {
        width: 20px;
        height: 20px;
        border: 2px solid var(--border-color);
        border-radius: 4px;
        margin-right: 10px;
        position: relative;
        transition: all 0.2s;
        flex-shrink: 0;
    }

    .checkbox-custom input:checked ~ .checkmark {
        background: var(--primary-color);
        border-color: var(--primary-color);
    }

    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
        left: 6px;
        top: 2px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .checkbox-custom input:checked ~ .checkmark:after {
        display: block;
    }

    .checkbox-text {
        color: var(--text-secondary);
        font-size: 14px;
        user-select: none;
    }

    .forgot-password {
        color: var(--primary-color);
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: color 0.2s;
    }

        .forgot-password:hover {
            color: var(--primary-hover);
            text-decoration: underline;
        }

    /* Submit Button */
    .submit-btn {
        width: 100%;
        padding: 16px;
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: var(--radius-md);
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 24px;
    }

        .submit-btn:hover {
            background: var(--primary-hover);
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
        }

        .submit-btn:active {
            transform: translateY(0);
        }

        .submit-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

    /* Quick Options */
    .quick-options {
        margin-bottom: 24px;
    }

    .demo-accounts {
        text-align: center;
    }

    .demo-title {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 12px;
        font-weight: 500;
    }

    .demo-buttons {
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .demo-btn {
        padding: 10px 20px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-full);
        background: white;
        color: var(--text-secondary);
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .demo-btn:hover {
            background: var(--bg-light);
            transform: translateY(-1px);
        }

        .demo-btn.admin-btn:hover {
            border-color: #f59e0b;
            color: #f59e0b;
        }

        .demo-btn.user-btn:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

    /* Divider */
    .divider {
        display: flex;
        align-items: center;
        margin: 32px 0;
        color: var(--text-secondary);
        font-size: 14px;
    }

        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            border-bottom: 1px solid var(--border-color);
        }

        .divider span {
            padding: 0 16px;
        }

    /* Social Login */
    .social-login {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 32px;
    }

    .social-btn {
        padding: 14px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        background: white;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

        .social-btn:hover {
            background: var(--bg-light);
            transform: translateY(-1px);
            box-shadow: var(--shadow-sm);
        }

        .social-btn.google-btn {
            color: #1f2937;
        }

        .social-btn.facebook-btn {
            color: #1877f2;
            border-color: #1877f2;
        }

            .social-btn.facebook-btn:hover {
                background: rgba(24, 119, 242, 0.05);
            }

    /* Register Section */
    .register-section {
        margin-top: 40px;
        padding-top: 40px;
        border-top: 1px solid var(--border-color);
    }

    .register-card {
        display: flex;
        align-items: center;
        gap: 20px;
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
        padding: 24px;
        border-radius: var(--radius-md);
        margin-bottom: 24px;
        border: 1px solid #bae6fd;
    }

    .register-icon {
        width: 60px;
        height: 60px;
        background: var(--primary-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
        flex-shrink: 0;
    }

    .register-content h4 {
        font-size: 18px;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .register-content p {
        font-size: 14px;
        color: var(--text-secondary);
        margin-bottom: 12px;
    }

    .register-action-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: white;
        color: var(--primary-color);
        border: 2px solid var(--primary-color);
        border-radius: var(--radius-full);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s;
    }

        .register-action-btn:hover {
            background: var(--primary-color);
            color: white;
            transform: translateY(-1px);
        }

    .benefits-list {
        background: var(--bg-light);
        border-radius: var(--radius-md);
        padding: 24px;
