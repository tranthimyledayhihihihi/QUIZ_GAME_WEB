
@{
    ViewBag.Title = "Trận Đấu Đối Kháng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var matchCode = ViewBag.MatchCode as string;
    var apiBase = System.Configuration.ConfigurationManager.AppSettings["ApiBaseUrl"];
    if (apiBase != null && apiBase.EndsWith("/"))
    {
        apiBase = apiBase.Substring(0, apiBase.Length - 1);
    }
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Trận Đấu: <span id="lblMatchCode">@matchCode</span></h4>
            <div>
                <span class="badge bg-light text-dark" id="lblTimer">00:00</span>
            </div>
        </div>
        <div class="card-body">
            <!-- Loading State -->
            <div id="loadingArea" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Đang tải dữ liệu trận đấu...</p>
            </div>

            <!-- Game Area -->
            <div id="gameArea" style="display:none;">
                <div class="row align-items-center mb-3">
                    <div class="col-6">
                        <h5 id="lblQuestionIndex">Câu hỏi 1/10</h5>
                    </div>
                    <div class="col-6 text-end">
                        <span class="badge bg-info">Đối thủ: <span id="lblOpponentStatus">Đang chơi...</span></span>
                    </div>
                </div>

                <div class="p-4 bg-light rounded mb-4 text-center">
                    <h3 id="lblQuestionContent" class="fw-bold">Nội dung câu hỏi sẽ hiển thị ở đây?</h3>
                </div>

                <div class="row g-3" id="answersArea">
                    <!-- Answers will be generated here -->
                </div>
            </div>

            <!-- Result Area -->
            <div id="resultArea" style="display:none;" class="text-center py-5">
                <h2 class="text-success fw-bold">Trận Đấu Kết Thúc!</h2>
                <div class="my-4">
                    <h4 id="lblMyScore" class="text-primary">Điểm của bạn: 0</h4>
                    <p id="lblResultMsg" class="lead text-secondary"></p>
                </div>
                <a href="/Quiz/DoiKhang" class="btn btn-outline-primary mt-3">Quay về Sảnh</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
    const matchCode = '@Html.Raw(matchCode)';
    let ws;
    let currentQuestions = [];
    let currentQuestionIndex = 0;

    // TRẠNG THÁI GAME
    let myUserId = 0;
    let yourScore = 0;
    let opponentScore = 0;

    let timer;
    let timeLeft = 15;
    // ==============================================
    // 1. HÀM GIẢI MÃ TOKEN ĐỂ LẤY USER ID
    // ==============================================
    function parseJwt(token) {
        try {
            var base64Url = token.split('.')[1];
            var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
            var jsonPayload = decodeURIComponent(window.atob(base64).split('').map(function(c) {
                return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
            }).join(''));
            return JSON.parse(jsonPayload);
        } catch (e) {
            return null;
        }
    }
    function getToken() {
        var token = '@Html.Raw(Session["JwtToken"])';
        if (!token || token === '') {
            token = '@Html.Raw(Session["JWT_TOKEN"])';
        }
        return token;
    }
    // ==============================================
    // 2. KẾT NỐI VÀ KHỞI TẠO
    // ==============================================
    function connectToMatch() {
        const token = getToken();
        if (!token || token === '') {
            alert('❌ Chưa đăng nhập!');
            window.location.href = '/User/Account/Login';
            return;
        }
        // LẤY ID CỦA CHÍNH MÌNH
        const decoded = parseJwt(token);
        if (decoded && decoded.nameid) {
            myUserId = parseInt(decoded.nameid);
            console.log("👤 My UserID:", myUserId);
        } else {
            console.error("❌ Không lấy được UserID từ Token");
        }
        const wsUrl = 'wss://localhost:7092/ws/game?access_token=' + encodeURIComponent(token);
        ws = new WebSocket(wsUrl);
        ws.onopen = function() {
            console.log("✅ Socket Connected!");
            ws.send(JSON.stringify({
                Type: 'JOIN_MATCH',
                Data: { matchCode: matchCode }
            }));
        };
        ws.onmessage = function(event) {
            try {
                const data = JSON.parse(event.data);
                handleMessage(data);
            } catch (error) {
                console.error('Error parsing message:', error);
            }
        };
        ws.onclose = function() {
            console.log('WebSocket closed');
        };
    }
    function handleMessage(data) {
        console.log("📩 Received:", data.Type, data);
        switch(data.Type) {
            case 'QUESTIONS':
                currentQuestions = data.Data;
                if (currentQuestions && currentQuestions.length > 0) {
                    displayQuestion(0);
                }
                break;
            case 'SCORE_UPDATE':
                updateScores(data.Data); // QUAN TRỌNG: Cập nhật điểm
                break;
            case 'GAME_END':
                showGameResult(data.Data);
                break;

            case 'ERROR':
                alert("Lỗi: " + data.Data.message);
                break;
        }
    }
    // ==============================================
    // 3. XỬ LÝ CÂU HỎI VÀ ĐIỂM SỐ
    // ==============================================
    function displayQuestion(index) {
        if (index >= currentQuestions.length) {
            $('#gameArea').html('<div class="loading"><h2>⏳ Đang chờ kết quả...</h2></div>');
            $('.timer').hide();
            return;
        }
        const q = currentQuestions[index];
        currentQuestionIndex = index;
        let choices = JSON.parse(q.CacLuaChon || '{}');
        let html = '<div class="question-box">';
        html += '<span class="question-number">Câu ' + (index + 1) + '/' + currentQuestions.length + '</span>';
        html += '<div class="question-text">' + q.NoiDung + '</div>';
        html += '</div>';
        html += '<div class="answers-grid">';
        ['A', 'B', 'C', 'D'].forEach(letter => {
            if (choices[letter]) {
                html += '<button class="answer-btn" data-answer="' + letter + '">' + letter + '. ' + choices[letter] + '</button>';
            }
        });
        html += '</div>';
        $('#gameArea').html(html);
        $('.timer').show();
        startTimer();
        $('.answer-btn').click(function() {
            if ($(this).hasClass('disabled')) return;
            $('.answer-btn').addClass('disabled');
            $(this).addClass('selected');
            const answer = $(this).data('answer');
            submitAnswer(q.CauHoiID, answer);
        });
    }
    function updateScores(data) {
        // data = { userId: 123, correct: true, selectedAnswer: 'A' }
        // Logic cộng điểm (Mỗi câu đúng 100 điểm)
        if (data.correct) {
            if (data.userId === myUserId) {
                yourScore += 100; // Cộng cho mình
            } else {
                opponentScore += 100; // Cộng cho đối thủ
            }
        }
        // Cập nhật giao diện
        $('#yourScore').text(yourScore);
        $('#opponentScore').text(opponentScore);
        // Hiệu ứng nút bấm (Xanh/Đỏ)
        // Chỉ hiển thị hiệu ứng nếu là câu mình đang trả lời
        if (currentQuestions[currentQuestionIndex]) {
             // Nếu là mình trả lời thì tô màu nút
             if (data.userId === myUserId) {
                 const $btn = $('.answer-btn[data-answer="' + data.selectedAnswer + '"]');
                 if (data.correct) $btn.removeClass('selected').addClass('correct');
                 else $btn.removeClass('selected').addClass('incorrect');
             }
        }
    }
    function submitAnswer(questionId, answer) {
        clearInterval(timer);
        const timeSpent = 15 - timeLeft;
        if (ws && ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify({
                Type: 'SUBMIT_ANSWER',
                Data: {
                    matchCode: matchCode,
                    questionId: questionId,
                    selectedAnswer: answer || '',
                    timeSpent: timeSpent
                }
            }));
        }
        setTimeout(function() {
            displayQuestion(currentQuestionIndex + 1);
        }, 2000); // 2 giây sau chuyển câu
    }
    function startTimer() {
        timeLeft = 15;
        $('#timeLeft').text(timeLeft);
        clearInterval(timer);
        timer = setInterval(function() {
            timeLeft--;
            $('#timeLeft').text(timeLeft);
            if (timeLeft <= 0) {
                clearInterval(timer);
                submitAnswer(currentQuestions[currentQuestionIndex].CauHoiID, '');
            }
        }, 1000);
    }
    function showGameResult(data) {
        clearInterval(timer);
        $('.timer').hide();
        // Server trả về: { DiemPlayer1, DiemPlayer2, WinnerHoTen, KetQua }
        // Lưu ý: data chưa cho biết mình là Player 1 hay 2, nên ta dùng điểm tại chỗ để hiển thị cho chính xác

        // Tuy nhiên, để đồng bộ tuyệt đối, ta có thể dùng điểm Server trả về
        // Nhưng cần biết mình là P1 hay P2.
        // 💡 Mẹo: So sánh điểm mình (yourScore) với DiemPlayer1 và DiemPlayer2 để đoán.

        let p1 = data.DiemPlayer1;
        let p2 = data.DiemPlayer2;
        let resultHtml = '<div class="game-result">';
        resultHtml += '<h1 class="result-title">🏁 Kết Quả Trận Đấu</h1>';

        resultHtml += '<div class="final-scores">';
             resultHtml += '<div class="final-score"><h3>Bạn</h3><div class="big-score">' + yourScore + '</div></div>';
             resultHtml += '<div class="vs">VS</div>';
             resultHtml += '<div class="final-score"><h3>Đối thủ</h3><div class="big-score">' + opponentScore + '</div></div>';
        resultHtml += '</div>';
        // Xác định thắng thua dựa trên điểm hiển thị
        let msg = "🤝 Hòa!";
        let cls = "draw";
        if (yourScore > opponentScore) { msg = "🎉 Bạn Thắng!"; cls = "winner"; }
        else if (yourScore < opponentScore) { msg = "😢 Bạn Thua!"; cls = "loser"; }
        resultHtml += '<div class="result-message ' + cls + '">' + msg + '</div>';
        resultHtml += '<button class="btn-return" onclick="returnToLobby()">🏠 Về Sảnh</button>';
        resultHtml += '</div>';
        $('#gameArea').html(resultHtml);
    }
    function returnToLobby() {
        if (ws) ws.close();
        window.location.href = '/Quiz/DoiKhang';
    }
    $(document).ready(function() {
        if (matchCode) setTimeout(connectToMatch, 500);
    });
    </script>
}