@model WEBB_FE.Models.Admin.PhanThuongIndexViewModel
@{
    ViewBag.Title = "Quản lý Phần thưởng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-lg-4">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-5 pt-3">
        <div>
            <div class="d-flex align-items-center">
                <div class="icon-shape bg-gradient-warning rounded-circle p-3 mr-3 shadow">
                    <i class="fas fa-gift fa-2x text-white"></i>
                </div>
                <div>
                    <h1 class="h3 mb-1 text-gray-900 font-weight-800">Quản lý Phần Thưởng</h1>
                    <p class="mb-0 text-gray-600">Theo dõi và quản lý phần thưởng của người dùng</p>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge badge-pill badge-light border mr-3 px-3 py-2">
                <i class="fas fa-layer-group mr-2"></i>
                <span id="totalCount">@Model.Items.Count()</span> phần thưởng
            </span>
        </div>
    </div>

    <!-- Thông báo lỗi -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm animate__animated animate__fadeIn mb-4" role="alert">
            <div class="d-flex align-items-center">
                <div class="alert-icon">
                    <i class="fas fa-exclamation-circle me-3"></i>
                </div>
                <div class="flex-grow-1">
                    <strong>Lỗi!</strong> @ViewBag.Error
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- Tổng quan phần thưởng -->
    <div class="row mb-5">
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-success-light rounded-circle mr-3">
                            <i class="fas fa-check-circle text-success"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Đã nhận</h6>
                            <h3 class="font-weight-bold mb-0 text-success" id="receivedCount">
                                @Model.Items.Count(i => i.TrangThaiNhan)
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-warning-light rounded-circle mr-3">
                            <i class="fas fa-clock text-warning"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Chưa nhận</h6>
                            <h3 class="font-weight-bold mb-0 text-warning" id="pendingCount">
                                @Model.Items.Count(i => !i.TrangThaiNhan)
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-primary-light rounded-circle mr-3">
                            <i class="fas fa-coins text-primary"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Tổng điểm</h6>
                            <h3 class="font-weight-bold mb-0 text-primary" id="totalPoints">
                                @Model.Items.Sum(i => i.DiemThuong).ToString("N0")
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-info-light rounded-circle mr-3">
                            <i class="fas fa-users text-info"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Người nhận</h6>
                            <h3 class="font-weight-bold mb-0 text-info" id="uniqueUsers">
                                @Model.Items.Select(i => i.UserID).Distinct().Count()
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Form tặng phần thưởng -->
    <div class="card shadow-lg border-0 mb-5 animate__animated animate__fadeInUp">
        <div class="card-header bg-gradient-success border-0 py-4">
            <h6 class="m-0 font-weight-bold text-white">
                <i class="fas fa-gift mr-2"></i>Tặng Phần Thưởng Mới
            </h6>
        </div>
        <div class="card-body p-4">
            <form method="post" action="@Url.Action("GiveReward", "PhanThuong")" id="giveRewardForm">
                <div class="row g-4">
                    <div class="col-lg-3 col-md-6">
                        <div class="form-group">
                            <label for="UserID" class="form-label font-weight-bold text-gray-700">
                                <i class="fas fa-user mr-2 text-primary"></i>Người nhận
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg shadow-sm">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0">
                                        <i class="fas fa-user-tag text-primary"></i>
                                    </span>
                                </div>
                                <input type="number" name="UserID" id="UserID"
                                       class="form-control form-control-lg border-left-0 py-3"
                                       placeholder="Nhập User ID"
                                       required min="1">
                            </div>
                            <small class="form-text text-muted mt-2">
                                <i class="fas fa-info-circle mr-1"></i>ID của người dùng cần tặng thưởng
                            </small>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-6">
                        <div class="form-group">
                            <label for="PhanThuong" class="form-label font-weight-bold text-gray-700">
                                <i class="fas fa-medal mr-2 text-primary"></i>Phần thưởng
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group input-group-lg shadow-sm">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0">
                                        <i class="fas fa-gift text-primary"></i>
                                    </span>
                                </div>
                                <input type="text" name="PhanThuong" id="PhanThuong"
                                       class="form-control form-control-lg border-left-0 py-3"
                                       placeholder="Ví dụ: Gift card 100k, Voucher Shopee..."
                                       required>
                            </div>
                            <small class="form-text text-muted mt-2">
                                <i class="fas fa-info-circle mr-1"></i>Mô tả phần thưởng sẽ tặng
                            </small>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="form-group">
                            <label for="DiemThuong" class="form-label font-weight-bold text-gray-700">
                                <i class="fas fa-star mr-2 text-primary"></i>Điểm thưởng
                            </label>
                            <div class="input-group input-group-lg shadow-sm">
                                <div class="input-group-prepend">
                                    <span class="input-group-text bg-white border-right-0">
                                        <i class="fas fa-coins text-primary"></i>
                                    </span>
                                </div>
                                <input type="number" name="DiemThuong" id="DiemThuong"
                                       class="form-control form-control-lg border-left-0 py-3"
                                       placeholder="Nhập điểm"
                                       min="0" step="100">
                            </div>
                            <small class="form-text text-muted mt-2">
                                <i class="fas fa-info-circle mr-1"></i>Điểm thưởng (nếu có)
                            </small>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6 d-flex align-items-end">
                        <button type="submit" class="btn btn-success btn-lg w-100 shadow-lg py-3"
                                id="submitBtn">
                            <i class="fas fa-paper-plane mr-2"></i>
                            <span class="submit-text">Tặng ngay</span>
                            <span class="spinner-border spinner-border-sm ml-2 d-none"
                                  id="submitSpinner"></span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách phần thưởng -->
    <div class="card shadow-lg border-0 animate__animated animate__fadeIn">
        <div class="card-header bg-gradient-primary border-0 py-4">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-white">
                    <i class="fas fa-history mr-2"></i>Lịch sử Phần Thưởng
                    <small class="ml-2">(@Model.Items.Count() items)</small>
                </h6>
                <div class="d-flex align-items-center">
                    <div class="input-group input-group-sm" style="width: 200px;">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search text-gray-400"></i>
                            </span>
                        </div>
                        <input type="text" class="form-control" id="searchInput"
                               placeholder="Tìm kiếm...">
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="rewardTable">
                        <thead class="thead-light">
                            <tr>
                                <th width="8%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>ID</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('id')"></i>
                                    </div>
                                </th>
                                <th width="20%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Người nhận</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('user')"></i>
                                    </div>
                                </th>
                                <th width="25%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Phần thưởng</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('reward')"></i>
                                    </div>
                                </th>
                                <th width="12%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Điểm</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('points')"></i>
                                    </div>
                                </th>
                                <th width="15%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Thời gian</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('date')"></i>
                                    </div>
                                </th>
                                <th width="10%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Trạng thái</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('status')"></i>
                                    </div>
                                </th>
                                <th width="10%" class="py-3 border-top-0 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr class="reward-row"
                                    data-user="@item.Username.ToLower()"
                                    data-reward="@item.PhanThuong.ToLower()"
                                    data-status="@(item.TrangThaiNhan ? "received" : "pending")">
                                    <td class="align-middle">
                                        <span class="badge badge-pill badge-secondary px-3 py-2">
                                            #@item.ThuongID
                                        </span>
                                    </td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar avatar-xs mr-2">
                                                <div class="avatar-initials @GetUserColor(item.UserID.ToString())">
                                                    @GetInitials(item.Username)
                                                </div>
                                            </div>
                                            <div>
                                                <div class="font-weight-bold text-gray-800">
                                                    @item.Username
                                                </div>
                                                <small class="text-muted">
                                                    <i class="fas fa-hashtag mr-1"></i>
                                                    UID: @item.UserID
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div class="reward-icon mr-3">
                                                <i class="fas fa-gift text-warning"></i>
                                            </div>
                                            <div>
                                                <div class="font-weight-bold text-gray-800">@item.PhanThuong</div>
                                                @if (item.DiemThuong > 0)
                                                {
                                                    <small class="text-muted">
                                                        <i class="fas fa-coins mr-1"></i>Đã bao gồm điểm thưởng
                                                    </small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div class="text-center">
                                            @if (item.DiemThuong > 0)
                                            {
                                                <div class="points-display">
                                                    <div class="h5 mb-0 font-weight-bold text-warning">
                                                        @item.DiemThuong.ToString("N0")
                                                    </div>
                                                    <small class="text-muted">điểm</small>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted font-italic">
                                                    <i class="fas fa-minus mr-1"></i>Không có
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div class="text-gray-800">
                                            <i class="far fa-calendar mr-2"></i>@item.NgayNhan.ToString("dd/MM/yyyy")
                                        </div>
                                        <small class="text-muted">
                                            <i class="far fa-clock mr-2"></i>@item.NgayNhan.ToString("HH:mm")
                                        </small>
                                        <div class="small mt-1">
                                            <span class="badge badge-light">
                                                @GetTimeAgo(item.NgayNhan)
                                            </span>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        @if (item.TrangThaiNhan)
                                        {
                                            <span class="badge badge-pill badge-success px-3 py-2">
                                                <i class="fas fa-check-circle mr-1"></i>Đã nhận
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pill badge-warning px-3 py-2">
                                                <i class="fas fa-clock mr-1"></i>Chưa nhận
                                            </span>
                                        }
                                    </td>
                                    <td class="align-middle text-center">
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-outline-info btn-sm rounded-circle mr-2"
                                                    title="Xem chi tiết"
                                                    onclick="showRewardDetail(@item.ThuongID)">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm rounded-circle"
                                                    title="Xóa phần thưởng"
                                                    onclick="deleteReward(@item.ThuongID, '@item.Username.Replace("'", "\\'")', '@item.PhanThuong.Replace("'", "\\'").Replace("\"", "&quot;")')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Phân trang -->
                <div class="d-flex justify-content-between align-items-center p-4 border-top">
                    <div class="text-muted">
                        Hiển thị <span id="visibleItems">@Model.Items.Count()</span> trên tổng số @Model.Items.Count() phần thưởng
                    </div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item disabled">
                                <a class="page-link" href="#">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
            else
            {
                <div class="text-center py-6">
                    <div class="empty-state">
                        <div class="empty-state-icon bg-gradient-warning">
                            <i class="fas fa-gift"></i>
                        </div>
                        <h3 class="mt-4 text-gray-700">Không có phần thưởng nào</h3>
                        <p class="text-gray-500 mb-4">Chưa có phần thưởng nào được tặng</p>
                        <button class="btn btn-warning" onclick="document.getElementById('UserID').focus()">
                            <i class="fas fa-gift mr-2"></i>Tặng phần thưởng đầu tiên
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Chi tiết Phần thưởng -->
<div class="modal fade" id="rewardDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-gradient-primary border-0">
                <h5 class="modal-title text-white">
                    <i class="fas fa-info-circle mr-2"></i>Chi tiết Phần Thưởng
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4" id="rewardDetailContent">
                <!-- Nội dung sẽ được load bằng JS -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận Xóa -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-gradient-danger border-0">
                <h5 class="modal-title text-white">
                    <i class="fas fa-trash-alt mr-2"></i>Xác nhận Xóa Phần Thưởng
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div class="warning-icon bg-danger-light rounded-circle d-inline-flex p-4 mb-3">
                        <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                    </div>
                    <h5 class="font-weight-bold text-gray-800">Xóa phần thưởng này?</h5>
                    <div class="alert alert-light mt-3">
                        <div class="d-flex align-items-start">
                            <div class="avatar avatar-sm mr-3">
                                <div class="avatar-initials bg-primary text-white" id="deleteUserInitials"></div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="font-weight-bold text-gray-800" id="deleteUsername"></div>
                                <p class="mb-1 text-muted small" id="deleteRewardPreview"></p>
                                <div class="small text-muted">
                                    <i class="fas fa-coins mr-1"></i>Điểm: <span id="deleteRewardPoints"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <p class="text-danger small mt-3">
                        <i class="fas fa-exclamation-circle mr-1"></i>
                        Hành động này không thể hoàn tác. Phần thưởng sẽ bị xóa vĩnh viễn khỏi hệ thống.
                    </p>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light px-4" data-dismiss="modal">
                    <i class="fas fa-times mr-2"></i>Hủy bỏ
                </button>
                <form method="post" action="@Url.Action("Delete", "PhanThuong")" id="deleteForm">
                    <input type="hidden" name="id" id="deleteRewardId" />
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash mr-2"></i>Xác nhận xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Toast notification -->
<div aria-live="polite" aria-atomic="true" class="position-relative">
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-gradient-success text-white border-0">
                <i class="fas fa-check-circle mr-2"></i>
                <strong class="me-auto">Thành công!</strong>
                <small>Vừa xong</small>
                <button type="button" class="ml-2 mb-1 close text-white" data-dismiss="toast">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="toast-body bg-white" id="toastMessage"></div>
        </div>
    </div>
</div>

@functions {
    public string GetUserColor(string userId)
    {
        if (string.IsNullOrWhiteSpace(userId))
            return "bg-secondary";

        int hash = 0;
        foreach (char c in userId)
        {
            hash = (hash << 5) - hash + c;
        }

        hash = Math.Abs(hash);
        int index = hash % 5;

        switch (index)
        {
            case 0:
                return "bg-primary";
            case 1:
                return "bg-success";
            case 2:
                return "bg-warning";
            case 3:
                return "bg-danger";
            default:
                return "bg-info";
        }
    }



    public string GetInitials(string username)
    {
        if (string.IsNullOrWhiteSpace(username))
            return "??";

        var names = username
            .Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);

        if (names.Length >= 2)
        {
            char first = names[0][0];
            char last = names[names.Length - 1][0];
            return (first.ToString() + last.ToString()).ToUpper();
        }

        if (username.Length >= 2)
            return username.Substring(0, 2).ToUpper();

        return username.ToUpper();
    }


    public string GetTimeAgo(DateTime date)
    {
        var timeSpan = DateTime.Now - date;

        if (timeSpan.TotalDays >= 365)
            return $"{(int)(timeSpan.TotalDays / 365)} năm trước";
        if (timeSpan.TotalDays >= 30)
            return $"{(int)(timeSpan.TotalDays / 30)} tháng trước";
        if (timeSpan.TotalDays >= 7)
            return $"{(int)(timeSpan.TotalDays / 7)} tuần trước";
        if (timeSpan.TotalDays >= 1)
            return $"{(int)timeSpan.TotalDays} ngày trước";
        if (timeSpan.TotalHours >= 1)
            return $"{(int)timeSpan.TotalHours} giờ trước";
        if (timeSpan.TotalMinutes >= 1)
            return $"{(int)timeSpan.TotalMinutes} phút trước";

        return "Vừa xong";
    }
}

