@{
    Layout = null; // Layout không dùng layout khác
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - IQuiz</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Nunito:wght@400;600;700;800&display=swap"
          rel="stylesheet" />

    <!-- CSS chung -->
    <link href="~/Content/site.css" rel="stylesheet" />
    <link href="~/Content/game-theme.css" rel="stylesheet" />

    <!-- 🔥 FIX SCROLL BỊ KHOÁ -->
    <style>
        html, body {
            height: auto !important;
            min-height: 100%;
            overflow-y: auto !important;
            overflow-x: hidden;
        }

        /* Container chính */
        .main-container {
            min-height: 100vh;
            overflow-y: auto;
        }
    </style>

    <!-- CSS riêng từng trang (nếu có) -->
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Top Right Icons -->
    <div class="top-right-nav">
        <!-- Nút Cài đặt (Luôn hiện hoặc ẩn tùy bạn) -->
        <a href="@Url.Action("Index", "Settings")" class="nav-icon-btn">
            <i class="fa-solid fa-gear"></i>
        </a>

        <a href="@Url.Action("Index", "Home")" class="nav-icon-btn">
            <i class="fa-solid fa-house"></i>
        </a>

        <!-- 👇 LOGIC CHECK ĐĂNG NHẬP 👇 -->
        @if (Session["JWT_TOKEN"] == null)
        {
            <!-- CHƯA LOGIN: Hiện nút Đăng nhập -->
            <a href="@Url.Action("Login", "Account")" class="nav-icon-btn" title="Đăng nhập">
                <i class="fa-solid fa-right-to-bracket"></i>
            </a>
        }
        else
        {
            <!-- ĐÃ LOGIN: Hiện nút Profile -->
            <a href="@Url.Action("Indexplay", "Profile")" class="nav-icon-btn" title="Hồ sơ cá nhân">
                <i class="fa-solid fa-user"></i>
            </a>
            <!-- Và nút Đăng xuất -->
            <a href="@Url.Action("Logout", "Account")" class="nav-icon-btn" style="background: #fa5252; border-bottom-color: #c92a2a;" title="Đăng xuất">
                <i class="fa-solid fa-right-from-bracket"></i>
            </a>
        }
    </div>

    <!-- Main Content -->
    <div class="main-container">
        @RenderBody()
    </div>

    <!-- Script chung -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script riêng từng trang (nếu có) -->
    @RenderSection("Scripts", required: false)

    <!-- Script cua SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
</body>
</html>
