@model WEBB.Models.User.RegisterRequest

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Đăng ký IQuiz";
    ViewBag.BodyClass = "register-page";
}

<div class="auth-container">
    <div class="auth-wrapper">
        <!-- Left Side - Brand & Benefits -->
        <div class="auth-left">
            <div class="auth-background">
                <div class="auth-overlay"></div>
                <div class="auth-content">
                    <div class="auth-brand">
                        <div class="auth-brand-logo">
                            <i class="fas fa-brain"></i>
                        </div>
                        <h1 class="auth-brand-name">IQuiz</h1>
                        <p class="auth-brand-tagline">Nơi kiến thức gặp thử thách</p>
                    </div>

                    <div class="auth-benefits">
                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <div class="benefit-content">
                                <h4>Bảo mật tuyệt đối</h4>
                                <p>Thông tin của bạn được mã hóa an toàn</p>
                            </div>
                        </div>

                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <i class="fas fa-rocket"></i>
                            </div>
                            <div class="benefit-content">
                                <h4>Học tập hiệu quả</h4>
                                <p>Hệ thống quiz thông minh giúp bạn tiến bộ nhanh</p>
                            </div>
                        </div>

                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="benefit-content">
                                <h4>Cộng đồng học tập</h4>
                                <p>Kết nối và thi đấu với hàng ngàn người học</p>
                            </div>
                        </div>
                    </div>

                    <div class="auth-stats">
                        <div class="stat-item">
                            <div class="stat-value">10K+</div>
                            <div class="stat-label">Thành viên</div>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item">
                            <div class="stat-value">50K+</div>
                            <div class="stat-label">Câu hỏi</div>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-item">
                            <div class="stat-value">98%</div>
                            <div class="stat-label">Hài lòng</div>
                        </div>
                    </div>

                    <div class="auth-testimonial">
                        <div class="testimonial-content">
                            "IQuiz đã thay đổi cách tôi học tập. Phương pháp học qua quiz thực sự hiệu quả!"
                        </div>
                        <div class="testimonial-author">
                            <strong>Nguyễn Văn A</strong>
                            <span>Học viên IQuiz</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Side - Register Form -->
        <div class="auth-right">
            <div class="auth-form-container">
                <a href="@Url.Action("Login", "Account")" class="back-to-login">
                    <i class="fas fa-arrow-left"></i>
                    <span>Quay lại đăng nhập</span>
                </a>

                <div class="auth-form-header">
                    <div class="header-icon">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <h1>Tạo tài khoản mới</h1>
                    <p class="subtitle">Điền thông tin để bắt đầu hành trình học tập</p>
                </div>

                <!-- Error Message -->
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-error">
                        <div class="alert-icon">
                            <i class="fas fa-exclamation-circle"></i>
                        </div>
                        <div class="alert-content">
                            <h5>Đăng ký không thành công</h5>
                            <p>@Model.ErrorMessage</p>
                        </div>
                        <button type="button" class="alert-close" onclick="this.parentElement.style.display='none'">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                }

                <!-- Success Message from Registration -->
                @if (TempData["RegisterSuccess"] != null)
                {
                    <div class="alert alert-success">
                        <div class="alert-icon">
                            <i class="fas fa-check-circle"></i>
                        </div>
                        <div class="alert-content">
                            <h5>Đăng ký thành công!</h5>
                            <p>@TempData["RegisterSuccess"]</p>
                        </div>
                        <button type="button" class="alert-close" onclick="this.parentElement.style.display='none'">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                }

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "auth-form", id = "registerForm" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user"></i>
                            <span>Tên đăng nhập *</span>
                        </label>
                        <div class="input-container">
                            @Html.TextBoxFor(m => m.UserName, new
                            {
                                @class = "form-control auth-input",
                                placeholder = "Nhập tên đăng nhập...",
                                autocomplete = "username",
                                required = "required",
                                id = "UserName"
                            })
                            <div class="input-status">
                                <i class="fas fa-check-circle valid-icon" style="display: none;"></i>
                                <i class="fas fa-exclamation-circle invalid-icon" style="display: none;"></i>
                            </div>
                        </div>
                        <div class="validation-feedback">
                            @Html.ValidationMessageFor(m => m.UserName, null, new { @class = "validation-error" })
                            <div class="hint">Từ 4-20 ký tự, có thể bao gồm chữ, số và dấu gạch dưới</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-envelope"></i>
                            <span>Email *</span>
                        </label>
                        <div class="input-container">
                            @Html.TextBoxFor(m => m.Email, new
                            {
                                @class = "form-control auth-input",
                                placeholder = "Nhập email...",
                                type = "email",
                                autocomplete = "email",
                                required = "required",
                                id = "Email"
                            })
                            <div class="input-status">
                                <i class="fas fa-check-circle valid-icon" style="display: none;"></i>
                                <i class="fas fa-exclamation-circle invalid-icon" style="display: none;"></i>
                            </div>
                        </div>
                        <div class="validation-feedback">
                            @Html.ValidationMessageFor(m => m.Email, null, new { @class = "validation-error" })
                            <div class="hint">Chúng tôi sẽ gửi email xác nhận đến địa chỉ này</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-lock"></i>
                            <span>Mật khẩu *</span>
                        </label>
                        <div class="input-container">
                            @Html.PasswordFor(m => m.Password, new
                            {
                                @class = "form-control auth-input",
                                placeholder = "Nhập mật khẩu...",
                                autocomplete = "new-password",
                                required = "required",
                                id = "Password"
                            })
                            <div class="input-actions">
                                <button type="button" class="password-toggle" onclick="togglePassword('Password')">
                                    <i class="fas fa-eye" id="passwordIcon"></i>
                                </button>
                            </div>
                        </div>
                        <div class="validation-feedback">
                            @Html.ValidationMessageFor(m => m.Password, null, new { @class = "validation-error" })

                            <div class="password-strength">
                                <div class="strength-label">Độ mạnh mật khẩu:</div>
                                <div class="strength-bar">
                                    <div class="strength-segment" data-level="1"></div>
                                    <div class="strength-segment" data-level="2"></div>
                                    <div class="strength-segment" data-level="3"></div>
                                    <div class="strength-segment" data-level="4"></div>
                                </div>
                                <div class="strength-text" id="strengthText">Bắt đầu nhập...</div>
                            </div>

                            <div class="password-requirements">
                                <div class="requirement" data-requirement="length">
                                    <i class="fas fa-circle"></i>
                                    <span>Ít nhất 8 ký tự</span>
                                </div>
                                <div class="requirement" data-requirement="uppercase">
                                    <i class="fas fa-circle"></i>
                                    <span>Chứa chữ hoa và chữ thường</span>
                                </div>
                                <div class="requirement" data-requirement="number">
                                    <i class="fas fa-circle"></i>
                                    <span>Ít nhất 1 số</span>
                                </div>
                                <div class="requirement" data-requirement="special">
                                    <i class="fas fa-circle"></i>
                                    <span>Ít nhất 1 ký tự đặc biệt</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-lock"></i>
                            <span>Xác nhận mật khẩu *</span>
                        </label>
                        <div class="input-container">
                            @Html.PasswordFor(m => m.ConfirmPassword, new
                            {
                                @class = "form-control auth-input",
                                placeholder = "Nhập lại mật khẩu...",
                                autocomplete = "new-password",
                                required = "required",
                                id = "ConfirmPassword"
                            })
                            <div class="input-actions">
                                <button type="button" class="password-toggle" onclick="togglePassword('ConfirmPassword')">
                                    <i class="fas fa-eye" id="confirmPasswordIcon"></i>
                                </button>
                            </div>
                        </div>
                        <div class="validation-feedback">
                            @Html.ValidationMessageFor(m => m.ConfirmPassword, null, new { @class = "validation-error" })

                            <div class="password-match" id="passwordMatch">
                                <i class="fas fa-check-circle"></i>
                                <span id="matchText">Mật khẩu khớp</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group terms-group">
                        <div class="terms-container">
                            <label class="terms-label">
                                <input type="checkbox" id="termsAgreement" name="termsAgreement" required />
                                <span class="checkmark"></span>
                                <span>
                                    Tôi đồng ý với
                                    <a href="@Url.Action("Terms", "Home")" class="terms-link">Điều khoản dịch vụ</a>
                                    và
                                    <a href="@Url.Action("Privacy", "Home")" class="terms-link">Chính sách bảo mật</a>
                                </span>
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="auth-submit-btn" id="registerButton">
                        <span class="btn-text">Tạo tài khoản</span>
                        <span class="btn-icon">
                            <i class="fas fa-user-plus"></i>
                        </span>
                    </button>

                    <!-- Divider -->
                    <div class="divider">
                        <span class="divider-line"></span>
                        <span class="divider-text">Hoặc đăng ký với</span>
                        <span class="divider-line"></span>
                    </div>

                    <!-- Social Login -->
                    <div class="social-login">
                        <button type="button" class="social-btn google-btn">
                            <div class="social-icon">
                                <i class="fab fa-google"></i>
                            </div>
                            <span class="social-text">Google</span>
                        </button>
                        <button type="button" class="social-btn facebook-btn">
                            <div class="social-icon">
                                <i class="fab fa-facebook-f"></i>
                            </div>
                            <span class="social-text">Facebook</span>
                        </button>
                        <button type="button" class="social-btn github-btn">
                            <div class="social-icon">
                                <i class="fab fa-github"></i>
                            </div>
                            <span class="social-text">GitHub</span>
                        </button>
                    </div>

                    <!-- Login Link -->
                    <div class="auth-footer">
                        <p class="login-text">
                            Đã có tài khoản?
                            <a href="@Url.Action("Login", "Account")" class="login-link">
                                <strong>Đăng nhập ngay</strong>
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="loading-spinner">
        <div class="spinner"></div>
        <p>Đang tạo tài khoản...</p>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --primary-color: #4f46e5;
            --primary-dark: #4338ca;
            --secondary-color: #7c3aed;
            --success-color: #10b981;
            --error-color: #ef4444;
            --warning-color: #f59e0b;
            --text-primary: #1f2937;
            --text-secondary: #6b7280;
            --text-light: #9ca3af;
            --border-color: #e5e7eb;
            --bg-light: #f9fafb;
            --bg-white: #ffffff;
            --bg-gradient: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 10px 30px rgba(0, 0, 0, 0.15);
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 20px;
            --transition: all 0.3s ease;
        }

        .register-page {
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        .auth-container {
            min-height: 100vh;
            width: 100vw;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--bg-gradient);
            padding: 20px;
            overflow: hidden;
        }

        .auth-wrapper {
            display: flex;
            width: 100%;
            max-width: 1200px;
            height: calc(100vh - 40px);
            min-height: 600px;
            max-height: 900px;
            background: var(--bg-white);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-lg);
            position: relative;
        }

        /* Left Side */
        .auth-left {
            flex: 1;
            background: var(--bg-gradient);
            color: white;
            position: relative;
            overflow: hidden;
        }

        .auth-background {
            position: relative;
            height: 100%;
            padding: 40px;
            display: flex;
            flex-direction: column;
        }

        .auth-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(79, 70, 229, 0.9) 0%, rgba(124, 58, 237, 0.9) 100%);
        }

        .auth-content {
            position: relative;
            z-index: 2;
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .auth-brand {
            text-align: center;
            padding-bottom: 40px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 40px;
        }

        .auth-brand-logo {
            width: 80px;
            height: 80px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .auth-brand-logo i {
            font-size: 36px;
            color: white;
        }

        .auth-brand-name {
            font-size: 42px;
            font-weight: 800;
            margin-bottom: 8px;
            background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .auth-brand-tagline {
            font-size: 16px;
            opacity: 0.9;
            margin: 0;
            font-weight: 300;
        }

        .auth-benefits {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 40px;
        }

        .benefit-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 20px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-md);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            transition: var(--transition);
        }

        .benefit-item:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-2px);
        }

        .benefit-icon {
            width: 48px;
            height: 48px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .benefit-icon i {
            font-size: 20px;
            color: white;
        }

        .benefit-content h4 {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .benefit-content p {
            font-size: 14px;
            opacity: 0.9;
            margin: 0;
            line-height: 1.5;
        }

        .auth-stats {
            display: flex;
            justify-content: space-around;
            align-items: center;
            padding: 24px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-md);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            margin-bottom: 40px;
        }

        .stat-item {
            text-align: center;
            flex: 1;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .stat-label {
            font-size: 14px;
            opacity: 0.9;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-divider {
            width: 1px;
            height: 40px;
            background: rgba(255, 255, 255, 0.2);
        }

        .auth-testimonial {
            padding: 24px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: var(--radius-md);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .testimonial-content {
            font-style: italic;
            font-size: 16px;
            line-height: 1.6;
            margin-bottom: 16px;
            position: relative;
            padding-left: 20px;
        }

        .testimonial-content::before {
            content: '"';
            position: absolute;
            left: 0;
            top: 0;
            font-size: 32px;
            color: rgba(255, 255, 255, 0.5);
            font-family: Georgia, serif;
            line-height: 1;
        }

        .testimonial-author {
            text-align: right;
            font-size: 14px;
        }

        .testimonial-author strong {
            display: block;
            font-weight: 600;
        }

        .testimonial-author span {
            opacity: 0.8;
            font-size: 13px;
        }

        /* Right Side */
        .auth-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            overflow-y: auto;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
        }

        .auth-form-container {
            width: 100%;
            max-width: 480px;
            margin: auto;
        }

        .back-to-login {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 14px;
            margin-bottom: 30px;
            padding: 8px 0;
            transition: var(--transition);
        }

        .back-to-login:hover {
            color: var(--primary-color);
            gap: 12px;
        }

        .auth-form-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .header-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
        }

        .header-icon i {
            font-size: 24px;
            color: white;
        }

        .auth-form-header h1 {
            font-size: 32px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 12px;
        }

        .subtitle {
            font-size: 16px;
            color: var(--text-secondary);
            margin: 0;
        }

        /* Alerts */
        .alert {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 20px;
            border-radius: var(--radius-md);
            margin-bottom: 24px;
            animation: slideIn 0.5s ease;
        }

        .alert-success {
            background: #f0fff4;
            border: 2px solid #c6f6d5;
            color: #2f855a;
        }

        .alert-error {
            background: #fff5f5;
            border: 2px solid #fed7d7;
            color: #c53030;
        }

        .alert-icon {
            font-size: 20px;
            flex-shrink: 0;
        }

        .alert-content {
            flex: 1;
        }

        .alert-content h5 {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .alert-content p {
            font-size: 14px;
            margin: 0;
        }

        .alert-close {
            background: none;
            border: none;
            color: inherit;
            cursor: pointer;
            padding: 4px;
            font-size: 14px;
            opacity: 0.7;
            transition: var(--transition);
            flex-shrink: 0;
        }

        .alert-close:hover {
            opacity: 1;
        }

        /* Form Styles */
        .auth-form {
            margin-top: 20px;
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-label {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 10px;
        }

        .form-label i {
            color: var(--primary-color);
            font-size: 16px;
        }

        .input-container {
            position: relative;
            display: flex;
            align-items: center;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-sm);
            transition: var(--transition);
            background: var(--bg-white);
        }

        .input-container:focus-within {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.1);
        }

        .input-container.valid {
            border-color: var(--success-color);
        }

        .input-container.invalid {
            border-color: var(--error-color);
        }

        .auth-input {
            flex: 1;
            border: none;
            padding: 16px 20px;
            font-size: 15px;
            background: transparent;
            outline: none;
            width: 100%;
        }

        .auth-input::placeholder {
            color: #adb5bd;
        }

        .input-status {
            padding: 0 16px;
            display: flex;
            align-items: center;
        }

        .valid-icon {
            color: var(--success-color);
            font-size: 18px;
        }

        .invalid-icon {
            color: var(--error-color);
            font-size: 18px;
        }

        .input-actions {
            padding: 0 16px;
            display: flex;
            align-items: center;
        }

        .password-toggle {
            background: none;
            border: none;
            color: var(--text-secondary);
            cursor: pointer;
            font-size: 18px;
            padding: 4px;
            transition: var(--transition);
        }

        .password-toggle:hover {
            color: var(--primary-color);
        }

        .validation-feedback {
            margin-top: 8px;
        }

        .validation-error {
            display: block;
            font-size: 13px;
            color: var(--error-color);
            margin-bottom: 8px;
        }

        .hint {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        /* Password Strength */
        .password-strength {
            margin-top: 16px;
            padding: 12px;
            background: var(--bg-light);
            border-radius: var(--radius-sm);
        }

        .strength-label {
            font-size: 13px;
            color: var(--text-secondary);
            margin-bottom: 8px;
        }

        .strength-bar {
            display: flex;
            gap: 4px;
            margin-bottom: 8px;
        }

        .strength-segment {
            flex: 1;
            height: 6px;
            background: #e0e0e0;
            border-radius: 3px;
            transition: var(--transition);
        }

        .strength-segment.active {
            background: var(--success-color);
        }

        .strength-segment[data-level="1"].active {
            background: var(--error-color);
        }

        .strength-segment[data-level="2"].active {
            background: var(--warning-color);
        }

        .strength-segment[data-level="3"].active,
        .strength-segment[data-level="4"].active {
            background: var(--success-color);
        }

        .strength-text {
            font-size: 12px;
            font-weight: 500;
            transition: var(--transition);
        }

        /* Password Requirements */
        .password-requirements {
            margin-top: 16px;
            display: grid;
            gap: 8px;
        }

        .requirement {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: var(--text-secondary);
            transition: var(--transition);
        }

        .requirement.valid {
            color: var(--success-color);
        }

        .requirement.valid i {
            color: var(--success-color);
        }

        .requirement i {
            font-size: 8px;
            color: var(--text-light);
            transition: var(--transition);
        }

        /* Password Match */
        .password-match {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--text-secondary);
            margin-top: 8px;
            transition: var(--transition);
        }

        .password-match.valid {
            color: var(--success-color);
        }

        .password-match i {
            font-size: 14px;
            transition: var(--transition);
        }

        .password-match.valid i {
            color: var(--success-color);
        }

        /* Terms */
        .terms-group {
            margin-top: 32px;
        }

        .terms-container {
            padding: 20px;
            background: var(--bg-light);
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-color);
        }

        .terms-label {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            cursor: pointer;
            font-size: 14px;
            color: var(--text-primary);
            user-select: none;
            line-height: 1.5;
        }

        .terms-label input[type="checkbox"] {
            display: none;
        }

        .checkmark {
            width: 20px;
            height: 20px;
            border: 2px solid var(--border-color);
            border-radius: 4px;
            display: inline-block;
            position: relative;
            transition: var(--transition);
            flex-shrink: 0;
            margin-top: 2px;
        }

        .terms-label input:checked + .checkmark {
            background: var(--primary-color);
            border-color: var(--primary-color);
        }

        .terms-label input:checked + .checkmark::after {
            content: '';
            position: absolute;
            left: 6px;
            top: 2px;
            width: 5px;
            height: 10px;
            border: solid white;
            border-width: 0 2px 2px 0;
            transform: rotate(45deg);
        }

        .terms-link {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            transition: var(--transition);
        }

        .terms-link:hover {
            text-decoration: underline;
        }

        /* Submit Button */
        .auth-submit-btn {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            border: none;
            border-radius: var(--radius-sm);
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            transition: var(--transition);
            margin: 32px 0;
        }

        .auth-submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .auth-submit-btn:active {
            transform: translateY(0);
        }

        .auth-submit-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .btn-icon {
            font-size: 18px;
        }

        /* Divider */
        .divider {
            display: flex;
            align-items: center;
            margin: 32px 0;
            color: var(--text-secondary);
            font-size: 14px;
        }

        .divider-line {
            flex: 1;
            height: 1px;
            background: var(--border-color);
        }

        .divider-text {
            padding: 0 20px;
        }

        /* Social Login */
        .social-login {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 32px;
        }

        .social-btn {
            padding: 14px;
            border: 2px solid var(--border-color);
            border-radius: var(--radius-sm);
            background: var(--bg-white);
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            transition: var(--transition);
        }

        .social-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-sm);
        }

        .google-btn:hover {
            border-color: #DB4437;
            color: #DB4437;
        }

        .facebook-btn:hover {
            border-color: #4267B2;
            color: #4267B2;
        }

        .github-btn:hover {
            border-color: #333;
            color: #333;
        }

        .social-icon {
            font-size: 20px;
        }

        .social-text {
            font-size: 13px;
        }

        /* Footer */
        .auth-footer {
            text-align: center;
            padding-top: 24px;
            border-top: 1px solid var(--border-color);
        }

        .login-text {
            font-size: 15px;
            color: var(--text-secondary);
            margin-bottom: 16px;
        }

        .login-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
            transition: var(--transition);
        }

        .login-link:hover {
            color: var(--primary-dark);
            gap: 10px;
        }

        .login-link i {
            font-size: 14px;
            transition: var(--transition);
        }

        /* Loading Overlay */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.9);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            backdrop-filter: blur(4px);
        }

        .loading-spinner {
            text-align: center;
        }

        .spinner {
            width: 50px;
            height: 50px;
            border: 3px solid var(--border-color);
            border-top-color: var(--primary-color);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 20px;
        }

        .loading-spinner p {
            color: var(--text-secondary);
            font-size: 14px;
        }

        /* Animations */
        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        /* Responsive Design */
        @@media (max-width: 1024px) {
            .auth-wrapper {
                max-height: 95vh;
            }

            .auth-left {
                flex: 1.2;
            }

            .auth-right {
                flex: 0.8;
                padding: 30px;
            }
        }

        @@media (max-width: 768px) {
            .auth-container {
                padding: 0;
                background: var(--bg-white);
            }

            .auth-wrapper {
                flex-direction: column;
                height: 100vh;
                max-height: none;
                border-radius: 0;
                box-shadow: none;
            }

            .auth-left {
                display: none;
            }

            .auth-right {
                flex: 1;
                padding: 24px;
                overflow-y: auto;
            }

            .auth-form-container {
                max-width: 100%;
            }

            .auth-form-header h1 {
                font-size: 28px;
            }

            .social-login {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 480px) {
            .auth-right {
                padding: 16px;
            }

            .auth-form-header h1 {
                font-size: 24px;
            }

            .subtitle {
                font-size: 14px;
            }

            .auth-submit-btn {
                padding: 16px;
                font-size: 15px;
            }

            .benefit-item {
                padding: 16px;
            }

            .auth-stats {
                padding: 16px;
            }
        }

        @@media (max-height: 700px) {
            .auth-wrapper {
                height: 100vh;
                max-height: none;
            }

            .auth-left {
                overflow-y: auto;
            }

            .auth-benefits {
                margin-bottom: 20px;
            }

            .auth-stats {
                margin-bottom: 20px;
                padding: 16px;
            }

            .auth-testimonial {
                padding: 16px;
                margin-bottom: 20px;
            }
        }

        /* Scrollbar Styling */
        .auth-right::-webkit-scrollbar {
            width: 6px;
        }

        .auth-right::-webkit-scrollbar-track {
            background: var(--bg-light);
            border-radius: 3px;
        }

        .auth-right::-webkit-scrollbar-thumb {
            background: var(--border-color);
            border-radius: 3px;
        }

        .auth-right::-webkit-scrollbar-thumb:hover {
            background: var(--text-light);
        }

        .auth-left::-webkit-scrollbar {
            width: 6px;
        }

        .auth-left::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
        }

        .auth-left::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 3px;
        }

        .auth-left::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.5);
        }
    </style>
}

@section Scripts {
    <script>
        // Toggle password visibility
        function togglePassword(inputId) {
            const passwordInput = document.getElementById(inputId);
            const passwordIcon = inputId === 'Password'
                ? document.getElementById('passwordIcon')
                : document.getElementById('confirmPasswordIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                passwordIcon.classList.remove('fa-eye');
                passwordIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                passwordIcon.classList.remove('fa-eye-slash');
                passwordIcon.classList.add('fa-eye');
            }
        }

        // Password strength checker
        const passwordInput = document.getElementById('Password');
        const confirmPasswordInput = document.getElementById('ConfirmPassword');
        const strengthSegments = document.querySelectorAll('.strength-segment');
        const strengthText = document.getElementById('strengthText');
        const requirements = document.querySelectorAll('.requirement');
        const passwordMatchDiv = document.getElementById('passwordMatch');

        passwordInput.addEventListener('input', function() {
            const password = this.value;
            checkPasswordStrength(password);
            checkPasswordRequirements(password);
            checkPasswordMatch();
            validateField(this);
        });

        confirmPasswordInput.addEventListener('input', function() {
            checkPasswordMatch();
            validateField(this);
        });

        // Validate username and email on blur
        document.getElementById('UserName').addEventListener('blur', function() {
            validateField(this);
        });

        document.getElementById('Email').addEventListener('blur', function() {
            validateField(this);
        });

        function checkPasswordStrength(password) {
            let strength = 0;

            // Criteria
            if (password.length >= 8) strength++;
            if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength++;
            if (/\d/.test(password)) strength++;
            if (/[^a-zA-Z\d]/.test(password)) strength++;

            // Update visual
            strengthSegments.forEach((segment, index) => {
                if (index < strength) {
                    segment.classList.add('active');
                } else {
                    segment.classList.remove('active');
                }
            });

            // Update text
            const strengthLabels = ['Rất yếu', 'Yếu', 'Trung bình', 'Mạnh', 'Rất mạnh'];
            strengthText.textContent = strengthLabels[strength];

            // Update text color based on strength
            if (strength <= 1) {
                strengthText.style.color = '#ef4444';
            } else if (strength === 2) {
                strengthText.style.color = '#f59e0b';
            } else {
                strengthText.style.color = '#10b981';
            }
        }

        function checkPasswordRequirements(password) {
            const checks = {
                length: password.length >= 8,
                uppercase: /[a-z]/.test(password) && /[A-Z]/.test(password),
                number: /\d/.test(password),
                special: /[^a-zA-Z\d]/.test(password)
            };

            requirements.forEach(req => {
                const type = req.dataset.requirement;
                const icon = req.querySelector('i');

                if (checks[type]) {
                    req.classList.add('valid');
                    icon.classList.remove('fa-circle');
                    icon.classList.add('fa-check-circle');
                } else {
                    req.classList.remove('valid');
                    icon.classList.remove('fa-check-circle');
                    icon.classList.add('fa-circle');
                }
            });
        }

        function checkPasswordMatch() {
            const password = passwordInput.value;
            const confirmPassword = confirmPasswordInput.value;

            if (!confirmPassword) {
                passwordMatchDiv.classList.remove('valid');
                passwordMatchDiv.querySelector('#matchText').textContent = 'Mật khẩu khớp';
                return;
            }

            if (password === confirmPassword) {
                passwordMatchDiv.classList.add('valid');
                passwordMatchDiv.querySelector('#matchText').textContent = 'Mật khẩu khớp ✓';
            } else {
                passwordMatchDiv.classList.remove('valid');
                passwordMatchDiv.querySelector('#matchText').textContent = 'Mật khẩu không khớp ✗';
            }
        }

        function validateField(field) {
            const value = field.value.trim();
            const inputContainer = field.closest('.input-container');
            const validIcon = inputContainer?.querySelector('.valid-icon');
            const invalidIcon = inputContainer?.querySelector('.invalid-icon');

            // Remove previous validation states
            inputContainer?.classList.remove('valid', 'invalid');

            if (!value) {
                if (validIcon) validIcon.style.display = 'none';
                if (invalidIcon) invalidIcon.style.display = 'none';
                return;
            }

            let isValid = false;

            if (field.id === 'UserName') {
                isValid = /^[a-zA-Z0-9_]{4,20}$/.test(value);
            } else if (field.id === 'Email') {
                isValid = /^[^\s]+[^\s]+\.[^\s]+$/.test(value);
            } else if (field.id === 'Password') {
                isValid = validatePassword(value);
            } else if (field.id === 'ConfirmPassword') {
                isValid = value === passwordInput.value;
            }

            if (isValid) {
                inputContainer?.classList.add('valid');
                if (validIcon) validIcon.style.display = 'block';
                if (invalidIcon) invalidIcon.style.display = 'none';
            } else {
                inputContainer?.classList.add('invalid');
                if (validIcon) validIcon.style.display = 'none';
                if (invalidIcon) invalidIcon.style.display = 'block';
            }
        }

        function validatePassword(password) {
            return password.length >= 8 &&
                   /[a-z]/.test(password) &&
                   /[A-Z]/.test(password) &&
                   /\d/.test(password);
        }

        // Form submission
        document.getElementById('registerForm').addEventListener('submit', function(e) {
            const registerBtn = document.getElementById('registerButton');
            const loadingOverlay = document.getElementById('loadingOverlay');
            const termsAgreement = document.getElementById('termsAgreement');

            // Validate terms agreement
            if (!termsAgreement.checked) {
                e.preventDefault();
                showToast('Vui lòng đồng ý với Điều khoản dịch vụ và Chính sách bảo mật', 'error');
                termsAgreement.focus();
                return;
            }

            // Validate password match
            if (passwordInput.value !== confirmPasswordInput.value) {
                e.preventDefault();
                showToast('Mật khẩu không khớp. Vui lòng kiểm tra lại', 'error');
                confirmPasswordInput.focus();
                return;
            }

            // Show loading state
            if (registerBtn && loadingOverlay) {
                registerBtn.innerHTML = `
                    <span class="btn-text">Đang tạo tài khoản...</span>
                    <span class="btn-icon">
                        <i class="fas fa-spinner fa-spin"></i>
                    </span>
                `;
                registerBtn.disabled = true;
                loadingOverlay.style.display = 'flex';
            }

            // Form will submit normally
            // In a real app, you might want to use AJAX here
        });

        // Toast notification
        function showToast(message, type = 'info') {
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            toast.innerHTML = `
                <div class="toast-content">
                    <i class="fas fa-${type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i>
                    <span>${message}</span>
                </div>
                <button class="toast-close" onclick="this.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </button>
            `;

            // Add styles if not already added
            if (!document.getElementById('toast-styles')) {
                const style = document.createElement('style');
                style.id = 'toast-styles';
                style.textContent = `
                    .toast {
                        position: fixed;
                        top: 20px;
                        right: 20px;
                        background: white;
                        border-radius: var(--radius-md);
                        padding: 16px;
                        box-shadow: var(--shadow-lg);
                        display: flex;
                        align-items: center;
                        gap: 12px;
                        z-index: 10000;
                        animation: slideInRight 0.3s ease;
                        max-width: 400px;
                        border-left: 4px solid var(--primary-color);
                    }
                    .toast-success { border-left-color: #10b981; }
                    .toast-info { border-left-color: var(--primary-color); }
                    .toast-error { border-left-color: #ef4444; }
                    .toast-content { display: flex; align-items: center; gap: 10px; }
                    .toast-content i { font-size: 18px; }
                    .toast-success .toast-content i { color: #10b981; }
                    .toast-info .toast-content i { color: var(--primary-color); }
                    .toast-error .toast-content i { color: #ef4444; }
                    .toast-close { background: none; border: none; color: #999; cursor: pointer; }
                    @@keyframes slideInRight {
                        from { transform: translateX(100%); opacity: 0; }
                        to { transform: translateX(0); opacity: 1; }
                    }
                    @@keyframes slideOutRight {
                        from { transform: translateX(0); opacity: 1; }
                        to { transform: translateX(100%); opacity: 0; }
                    }
                `;
                document.head.appendChild(style);
            }

            document.body.appendChild(toast);

            // Auto remove after 5 seconds
            setTimeout(() => {
                if (toast.parentElement) {
                    toast.style.animation = 'slideOutRight 0.3s ease forwards';
                    setTimeout(() => toast.remove(), 300);
                }
            }, 5000);
        }

        // Auto-focus username input on page load
        document.addEventListener('DOMContentLoaded', function() {
            const usernameInput = document.getElementById('UserName');
            if (usernameInput) {
                setTimeout(() => usernameInput.focus(), 300);
            }

            // Social login buttons (placeholder functionality)
            document.querySelectorAll('.social-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    showToast('Tính năng đăng ký với mạng xã hội đang được phát triển', 'info');
                });
            });
        });
    </script>

    @Scripts.Render("~/bundles/jqueryval")
}