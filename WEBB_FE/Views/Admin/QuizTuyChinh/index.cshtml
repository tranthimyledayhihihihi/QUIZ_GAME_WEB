@model List<WEBB.Models.Admin.QuizTuyChinhDto>
@{
    ViewBag.Title = "Quiz Tùy Chỉnh";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-lg-4">
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-5 pt-3">
        <div>
            <div class="d-flex align-items-center">
                <div class="icon-shape bg-gradient-primary rounded-circle p-3 mr-3 shadow">
                    <i class="fas fa-puzzle-piece fa-2x text-white"></i>
                </div>
                <div>
                    <h1 class="h3 mb-1 text-gray-900 font-weight-800">Quiz Tùy Chỉnh (UGC)</h1>
                    <p class="mb-0 text-gray-600">Quản lý nội dung do người dùng tạo ra</p>
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge badge-pill badge-light border mr-3 px-3 py-2">
                <i class="fas fa-layer-group mr-2"></i>
                <span id="totalCount">@Model.Count</span> quiz
                <span id="pendingCount" class="ml-2 badge badge-warning">
                    @Model.Count(q => q.TrangThai == "Pending")
                </span>
            </span>
        </div>
    </div>

    <!-- Bộ lọc và thống kê -->
    <div class="row mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap align-items-center">
                        <form method="get" id="filterForm" class="form-inline">
                            <div class="d-flex align-items-center">
                                <label class="font-weight-bold text-gray-700 mr-3 mb-0">
                                    <i class="fas fa-filter mr-2 text-primary"></i>Lọc theo trạng thái:
                                </label>
                                <div class="input-group shadow-sm" style="width: 180px;">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-white border-right-0">
                                            <i class="fas fa-flag text-primary"></i>
                                        </span>
                                    </div>
                                    <select name="status" class="form-control border-left-0"
                                            onchange="document.getElementById('filterForm').submit()">
                                        <option value="">Tất cả trạng thái</option>
                                        <option value="Pending" @(ViewBag.Status == "Pending" ? "selected" : "")>Chờ duyệt</option>
                                        <option value="Approved" @(ViewBag.Status == "Approved" ? "selected" : "")>Đã duyệt</option>
                                        <option value="Rejected" @(ViewBag.Status == "Rejected" ? "selected" : "")>Từ chối</option>
                                    </select>
                                </div>
                            </div>
                        </form>
                        <div class="ml-4 d-flex">
                            <button class="btn btn-outline-primary btn-sm mr-2" onclick="resetFilter()">
                                <i class="fas fa-redo mr-1"></i>Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-1 text-gray-700">Quiz hôm nay</h6>
                            <div class="h4 mb-0 font-weight-bold text-primary">
                                @Model.Count(q => q.NgayTao.Date == DateTime.Today)
                            </div>
                        </div>
                        <div class="icon-circle bg-primary-light">
                            <i class="fas fa-calendar-day text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê nhanh -->
    <div class="row mb-5">
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-warning-light rounded-circle mr-3">
                            <i class="fas fa-clock text-warning"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Chờ duyệt</h6>
                            <h3 class="font-weight-bold mb-0 text-warning" id="statPending">
                                @Model.Count(q => q.TrangThai == "Pending")
                            </h3>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height: 5px;">
                        @{
                            var pendingPercent = Model.Count > 0 ?
                                (Model.Count(q => q.TrangThai == "Pending") * 100 / Model.Count) : 0;
                        }
                        <div class="progress-bar bg-warning" role="progressbar"
                             style="width: @pendingPercent%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-success-light rounded-circle mr-3">
                            <i class="fas fa-check-circle text-success"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Đã duyệt</h6>
                            <h3 class="font-weight-bold mb-0 text-success" id="statApproved">
                                @Model.Count(q => q.TrangThai == "Approved")
                            </h3>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height: 5px;">
                        @{
                            var approvedPercent = Model.Count > 0 ?
                                (Model.Count(q => q.TrangThai == "Approved") * 100 / Model.Count) : 0;
                        }
                        <div class="progress-bar bg-success" role="progressbar"
                             style="width: @approvedPercent%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-danger-light rounded-circle mr-3">
                            <i class="fas fa-times-circle text-danger"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Từ chối</h6>
                            <h3 class="font-weight-bold mb-0 text-danger" id="statRejected">
                                @Model.Count(q => q.TrangThai == "Rejected")
                            </h3>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height: 5px;">
                        @{
                            var rejectedPercent = Model.Count > 0 ?
                                (Model.Count(q => q.TrangThai == "Rejected") * 100 / Model.Count) : 0;
                        }
                        <div class="progress-bar bg-danger" role="progressbar"
                             style="width: @rejectedPercent%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-info-light rounded-circle mr-3">
                            <i class="fas fa-users text-info"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1">Người tạo</h6>
                            <h3 class="font-weight-bold mb-0 text-info" id="statCreators">
                                @Model.Select(q => q.NguoiTao).Distinct().Count()
                            </h3>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height: 5px;">
                        <div class="progress-bar bg-info" role="progressbar" style="width: 100%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG DỮ LIỆU -->
    <div class="card shadow-lg border-0 animate__animated animate__fadeIn">
        <div class="card-header bg-gradient-primary border-0 py-4">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-white">
                    <i class="fas fa-list mr-2"></i>Danh sách Quiz
                    <small class="ml-2">(@Model.Count items)</small>
                </h6>
                <div class="d-flex align-items-center">
                    <div class="input-group input-group-sm" style="width: 200px;">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search text-gray-400"></i>
                            </span>
                        </div>
                        <input type="text" class="form-control" id="searchInput"
                               placeholder="Tìm kiếm quiz...">
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="quizTable">
                        <thead class="thead-light">
                            <tr>
                                <th width="25%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Tên Quiz</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('name')"></i>
                                    </div>
                                </th>
                                <th width="25%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Mô tả</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('description')"></i>
                                    </div>
                                </th>
                                <th width="15%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Người tạo</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('creator')"></i>
                                    </div>
                                </th>
                                <th width="15%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Ngày tạo</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('date')"></i>
                                    </div>
                                </th>
                                <th width="10%" class="py-3 border-top-0">
                                    <div class="d-flex align-items-center">
                                        <span>Trạng thái</span>
                                        <i class="fas fa-sort ml-2 text-gray-400 cursor-pointer"
                                           onclick="sortTable('status')"></i>
                                    </div>
                                </th>
                                <th width="20%" class="py-3 border-top-0 text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model)
                            {
                                <tr class="quiz-row"
                                    data-name="@q.TenQuiz.ToLower()"
                                    data-description="@(q.MoTa?.ToLower() ?? "")"
                                    data-creator="@q.NguoiTao.ToLower()"
                                    data-status="@q.TrangThai.ToLower()">
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div class="quiz-icon mr-3">
                                                <i class="fas fa-puzzle-piece @GetStatusIconColor(q.TrangThai)"></i>
                                            </div>
                                            <div>
                                                <div class="font-weight-bold text-gray-800 quiz-title">@q.TenQuiz</div>
                                                <small class="text-muted">
                                                    <i class="fas fa-hashtag mr-1"></i>ID: @q.QuizTuyChinhID
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div class="truncate-text" style="max-height: 48px; overflow: hidden;">
                                            @if (!string.IsNullOrEmpty(q.MoTa))
                                            {
                                                @q.MoTa
                                            }
                                            else
                                            {
                                                <span class="text-muted font-italic">
                                                    <i class="fas fa-minus mr-1"></i>Không có mô tả
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar avatar-xs mr-2">
                                                <div class="avatar-initials bg-primary text-white">
                                                    @GetInitials(q.NguoiTao)
                                                </div>
                                            </div>
                                            <div>
                                                <div class="font-weight-bold text-gray-800">@q.NguoiTao</div>
                                                <small class="text-muted">Người dùng</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <div class="text-gray-800">@q.NgayTao.ToString("dd/MM/yyyy")</div>
                                        <small class="text-muted">@q.NgayTao.ToString("HH:mm")</small>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge badge-pill @GetStatusBadgeClass(q.TrangThai) px-3 py-2">
                                            <i class="@GetStatusIcon(q.TrangThai) mr-1"></i>
                                            @q.TrangThai
                                        </span>
                                    </td>
                                    <td class="align-middle text-center">
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-outline-info btn-sm rounded-circle mr-2"
                                                    title="Xem chi tiết"
                                                    onclick="showQuizDetail('@q.QuizTuyChinhID')">
                                                <i class="fas fa-eye"></i>
                                            </button>

                                            @if (q.TrangThai == "Pending")
                                            {
                                                <button class="btn btn-outline-success btn-sm rounded-circle mr-2"
                                                        title="Duyệt quiz"
                                                        onclick="approveQuiz('@q.QuizTuyChinhID', '@q.TenQuiz.Replace("'", "\\'")')">
                                                    <i class="fas fa-check"></i>
                                                </button>

                                                <button class="btn btn-outline-warning btn-sm rounded-circle mr-2"
                                                        title="Từ chối quiz"
                                                        onclick="rejectQuiz('@q.QuizTuyChinhID', '@q.TenQuiz.Replace("'", "\\'")')">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            }

                                            @if (User.IsInRole("SuperAdmin"))
                                            {
                                                <button class="btn btn-outline-danger btn-sm rounded-circle"
                                                        title="Xóa quiz"
                                                        onclick="deleteQuiz('@q.QuizTuyChinhID', '@q.TenQuiz.Replace("'", "\\'")')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Phân trang -->
                <div class="d-flex justify-content-between align-items-center p-4 border-top">
                    <div class="text-muted">
                        Hiển thị <span id="visibleItems">@Model.Count</span> trên tổng số @Model.Count quiz
                    </div>
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item disabled">
                                <a class="page-link" href="#" tabindex="-1">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="#">1</a></li>
                            <li class="page-item disabled">
                                <a class="page-link" href="#">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
            else
            {
                <div class="text-center py-6">
                    <div class="empty-state">
                        <div class="empty-state-icon bg-gradient-primary">
                            <i class="fas fa-puzzle-piece"></i>
                        </div>
                        <h3 class="mt-4 text-gray-700">Không có quiz nào</h3>
                        <p class="text-gray-500 mb-4">Không tìm thấy quiz phù hợp với bộ lọc</p>
                        <button class="btn btn-primary" onclick="resetFilter()">
                            <i class="fas fa-redo mr-2"></i>Hiển thị tất cả
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal Chi tiết Quiz -->
<div class="modal fade" id="quizDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-gradient-primary border-0">
                <h5 class="modal-title text-white">
                    <i class="fas fa-info-circle mr-2"></i>Chi tiết Quiz
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4" id="quizDetailContent">
                <!-- Nội dung sẽ được load bằng JS -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Xác nhận -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header" id="confirmModalHeader">
                <h5 class="modal-title" id="confirmModalTitle"></h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <div id="confirmIcon" class="rounded-circle d-inline-flex p-4 mb-3"></div>
                    <h5 class="font-weight-bold text-gray-800" id="confirmMessage"></h5>
                    <p class="text-muted" id="confirmDescription"></p>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light px-4" data-dismiss="modal">
                    <i class="fas fa-times mr-2"></i>Hủy bỏ
                </button>
                <button type="button" class="btn px-4" id="confirmActionBtn">
                    <i class="fas fa-check mr-2"></i>Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Toast notification -->
<div aria-live="polite" aria-atomic="true" class="position-relative">
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div id="successToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header bg-gradient-success text-white border-0">
                <i class="fas fa-check-circle mr-2"></i>
                <strong class="me-auto">Thành công!</strong>
                <small>Vừa xong</small>
                <button type="button" class="ml-2 mb-1 close text-white" data-dismiss="toast">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="toast-body bg-white" id="toastMessage"></div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        switch (status)
        {
            case "Approved":
                return "badge-success";
            case "Rejected":
                return "badge-danger";
            default:
                return "badge-warning";
        }
    }


    public string GetStatusIconColor(string status)
    {
        switch (status)
        {
            case "Approved":
                return "text-success";
            case "Rejected":
                return "text-danger";
            default:
                return "text-warning";
        }
    }


    public string GetStatusIcon(string status)
    {
        switch (status)
        {
            case "Approved":
                return "fas fa-check-circle";
            case "Rejected":
                return "fas fa-times-circle";
            default:
                return "fas fa-clock";
        }
    }


    public string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "??";

        // C# 7.3: phải truyền char[] thay vì char
        var names = fullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);

        if (names.Length >= 2)
        {
            // C# 7.3: không dùng ^1
            char first = names[0][0];
            char last = names[names.Length - 1][0];
            return (first.ToString() + last.ToString()).ToUpper();
        }

        // Không dùng range [..2]
        return fullName.Length >= 2
            ? fullName.Substring(0, 2).ToUpper()
            : fullName.ToUpper();
    }

}

<style>
    /* CSS Variables */
    :root {
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        --info-gradient: linear-gradient(135deg, #17a2b8 0%, #20c997 100%);
        --success-gradient: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        --warning-gradient: linear-gradient(135deg, #ffc107 0%, #ff9900 100%);
        --danger-gradient: linear-gradient(135deg, #f5365c 0%, #f56036 100%);
        --shadow-sm: 0 .125rem .25rem rgba(0,0,0,.075);
        --shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        --shadow-lg: 0 1rem 3rem rgba(0,0,0,.175);
    }

    /* Custom Styles */
    body {
        background: linear-gradient(135deg, #f8f9fc 0%, #e9ecef 100%);
        min-height: 100vh;
    }

    .card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-lg);
    }

    .card-header {
        border-radius: 1rem 1rem 0 0 !important;
    }

    .bg-gradient-primary {
        background: var(--primary-gradient);
    }

    /* Badge styles */
    .badge-success {
        background: var(--success-gradient);
    }

    .badge-warning {
        background: var(--warning-gradient);
    }

    .badge-danger {
        background: var(--danger-gradient);
    }

    /* Icon shapes */
    .icon-shape {
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .bg-primary-light {
        background-color: rgba(102, 126, 234, 0.1);
    }

    .bg-success-light {
        background-color: rgba(40, 167, 69, 0.1);
    }

    .bg-warning-light {
        background-color: rgba(255, 193, 7, 0.1);
    }

    .bg-danger-light {
        background-color: rgba(245, 54, 92, 0.1);
    }

    .bg-info-light {
        background-color: rgba(23, 162, 184, 0.1);
    }

    /* Stat icons */
    .stat-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    /* Quiz icon */
    .quiz-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background-color: rgba(102, 126, 234, 0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    /* Avatar */
    .avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: 600;
    }

    .avatar-xs {
        width: 32px;
        height: 32px;
        font-size: 0.75rem;
    }

    .avatar-initials {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
    }

    /* Table styles */
    .table {
        margin-bottom: 0;
    }

    .table thead th {
        border-top: none;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        color: #4a5568;
        background-color: #f8f9fe;
    }

    .table tbody tr {
        transition: all 0.3s;
        border-left: 3px solid transparent;
    }

    .table tbody tr:hover {
        background-color: #f8f9fe;
        border-left-color: #667eea;
        transform: translateX(2px);
    }

    /* Form controls */
    .input-group-text {
        border-radius: 0.5rem 0 0 0.5rem;
        border-right: none;
        transition: all 0.3s;
    }

    .form-control {
        border-radius: 0 0.5rem 0.5rem 0;
        border-left: none;
        transition: all 0.3s;
    }

    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
        border-color: #667eea;
    }

    .input-group:focus-within .input-group-text {
        border-color: #667eea;
        background-color: rgba(102, 126, 234, 0.1);
    }

    /* Buttons */
    .btn {
        border-radius: 0.5rem;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-outline-success:hover {
        background: var(--success-gradient);
        color: white;
        border: none;
        transform: translateY(-1px);
    }

    .btn-outline-warning:hover {
        background: var(--warning-gradient);
        color: white;
        border: none;
        transform: translateY(-1px);
    }

    .btn-outline-danger:hover {
        background: var(--danger-gradient);
        color: white;
        border: none;
        transform: translateY(-1px);
    }

    .btn-outline-info:hover {
        background: var(--info-gradient);
        color: white;
        border: none;
        transform: translateY(-1px);
    }

    .btn-rounded-circle {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* Empty state */
    .empty-state {
        padding: 3rem 1rem;
    }

    .empty-state-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 1.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
    }

    /* Cursor */
    .cursor-pointer {
        cursor: pointer;
    }

    /* Animation */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate__animated {
        animation-duration: 0.6s;
        animation-fill-mode: both;
    }

    .animate__fadeInUp {
        animation-name: fadeInUp;
    }

    /* Scrollbar */
    .table-responsive::-webkit-scrollbar {
        height: 8px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: var(--primary-gradient);
        border-radius: 10px;
    }

    /* Progress bars */
    .progress {
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar {
        border-radius: 10px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .card-body {
            padding: 1.5rem;
        }

        .table-responsive {
            font-size: 0.9rem;
        }

        .btn-group {
            flex-wrap: wrap;
            gap: 5px;
        }

        .btn-rounded-circle {
            width: 34px;
            height: 34px;
        }
    }
</style>

<script>
    // Khởi tạo các biến
    let currentSort = { column: 'date', direction: 'desc' };
    let pendingAction = null;
    let currentQuizId = null;

    // Reset filter
    function resetFilter() {
        window.location.href = window.location.pathname;
    }

    // Hiển thị chi tiết quiz
    function showQuizDetail(quizId) {
        // Giả lập dữ liệu chi tiết
        const row = document.querySelector(`[data-name*="${quizId}"]`);
        if (!row) return;

        const quizTitle = row.querySelector('.quiz-title').textContent;
        const creator = row.cells[2].querySelector('.font-weight-bold').textContent;
        const date = row.cells[3].querySelector('.text-gray-800').textContent;
        const time = row.cells[3].querySelector('.text-muted').textContent;
        const description = row.cells[1].textContent;
        const status = row.cells[4].querySelector('.badge').textContent.trim();

        const detailContent = document.getElementById('quizDetailContent');
        detailContent.innerHTML = `
            <div class="text-center mb-4">
                <div class="quiz-icon mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
                    <i class="fas fa-puzzle-piece ${status === 'Đã duyệt' ? 'text-success' : status === 'Từ chối' ? 'text-danger' : 'text-warning'}"></i>
                </div>
                <h4 class="font-weight-bold text-gray-800">${quizTitle}</h4>
                <p class="text-muted mb-0">ID: ${quizId}</p>
            </div>

            <div class="row mb-4">
                <div class="col-md-6 mb-3">
                    <div class="bg-light rounded p-3">
                        <h6 class="font-weight-bold text-gray-700 mb-2">
                            <i class="fas fa-user mr-2 text-primary"></i>Thông tin người tạo
                        </h6>
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-md mr-3">
                                <div class="avatar-initials bg-primary text-white">
                                    ${creator.split(' ').map(n => n[0]).join('').toUpperCase().substring(0, 2)}
                                </div>
                            </div>
                            <div>
                                <div class="font-weight-bold text-gray-800">${creator}</div>
                                <small class="text-muted">Người dùng</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <div class="bg-light rounded p-3">
                        <h6 class="font-weight-bold text-gray-700 mb-2">
                            <i class="fas fa-calendar-alt mr-2 text-primary"></i>Thời gian
                        </h6>
                        <div>
                            <div class="font-weight-bold text-gray-800">
                                <i class="far fa-calendar mr-2"></i>${date}
                            </div>
                            <small class="text-muted">
                                <i class="far fa-clock mr-2"></i>${time}
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-light rounded p-3 mb-4">
                <h6 class="font-weight-bold text-gray-700 mb-2">
                    <i class="fas fa-align-left mr-2 text-primary"></i>Mô tả
                </h6>
                <p class="mb-0">${description || 'Không có mô tả'}</p>
            </div>

            <div class="bg-light rounded p-3">
                <h6 class="font-weight-bold text-gray-700 mb-2">
                    <i class="fas fa-chart-bar mr-2 text-primary"></i>Thống kê giả lập
                </h6>
                <div class="row text-center">
                    <div class="col-4">
                        <div class="h4 font-weight-bold text-primary">${Math.floor(Math.random() * 50)}</div>
                        <small class="text-muted">Câu hỏi</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 font-weight-bold text-success">${Math.floor(Math.random() * 100)}</div>
                        <small class="text-muted">Lượt chơi</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 font-weight-bold text-warning">${Math.floor(Math.random() * 30) + 70}%</div>
                        <small class="text-muted">Độ khó</small>
                    </div>
                </div>
            </div>
        `;

        $('#quizDetailModal').modal('show');
    }

    // Xử lý duyệt quiz
    function approveQuiz(quizId, quizName) {
        currentQuizId = quizId;
        pendingAction = 'approve';

        document.getElementById('confirmModalHeader').className = 'modal-header bg-gradient-success border-0';
        document.getElementById('confirmModalTitle').innerHTML = '<i class="fas fa-check-circle mr-2"></i>Duyệt Quiz';
        document.getElementById('confirmIcon').innerHTML = '<i class="fas fa-check-circle fa-3x text-success"></i>';
        document.getElementById('confirmIcon').className = 'bg-success-light rounded-circle d-inline-flex p-4 mb-3';
        document.getElementById('confirmMessage').textContent = `Duyệt quiz "${quizName}"?`;
        document.getElementById('confirmDescription').textContent = 'Quiz sẽ được công khai và người dùng có thể chơi.';
        document.getElementById('confirmActionBtn').className = 'btn btn-success px-4';
        document.getElementById('confirmActionBtn').innerHTML = '<i class="fas fa-check mr-2"></i>Duyệt ngay';

        $('#confirmModal').modal('show');
    }

    // Xử lý từ chối quiz
    function rejectQuiz(quizId, quizName) {
        currentQuizId = quizId;
        pendingAction = 'reject';

        document.getElementById('confirmModalHeader').className = 'modal-header bg-gradient-warning border-0';
        document.getElementById('confirmModalTitle').innerHTML = '<i class="fas fa-times-circle mr-2"></i>Từ chối Quiz';
        document.getElementById('confirmIcon').innerHTML = '<i class="fas fa-times-circle fa-3x text-warning"></i>';
        document.getElementById('confirmIcon').className = 'bg-warning-light rounded-circle d-inline-flex p-4 mb-3';
        document.getElementById('confirmMessage').textContent = `Từ chối quiz "${quizName}"?`;
        document.getElementById('confirmDescription').textContent = 'Quiz sẽ bị từ chối và không được công khai.';
        document.getElementById('confirmActionBtn').className = 'btn btn-warning px-4';
        document.getElementById('confirmActionBtn').innerHTML = '<i class="fas fa-times mr-2"></i>Từ chối';

        $('#confirmModal').modal('show');
    }

    // Xử lý xóa quiz
    function deleteQuiz(quizId, quizName) {
        currentQuizId = quizId;
        pendingAction = 'delete';

        document.getElementById('confirmModalHeader').className = 'modal-header bg-gradient-danger border-0';
        document.getElementById('confirmModalTitle').innerHTML = '<i class="fas fa-trash-alt mr-2"></i>Xóa Quiz';
        document.getElementById('confirmIcon').innerHTML = '<i class="fas fa-trash-alt fa-3x text-danger"></i>';
        document.getElementById('confirmIcon').className = 'bg-danger-light rounded-circle d-inline-flex p-4 mb-3';
        document.getElementById('confirmMessage').textContent = `Xóa quiz "${quizName}"?`;
        document.getElementById('confirmDescription').textContent = 'Hành động này không thể hoàn tác. Tất cả dữ liệu liên quan sẽ bị xóa vĩnh viễn.';
        document.getElementById('confirmActionBtn').className = 'btn btn-danger px-4';
        document.getElementById('confirmActionBtn').innerHTML = '<i class="fas fa-trash mr-2"></i>Xóa vĩnh viễn';

        $('#confirmModal').modal('show');
    }

    // Xác nhận hành động
    document.getElementById('confirmActionBtn').addEventListener('click', function() {
        if (!currentQuizId || !pendingAction) return;

        let actionUrl = '';
        let actionText = '';

        switch(pendingAction) {
            case 'approve':
                actionUrl = '@Url.Action("Approve")';
                actionText = 'Duyệt';
                break;
            case 'reject':
                actionUrl = '@Url.Action("Reject")';
                actionText = 'Từ chối';
                break;
            case 'delete':
                actionUrl = '@Url.Action("Delete")';
                actionText = 'Xóa';
                break;
        }

        // Disable button and show loading
        const btn = document.getElementById('confirmActionBtn');
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Đang xử lý...';
        btn.disabled = true;

        // Gửi request
        fetch(actionUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `id=${currentQuizId}`
        })
        .then(response => {
            if (response.ok) {
                // Update UI
                updateQuizStatus(currentQuizId, pendingAction);
                showToast(`${actionText} thành công!`);
                $('#confirmModal').modal('hide');
            } else {
                showToast('Có lỗi xảy ra!', 'error');
            }
        })
        .catch(error => {
            showToast('Lỗi kết nối!', 'error');
        })
        .finally(() => {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
            pendingAction = null;
            currentQuizId = null;
        });
    });

    // Cập nhật trạng thái quiz
    function updateQuizStatus(quizId, action) {
        const row = document.querySelector(`[data-name*="${quizId}"]`);
        if (!row) return;

        const statusCell = row.cells[4];
        const actionCell = row.cells[5];

        let newStatus, newBadgeClass, newIcon;

        switch(action) {
            case 'approve':
                newStatus = 'Approved';
                newBadgeClass = 'badge-success';
                newIcon = 'fas fa-check-circle';
                break;
            case 'reject':
                newStatus = 'Rejected';
                newBadgeClass = 'badge-danger';
                newIcon = 'fas fa-times-circle';
                break;
            case 'delete':
                // Xóa hàng
                row.classList.add('animate__animated', 'animate__fadeOut');
                setTimeout(() => {
                    row.remove();
                    updateStats();
                    updateVisibleCount();
                }, 500);
                return;
        }

        // Update status badge
        statusCell.innerHTML = `
            <span class="badge badge-pill ${newBadgeClass} px-3 py-2">
                <i class="${newIcon} mr-1"></i>
                ${newStatus}
            </span>
        `;

        // Update action buttons
        if (action === 'approve' || action === 'reject') {
            actionCell.innerHTML = `
                <div class="btn-group" role="group">
                    <button class="btn btn-outline-info btn-sm rounded-circle mr-2"
                            title="Xem chi tiết"
                            onclick="showQuizDetail('${quizId}')">
                        <i class="fas fa-eye"></i>
                    </button>
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <button class="btn btn-outline-danger btn-sm rounded-circle"
                                title="Xóa quiz"
                                onclick="deleteQuiz('${quizId}', '${row.cells[0].querySelector('.quiz-title').textContent}')">
                            <i class="fas fa-trash"></i>
                        </button>
                    }
                </div>
            `;
        }

        // Update stats
        updateStats();
    }

    // Cập nhật thống kê
    function updateStats() {
        const rows = document.querySelectorAll('.quiz-row');
        const total = rows.length;
        const pending = Array.from(rows).filter(row =>
            row.cells[4].querySelector('.badge').textContent.includes('Pending')
        ).length;
        const approved = Array.from(rows).filter(row =>
            row.cells[4].querySelector('.badge').textContent.includes('Approved')
        ).length;
        const rejected = Array.from(rows).filter(row =>
            row.cells[4].querySelector('.badge').textContent.includes('Rejected')
        ).length;

        document.getElementById('totalCount').textContent = total;
        document.getElementById('pendingCount').textContent = pending;
        document.getElementById('statPending').textContent = pending;
        document.getElementById('statApproved').textContent = approved;
        document.getElementById('statRejected').textContent = rejected;
    }

    // Hiển thị toast
    function showToast(message, type = 'success') {
        const toast = document.getElementById('successToast');
        const toastMessage = document.getElementById('toastMessage');

        if (type === 'error') {
            toast.querySelector('.toast-header').className = 'toast-header bg-gradient-danger text-white border-0';
            toast.querySelector('.fas').className = 'fas fa-exclamation-circle mr-2';
            toast.querySelector('.me-auto').textContent = 'Lỗi!';
        } else {
            toast.querySelector('.toast-header').className = 'toast-header bg-gradient-success text-white border-0';
            toast.querySelector('.fas').className = 'fas fa-check-circle mr-2';
            toast.querySelector('.me-auto').textContent = 'Thành công!';
        }

        toastMessage.textContent = message;

        const bsToast = new bootstrap.Toast(toast);
        bsToast.show();
    }

    // Sắp xếp bảng
    function sortTable(column) {
        const table = document.getElementById('quizTable');
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('.quiz-row'));

        // Đảo ngược hướng sắp xếp nếu click lại cùng cột
        if (currentSort.column === column) {
            currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
        } else {
            currentSort.column = column;
            currentSort.direction = 'asc';
        }

        rows.sort((a, b) => {
            let aValue, bValue;

            switch(column) {
                case 'name':
                    aValue = a.querySelector('.quiz-title').textContent.toLowerCase();
                    bValue = b.querySelector('.quiz-title').textContent.toLowerCase();
                    break;
                case 'description':
                    aValue = a.cells[1].textContent.toLowerCase();
                    bValue = b.cells[1].textContent.toLowerCase();
                    break;
                case 'creator':
                    aValue = a.cells[2].querySelector('.font-weight-bold').textContent.toLowerCase();
                    bValue = b.cells[2].querySelector('.font-weight-bold').textContent.toLowerCase();
                    break;
                case 'date':
                    aValue = new Date(a.cells[3].querySelector('.text-gray-800').textContent.split('/').reverse().join('-'));
                    bValue = new Date(b.cells[3].querySelector('.text-gray-800').textContent.split('/').reverse().join('-'));
                    break;
                case 'status':
                    aValue = a.cells[4].querySelector('.badge').textContent.toLowerCase();
                    bValue = b.cells[4].querySelector('.badge').textContent.toLowerCase();
                    break;
            }

            if (currentSort.direction === 'asc') {
                return aValue > bValue ? 1 : -1;
            } else {
                return aValue < bValue ? 1 : -1;
            }
        });

        // Xóa và thêm lại các hàng đã sắp xếp
        rows.forEach(row => tbody.appendChild(row));

        // Cập nhật icon sắp xếp
        updateSortIcons(column);
    }

    function updateSortIcons(currentColumn) {
        document.querySelectorAll('.fa-sort').forEach(icon => {
            icon.classList.remove('fa-sort-up', 'fa-sort-down');
            icon.classList.add('fa-sort');
        });

        const currentIcon = document.querySelector(`[onclick="sortTable('${currentColumn}")"]`);
        if (currentIcon) {
            currentIcon.classList.remove('fa-sort');
            currentIcon.classList.add(currentSort.direction === 'asc' ? 'fa-sort-up' : 'fa-sort-down');
        }
    }

    // Tìm kiếm
    document.getElementById('searchInput')?.addEventListener('input', function(e) {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll('#quizTable .quiz-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const name = row.getAttribute('data-name');
            const description = row.getAttribute('data-description');
            const creator = row.getAttribute('data-creator');
            const searchText = `${name} ${description} ${creator}`;

            if (searchText.includes(searchTerm)) {
                row.style.display = '';
                visibleCount++;

                // Highlight kết quả tìm kiếm
                if (searchTerm) {
                    const quizTitle = row.querySelector('.quiz-title');
                    const originalTitle = quizTitle.getAttribute('data-original') || quizTitle.textContent;
                    quizTitle.setAttribute('data-original', originalTitle);
                    const highlighted = originalTitle.replace(
                        new RegExp(searchTerm, 'gi'),
                        match => `<span class="bg-warning text-dark px-1 rounded">${match}</span>`
                    );
                    quizTitle.innerHTML = highlighted;
                }
            } else {
                row.style.display = 'none';

                // Khôi phục text gốc
                const quizTitle = row.querySelector('.quiz-title');
                if (quizTitle && quizTitle.getAttribute('data-original')) {
                    quizTitle.textContent = quizTitle.getAttribute('data-original');
                }
            }
        });

        document.getElementById('visibleItems').textContent = visibleCount;
    });

    // Cập nhật số lượng hiển thị
    function updateVisibleCount() {
        const visibleCount = document.querySelectorAll('#quizTable .quiz-row:not([style*="display: none"])').length;
        document.getElementById('visibleItems').textContent = visibleCount;
    }

    // Khởi tạo
    document.addEventListener('DOMContentLoaded', function() {
        // Update visible count
        updateVisibleCount();

        // Add click handlers for table rows
        document.querySelectorAll('.quiz-row').forEach(row => {
            row.addEventListener('click', function(e) {
                if (!e.target.closest('.btn')) {
                    const quizId = this.cells[0].querySelector('.text-muted').textContent.replace('ID: ', '');
                    showQuizDetail(quizId);
                }
            });
        });
    });
</script>