            opacity: 0.9;
            text-align: right;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .auth-wrapper {
                grid-template-columns: 1fr;
                min-height: auto;
            }

            .logo-brand-mobile {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 24px;
                justify-content: center;
            }

            .logo-brand {
                display: none;
            }

            .social-login {
                grid-template-columns: 1fr;
            }

            .benefits-list,
            .testimonial {
                display: none;
            }
        }

        @@media (max-width: 768px) {
            .auth-form-section {
                padding: 24px;
            }

            .register-illustration {
                padding: 40px 24px;
            }

            .form-title {
                font-size: 28px;
            }

            .row {
                flex-direction: column;
            }

            .col-md-6 {
                width: 100%;
            }
