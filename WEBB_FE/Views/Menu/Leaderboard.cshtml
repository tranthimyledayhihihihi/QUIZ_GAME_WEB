@model WEBB.Models.ViewModels.LeaderboardViewModel
@{
    ViewBag.Title = "Bảng Xếp Hạng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-lg-5 py-4" style="background: linear-gradient(135deg, #f8f9ff 0%, #f0f2ff 100%); min-height: 100vh;">

    <!-- Header Section -->
    <div class="text-center mb-5">
        <div class="trophy-container mb-3">
            <div class="trophy-icon mx-auto">
                <i class="fas fa-trophy"></i>
            </div>
        </div>
        <h1 class="fw-bold mb-2 text-gradient">Bảng Xếp Hạng</h1>
        <p class="text-muted mb-0">Top những người chơi xuất sắc nhất</p>
    </div>

    <!-- Time Period Selector -->
    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-3">
                        <div class="period-selector w-100">
                            <div class="nav nav-pills nav-fill" id="periodTabs" role="tablist">
                                <a class="nav-link @(Model.Type == "monthly" ? "active" : "")"
                                   href="@Url.Action("Index", "Leaderboard", new { type = "monthly", page = 1 })"
                                   style="border-radius: 15px;">
                                    <div class="d-flex flex-column align-items-center py-2">
                                        <i class="fas fa-calendar-alt mb-2 fa-lg"></i>
                                        <span class="fw-semibold">Tháng</span>
                                        <small class="text-muted">Top tháng này</small>
                                    </div>
                                </a>
                                <a class="nav-link @(Model.Type == "yearly" ? "active" : "")"
                                   href="@Url.Action("Index", "Leaderboard", new { type = "yearly", page = 1 })"
                                   style="border-radius: 15px;">
                                    <div class="d-flex flex-column align-items-center py-2">
                                        <i class="fas fa-calendar-star mb-2 fa-lg"></i>
                                        <span class="fw-semibold">Năm</span>
                                        <small class="text-muted">Top cả năm</small>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Error Message -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm mb-4" role="alert">
            <i class="fas fa-exclamation-triangle me-3 fa-lg"></i>
            <div class="flex-grow-1">@ViewBag.Error</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Leaderboard List -->
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="card border-0 shadow-lg overflow-hidden">
                <div class="card-header bg-white border-0 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-semibold">
                            <i class="fas fa-ranking-star me-2 text-primary"></i>
                            @(Model.Type == "monthly" ? "Xếp hạng tháng" : "Xếp hạng năm")
                        </h5>
                        <span class="badge bg-primary bg-opacity-10 text-primary">
                            @Model.Items.Count người chơi
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <!-- Top 3 Badges -->
                    @if (Model.Items.Any())
                    {
                        <div class="top-three-section p-4 bg-light">
                            <div class="row">
                                @{
                                    var top3 = Model.Items.Take(3).ToList();
                                    var positions = new[] { "second", "first", "third" };

                                    for (int i = 0; i < Math.Min(3, top3.Count); i++)
                                    {
                                        var item = top3[i];
                                        var rank = Model.Type == "monthly" ? item.HangThang : item.HangNam;
                                        var score = Model.Type == "monthly" ? item.DiemThang : item.DiemNam;
                                        var position = positions[i];

                                        <div class="col-md-4 mb-3 mb-md-0">
                                            <div class="top-three-card @position text-center p-3 rounded-3 h-100">
                                                <div class="medal mb-3">
                                                    @if (i == 0)
                                                    {
                                                        <i class="fas fa-crown fa-2x text-warning"></i>
                                                    }
                                                    else if (i == 1)
                                                    {
                                                        <i class="fas fa-medal fa-2x text-secondary"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="fas fa-award fa-2x text-orange"></i>
                                                    }
                                                </div>
                                                <div class="avatar-wrapper mb-3">
                                                    <img src="@(string.IsNullOrEmpty(item.AnhDaiDien)
                                                                ? Url.Content("~/images/logo-quiz.jpg")
                                                                : item.AnhDaiDien)"
                                                         class="rounded-circle border border-3
                                                                @(i == 0 ? "border-warning" :
                                                                  i == 1 ? "border-secondary" : "border-orange")"
                                                         style="width: 80px; height: 80px;" />
                                                    @if (item.IsOnline)
                                                    {
                                                        <div class="online-indicator bg-success"></div>
                                                    }
                                                </div>
                                                <h6 class="fw-bold mb-1">@item.TenHienThi</h6>
                                                <div class="score-display mb-2">
                                                    <span class="badge @(i == 0 ? "bg-warning" :
                                                                         i == 1 ? "bg-secondary" : "bg-orange")
                                                                   text-white px-3 py-1">
                                                        @score pts
                                                    </span>
                                                </div>
                                                <div class="rank-number fw-bold fs-4">
                                                    #@rank
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                    <!-- Rest of the List -->
                    <div class="leaderboard-list p-3">
                        @if (!Model.Items.Any())
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-trophy fa-3x text-muted mb-3"></i>
                                <h5 class="text-muted">Chưa có dữ liệu xếp hạng</h5>
                                <p class="text-muted">Hãy tham gia để xuất hiện ở đây!</p>
                            </div>
                        }
                        else
                        {
                            for (int i = 3; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                var rank = Model.Type == "monthly" ? item.HangThang : item.HangNam;
                                var score = Model.Type == "monthly" ? item.DiemThang : item.DiemNam;

                                <div class="leaderboard-item d-flex align-items-center p-3 mb-2 rounded-3 hover-lift"
                                     data-rank="@rank">
                                    <!-- Rank Badge -->
                                    <div class="rank-badge me-3">
                                        @if (rank <= 3)
                                        {
                                            <span class="rank-number rank-top3">@rank</span>
                                        }
                                        else if (rank <= 10)
                                        {
                                            <span class="rank-number rank-top10">@rank</span>
                                        }
                                        else
                                        {
                                            <span class="rank-number">@rank</span>
                                        }
                                    </div>

                                    <!-- Avatar -->
                                    <div class="avatar-wrapper position-relative me-3">
                                        <img src="@(string.IsNullOrEmpty(item.AnhDaiDien)
                                                    ? Url.Content("~/images/logo-quiz.jpg")
                                                    : item.AnhDaiDien)"
                                             class="rounded-circle border @(item.IsOnline ? "border-success" : "border-secondary")"
                                             style="width: 50px; height: 50px;" />
                                        @if (item.IsOnline)
                                        {
                                            <div class="online-pulse"></div>
                                        }
                                    </div>

                                    <!-- User Info -->
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <h6 class="fw-bold mb-0">@item.TenHienThi</h6>
                                                <div class="d-flex align-items-center mt-1">
                                                    @if (item.IsOnline)
                                                    {
                                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 me-2">
                                                            <i class="fas fa-circle me-1" style="font-size: 0.6rem;"></i>Online
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 me-2">
                                                            <i class="fas fa-circle me-1" style="font-size: 0.6rem;"></i>Offline
                                                        </span>
                                                    }
                                                    <small class="text-muted">
                                                        <i class="fas fa-user me-1"></i>Thành viên
                                                    </small>
                                                </div>
                                            </div>
                                            <div class="score-display">
                                                <div class="points-card bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-3">
                                                    <div class="text-center">
                                                        <div class="fw-bold fs-5">@score</div>
                                                        <small class="text-muted">points</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Progress Bar -->
                                        @if (Model.Items.Any())
                                        {
                                            var maxScore = Model.Items.Max(x => Model.Type == "monthly" ? x.DiemThang : x.DiemNam);
                                            var scorePercentage = maxScore > 0 ? (score * 100) / maxScore : 0;

                                            <div class="progress mt-2" style="height: 4px;">
                                                <div class="progress-bar bg-gradient-points"
                                                     style="width: @scorePercentage%"
                                                     role="progressbar"></div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Current User Stats (if applicable) -->
            @{
                // You can add logic here to highlight current user
                // var currentUser = User.Identity?.Name;
                // if (!string.IsNullOrEmpty(currentUser))
                // {
                //     var userInList = Model.Items.FirstOrDefault(x => x.TenHienThi == currentUser);
                //     if (userInList != null)
                //     {
                //         <div class="card border-primary border-2 mt-4 shadow-sm">
                //             <div class="card-body">
                //                 <div class="d-flex align-items-center">
                //                     <div class="flex-grow-1">
                //                         <h6 class="fw-bold mb-0">
                //                             <i class="fas fa-user-check me-2 text-primary"></i>
                //                             Vị trí của bạn
                //                         </h6>
                //                         <small class="text-muted">Bạn đang ở vị trí #@(Model.Type == "monthly" ? userInList.HangThang : userInList.HangNam)</small>
                //                     </div>
                //                     <div class="badge bg-primary px-3 py-2">
                //                         @(Model.Type == "monthly" ? userInList.DiemThang : userInList.DiemNam) points
                //                     </div>
                //                 </div>
                //             </div>
                //         </div>
                //     }
                // }
            }

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <!-- Previous Button -->
                        @if (Model.CurrentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("Index", "Leaderboard", new { type = Model.Type, page = Model.CurrentPage - 1 })">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                        }

                        <!-- Page Numbers -->
                        @{
                            int startPage = Math.Max(1, Model.CurrentPage - 2);
                            int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);

                            if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", "Leaderboard", new { type = Model.Type, page = 1 })">
                                        1
                                    </a>
                                </li>
                                if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       href="@Url.Action("Index", "Leaderboard", new { type = Model.Type, page = i })">
                                        @i
                                    </a>
                                </li>
                            }

                            if (endPage < Model.TotalPages)
                            {
                                if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link"
                                       href="@Url.Action("Index", "Leaderboard", new { type = Model.Type, page = Model.TotalPages })">
                                        @Model.TotalPages
                                    </a>
                                </li>
                            }
                        }

                        <!-- Next Button -->
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <li class="page-item">
                                <a class="page-link"
                                   href="@Url.Action("Index", "Leaderboard", new { type = Model.Type, page = Model.CurrentPage + 1 })">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- CSS Styles -->
<style>
    /* Global Styles */
    :root {
        --primary-color: #4e54c8;
        --secondary-color: #8f94fb;
        --gold-color: #ffd700;
        --silver-color: #c0c0c0;
        --bronze-color: #cd7f32;
    }

    /* Text Gradient */
    .text-gradient {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* Trophy Icon */
    .trophy-container {
        position: relative;
    }

    .trophy-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, var(--gold-color), #ffa500);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2.5rem;
        box-shadow: 0 10px 25px rgba(255, 215, 0, 0.3);
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    /* Period Selector */
    .period-selector .nav-link {
        border: 2px solid transparent;
        transition: all 0.3s ease;
        background: white;
    }

    .period-selector .nav-link:hover {
        border-color: var(--primary-color);
        transform: translateY(-3px);
    }

    .period-selector .nav-link.active {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: white !important;
        border: none;
        box-shadow: 0 5px 15px rgba(78, 84, 200, 0.3);
    }

    /* Top Three Cards */
    .top-three-card {
        transition: all 0.3s ease;
        border: 2px solid transparent;
        background: white;
    }

    .top-three-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .top-three-card.first {
        border-color: var(--gold-color);
        background: linear-gradient(135deg, #fff9e6 0%, #fff0cc 100%);
    }

    .top-three-card.second {
        border-color: var(--silver-color);
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .top-three-card.third {
        border-color: var(--bronze-color);
        background: linear-gradient(135deg, #f5eee6 0%, #e8d9c9 100%);
    }

    /* Online Indicator */
    .online-indicator {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid white;
    }

    .online-pulse {
        position: absolute;
        bottom: 0;
        right: 0;
        width: 12px;
        height: 12px;
        background-color: #28a745;
        border-radius: 50%;
        border: 2px solid white;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(40, 167, 69, 0); }
        100% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); }
    }

    /* Rank Badge */
    .rank-badge {
        min-width: 50px;
    }

    .rank-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        font-weight: bold;
        font-size: 1.1rem;
        color: #6c757d;
    }

    .rank-top3 {
        background: linear-gradient(135deg, var(--gold-color), #ffa500);
        color: white;
        box-shadow: 0 4px 10px rgba(255, 165, 0, 0.3);
    }

    .rank-top10 {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: white;
        box-shadow: 0 4px 10px rgba(78, 84, 200, 0.3);
    }

    /* Leaderboard Items */
    .leaderboard-item {
        background: white;
        border-left: 4px solid transparent;
        transition: all 0.3s ease;
    }

    .leaderboard-item:hover {
        background: linear-gradient(135deg, #f8f9ff 0%, #f0f2ff 100%);
        border-left-color: var(--primary-color);
        transform: translateX(5px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    .hover-lift:hover {
        transform: translateY(-2px);
    }

    /* Points Progress Bar */
    .bg-gradient-points {
        background: linear-gradient(90deg, #11998e 0%, #38ef7d 100%);
    }

    .progress {
        border-radius: 10px;
        overflow: hidden;
    }

    /* Points Card */
    .points-card {
        transition: all 0.3s ease;
    }

    .leaderboard-item:hover .points-card {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)) !important;
        color: white !important;
        transform: scale(1.05);
    }

    /* Pagination */
    .page-link {
        border: none;
        color: var(--primary-color);
        margin: 0 3px;
        border-radius: 8px !important;
        min-width: 40px;
        text-align: center;
        transition: all 0.3s ease;
    }

    .page-item.active .page-link {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        border: none;
        box-shadow: 0 4px 10px rgba(78, 84, 200, 0.3);
    }

    .page-link:hover {
        background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
        color: white;
        box-shadow: 0 4px 10px rgba(78, 84, 200, 0.3);
    }

    .page-item.disabled .page-link {
        background: #f8f9fa;
        color: #6c757d;
    }

    /* Badge Colors */
    .bg-orange {
        background-color: var(--bronze-color) !important;
    }

    .text-orange {
        color: var(--bronze-color) !important;
    }

    .border-orange {
        border-color: var(--bronze-color) !important;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .trophy-icon {
            width: 60px;
            height: 60px;
            font-size: 2rem;
        }

        .top-three-card {
            margin-bottom: 1rem;
        }

        .period-selector .nav-link {
            margin-bottom: 0.5rem;
        }

        .leaderboard-item {
            padding: 1rem !important;
        }
    }
</style>

<!-- JavaScript -->
@section scripts {
    <script>
        $(document).ready(function() {
            // Add animation to leaderboard items
            $('.leaderboard-item').each(function(index) {
                $(this).css('animation-delay', (index * 0.1) + 's');
            });

            // Update online status animation
            function updateOnlineStatus() {
                $('.online-pulse').each(function() {
                    $(this).css('animation', 'pulse 2s infinite');
                });
            }

            // Smooth scroll for pagination
            $('.page-link').on('click', function(e) {
                if (!$(this).parent().hasClass('disabled')) {
                    e.preventDefault();
                    const url = $(this).attr('href');
                    if (url) {
                        // Add loading animation
                        $('.leaderboard-list').addClass('loading');

                        // Scroll to top
                        $('html, body').animate({
                            scrollTop: $('.trophy-container').offset().top - 100
                        }, 500);

                        // Load new page
                        setTimeout(() => {
                            window.location.href = url;
                        }, 500);
                    }
                }
            });

            // Add hover effect to top three cards
            $('.top-three-card').hover(
                function() {
                    $(this).css('transform', 'translateY(-10px)');
                },
                function() {
                    $(this).css('transform', 'translateY(0)');
                }
            );

            // Highlight current user (example implementation)
            function highlightCurrentUser() {
                // This would require server-side logic to identify current user
                // const currentUsername = "@User.Identity?.Name";
                // if (currentUsername) {
                //     $('.leaderboard-item h6').each(function() {
                //         if ($(this).text().trim() === currentUsername) {
                //             $(this).closest('.leaderboard-item').addClass('current-user');
                //             $(this).append('<span class="badge bg-primary ms-2">Bạn</span>');
                //         }
                //     });
                // }
            }

            // Initialize
            updateOnlineStatus();
            highlightCurrentUser();

            // Refresh online status every 30 seconds
            setInterval(updateOnlineStatus, 30000);
        });
    </script>
}