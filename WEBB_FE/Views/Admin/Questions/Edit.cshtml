@model WEBB.Models.Quiz.CauHoiUpdateDto

@{
    ViewBag.Title = "Sửa câu hỏi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <h1 class="h3 mb-4 text-warning">
        <i class="fas fa-edit me-2"></i>Sửa Câu hỏi #@Model.CauHoiID
    </h1>

    <div class="card shadow">
        <div class="card-body">
            <form method="post" action="@Url.Action("Edit","Questions")">

                <input type="hidden" name="CauHoiID" value="@Model.CauHoiID" />

                <div class="mb-3">
                    <label class="form-label">Nội dung</label>
                    <textarea name="NoiDung" class="form-control" required>@Model.NoiDung</textarea>
                </div>

                <div class="row g-2">
                    <div class="col-md-6">
                        <input class="form-control" name="DapAnA" value="@Model.DapAnA" required />
                    </div>
                    <div class="col-md-6">
                        <input class="form-control" name="DapAnB" value="@Model.DapAnB" required />
                    </div>
                    <div class="col-md-6">
                        <input class="form-control" name="DapAnC" value="@Model.DapAnC" required />
                    </div>
                    <div class="col-md-6">
                        <input class="form-control" name="DapAnD" value="@Model.DapAnD" required />
                    </div>
                </div>

                <div class="mt-3">
                    <label>Đáp án đúng</label>
                    <select name="DapAnDung" class="form-select">
                        @foreach (var a in new[] { "A", "B", "C", "D" })
                        {
                            <option value="@a" @(Model.DapAnDung == a ? "selected" : "")>@a</option>
                        }
                    </select>
                </div>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <label>Chủ đề</label>
                        <select name="ChuDeID" class="form-select">
                            @foreach (var c in (ViewBag.ChuDes as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>())
                            {
                                <option value="@c.ChuDeID" @(Model.ChuDeID == c.ChuDeID ? "selected" : "")>
                                    @c.TenChuDe
                                </option>
                            }

                        </select>
                    </div>

                    <div class="col-md-6">
                        <label>Độ khó</label>
                        <select name="DoKhoID" class="form-select">
                            @foreach (var d in (ViewBag.DoKhos as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>())
                            {
                                <option value="@d.DoKhoID" @(Model.DoKhoID == d.DoKhoID ? "selected" : "")>
                                    @d.TenDoKho
                                </option>
                            }

                        </select>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <a href="@Url.Action("Index","Questions")" class="btn btn-secondary">Hủy</a>
                    <button class="btn btn-warning">
                        <i class="fas fa-save me-1"></i>Cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
