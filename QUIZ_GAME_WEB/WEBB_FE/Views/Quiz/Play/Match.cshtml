
@{
    ViewBag.Title = "Trận Đấu Đối Kháng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var matchCode = ViewBag.MatchCode as string;
    var apiBase = System.Configuration.ConfigurationManager.AppSettings["ApiBaseUrl"];
    if (apiBase != null && apiBase.EndsWith("/")) {
        apiBase = apiBase.Substring(0, apiBase.Length - 1);
    }
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Trận Đấu: <span id="lblMatchCode">@matchCode</span></h4>
            <div>
                <span class="badge bg-light text-dark" id="lblTimer">00:00</span>
            </div>
        </div>
        <div class="card-body">
            <!-- Loading State -->
            <div id="loadingArea" class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2">Đang tải dữ liệu trận đấu...</p>
            </div>

            <!-- Game Area -->
            <div id="gameArea" style="display:none;">
                <div class="row align-items-center mb-3">
                     <div class="col-6">
                         <h5 id="lblQuestionIndex">Câu hỏi 1/10</h5>
                     </div>
                     <div class="col-6 text-end">
                         <span class="badge bg-info">Đối thủ: <span id="lblOpponentStatus">Đang chơi...</span></span>
                     </div>
                </div>

                <div class="p-4 bg-light rounded mb-4 text-center">
                    <h3 id="lblQuestionContent" class="fw-bold">Nội dung câu hỏi sẽ hiển thị ở đây?</h3>
                </div>

                <div class="row g-3" id="answersArea">
                    <!-- Answers will be generated here -->
                </div>
            </div>

            <!-- Result Area -->
            <div id="resultArea" style="display:none;" class="text-center py-5">
                <h2 class="text-success fw-bold">Trận Đấu Kết Thúc!</h2>
                <div class="my-4">
                    <h4 id="lblMyScore" class="text-primary">Điểm của bạn: 0</h4>
                    <p id="lblResultMsg" class="lead text-secondary"></p>
                </div>
                <a href="/Quiz/DoiKhang" class="btn btn-outline-primary mt-3">Quay về Sảnh</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const matchCode = '@matchCode';
        const apiBase = '@apiBase';
        const token = '@Session["JWT_TOKEN"]';

        // State
        let matchData = null;
        let currentQIndex = 0;
        let myScore = 0;

        $(document).ready(function() {
            loadMatchData();
        });

        async function loadMatchData() {
            try {
                // GET api/trandau/{code}
                const res = await $.ajax({
                    url: `${apiBase}/api/trandau/${matchCode}`,
                    method: 'GET',
                    headers: { "Authorization": `Bearer ${token}` }
                });

                if (res) {
                    matchData = res;
                    console.log("Match Data:", matchData);
                    
                    // Kiểm tra trạng thái trận
                    if (res.isFinished) { 
                        showResult(res);
                    } else {
                        $('#loadingArea').hide();
                        $('#gameArea').fadeIn();
                        renderQuestion();
                    }
                }
            } catch (err) {
                console.error(err);
                alert("Lỗi tải trận đấu: " + (err.responseText || err.statusText));
            }
        }

        function renderQuestion() {
            if (!matchData || !matchData.questions || currentQIndex >= matchData.questions.length) {
                finishMatch();
                return;
            }

            const q = matchData.questions[currentQIndex];
            
            $('#lblQuestionIndex').text(`Câu hỏi ${currentQIndex + 1}/${matchData.questions.length}`);
            $('#lblQuestionContent').text(q.noiDung); 

            // Parse CacLuaChon from JSON string if needed
            let answers = [];
            try {
                // Backend sends serialized JSON in 'cacLuaChon' or similar
                // Based on OnlineMatchService, it sends:
                // CacLuaChon = JsonSerializer.Serialize({ A=..., B=..., C=..., D=... })
                const opts = JSON.parse(q.cacLuaChon);
                answers = [
                    { id: 'A', text: opts.A },
                    { id: 'B', text: opts.B },
                    { id: 'C', text: opts.C },
                    { id: 'D', text: opts.D }
                ];
            } catch(e) {
                console.error("Error parsing answers", e);
            }

            const answersHtml = answers.map(ans => `
                <div class="col-md-6">
                    <button class="btn btn-outline-dark w-100 p-3 h-100 btn-answer" 
                            onclick="submitAnswer(${q.cauHoiID}, '${ans.id}')">
                        <span class="fw-bold">${ans.id}.</span> ${ans.text}
                    </button>
                </div>
            `).join('');

            $('#answersArea').html(answersHtml);
        }

        async function submitAnswer(qId, ansId) {
            $('.btn-answer').prop('disabled', true);

            try {
                // POST api/trandau/gui-dap-an/{code}
                await $.ajax({
                    url: `${apiBase}/api/trandau/gui-dap-an/${matchCode}`,
                    method: 'POST',
                    contentType: 'application/json',
                    headers: { "Authorization": `Bearer ${token}` },
                    data: JSON.stringify({
                        cauHoiId: qId,
                        dapAnDaChon: ansId // Corrected property name
                    })
                });

                // Next question
                currentQIndex++;
                renderQuestion();

            } catch (err) {
                console.error(err);
                alert("Lỗi gửi đáp án!");
            }
        }

        async function finishMatch() {
             $('#gameArea').hide();
             $('#loadingArea').show().find('p').text("Đang tổng kết kết quả...");

             try {
                // POST api/trandau/ket-thuc/{code}
                const res = await $.ajax({
                    url: `${apiBase}/api/trandau/ket-thuc/${matchCode}`,
                    method: 'POST',
                    headers: { "Authorization": `Bearer ${token}` }
                });
                
                showResult(res);

             } catch (err) {
                 alert("Lỗi kết thúc trận.");
             }
        }

        function showResult(data) {
             $('#loadingArea').hide();
             $('#gameArea').hide();
             $('#resultArea').fadeIn();

             // data structure from MatchResultModel:
             // { matchCode, ketQua, winnerHoTen, diemPlayer1, diemPlayer2 }
             
             $('#lblMyScore').text(`Điểm Player 1: ${data.diemPlayer1} - Player 2: ${data.diemPlayer2}`);
             $('#lblResultMsg').text(`Kết quả: ${data.ketQua} (Thắng: ${data.winnerHoTen})`);
        }
    </script>
}
